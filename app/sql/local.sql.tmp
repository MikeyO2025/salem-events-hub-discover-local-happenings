    }\\r\\n        \\r\\n        .calendar-frame {\\r\\n            height: 500px;\\r\\n        }\\r\\n    }\\r\\n\\r\\n    @media (max-width: 480px) {\\r\\n        .calendar-frame {\\r\\n            height: 450px;\\r\\n        }\\r\\n    }\\r\\n<\\/style>\\r\\n\\r\\n<!-- Calendar Embed -->\\r\\n<div class=\\\"calendar-container\\\">\\r\\n    <div class=\\\"calendar-title\\\">\\ud83d\\udcc5 Upcoming Events<\\/div>\\r\\n    <iframe class=\\\"calendar-frame\\\" src=\\\"https:\\/\\/calendar.google.com\\/calendar\\/embed?src=024644856d6ce196b325d729d1a86f3b46e47080de04e38ddc0fe5ecb018f050%40group.calendar.google.com&ctz=America%2FNew_York\\\" frameborder=\\\"0\\\" scrolling=\\\"no\\\"><\\/iframe>\\r\\n<\\/div>\\r\\n\",\"_background_background\":\"gradient\",\"_background_color\":\"#FFFFFF\"},\"elements\":[],\"widgetType\":\"html\"}],\"isInner\":false},{\"id\":\"f3ca4dc\",\"elType\":\"container\",\"settings\":{\"background_background\":\"gradient\",\"background_color\":\"#DA8197\",\"background_color_b\":\"#FFFFFF\"},\"elements\":[{\"id\":\"d70d89c\",\"elType\":\"widget\",\"settings\":{\"address\":\" Where O\'Keefe Complex, O\'Keefe Campus 225 Canal Street, Salem, MA 01970 Multipurpose Gym\",\"height\":{\"unit\":\"px\",\"size\":334,\"sizes\":[]}},\"elements\":[],\"widgetType\":\"google_maps\"}],\"isInner\":false},{\"id\":\"3639a21\",\"elType\":\"container\",\"settings\":{\"boxed_width\":{\"unit\":\"px\",\"size\":861,\"sizes\":[]},\"flex_gap\":{\"size\":30,\"unit\":\"px\",\"column\":\"30\",\"row\":\"30\",\"isLinked\":true},\"min_height\":{\"unit\":\"px\",\"size\":760,\"sizes\":[]},\"min_height_tablet\":{\"unit\":\"px\",\"size\":421,\"sizes\":[]},\"min_height_mobile\":{\"unit\":\"px\",\"size\":327,\"sizes\":[]},\"background_background\":\"video\",\"background_image\":{\"id\":369,\"url\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/wp-content\\/uploads\\/2025\\/02\\/boxking_cta_bg_.jpg\"},\"background_position\":\"center center\",\"background_attachment\":