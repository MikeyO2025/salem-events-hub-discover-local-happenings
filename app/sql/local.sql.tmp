\\r\\n    .calendar-title {\\r\\n        font-size: 22px;\\r\\n        font-weight: bold;\\r\\n        color: #333;\\r\\n        text-align: center;\\r\\n        margin-bottom: 10px;\\r\\n    }\\r\\n\\r\\n    \\/* Calendar iframe styling *\\/\\r\\n    .calendar-frame {\\r\\n        width: 100%;\\r\\n        height: 600px;\\r\\n        border: none;\\r\\n        border-radius: 10px;\\r\\n        overflow: hidden;\\r\\n    }\\r\\n\\r\\n    \\/* Prevent layout shift or extra spacing issues *\\/\\r\\n    .wp-block-group, .wp-block-column {\\r\\n        overflow: hidden;\\r\\n    }\\r\\n\\r\\n    \\/* Responsive Fixes *\\/\\r\\n    @media (max-width: 768px) {\\r\\n        .calendar-container {\\r\\n            padding: 10px;\\r\\n        }\\r\\n        \\r\\n        .calendar-frame {\\r\\n            height: 500px;\\r\\n        }\\r\\n    }\\r\\n\\r\\n    @media (max-width: 480px) {\\r\\n        .calendar-frame {\\r\\n            height: 450px;\\r\\n        }\\r\\n    }\\r\\n<\\/style>\\r\\n\\r\\n<!-- Calendar Embed -->\\r\\n<div class=\\\"calendar-container\\\">\\r\\n    <div class=\\\"calendar-title\\\">\\ud83d\\udcc5 Upcoming Events<\\/div>\\r\\n    <iframe class=\\\"calendar-frame\\\" src=\\\"https:\\/\\/calendar.google.com\\/calendar\\/embed?src=024644856d6ce196b325d729d1a86f3b46e47080de04e38ddc0fe5ecb018f050%40group.calendar.google.com&ctz=America%2FNew_York\\\" frameborder=\\\"0\\\" scrolling=\\\"no\\\"><\\/iframe>\\r\\n<\\/div>\\r\\n\",\"_background_background\":\"gradient\",\"_background_color\":\"#FFFFFF\"},\"elements\":[],\"widgetType\":\"html\"}],\"isInner\":false},{\"id\":\"78279f5e\",\"elType\":\"container\",\"settings\":{\"flex_gap\":{\"size\":20,\"unit\":\"px\",\"column\":\"20\",\"row\":\"20\",\"isLinked\":true},\"content_position\":\"middle\",\"margin\":{\"unit\":\"%\",\"top\":\"12\",\"right\":\"0\",\"bottom\":\"0\",\"left\":\"0\",\"isLinked\":\"\"},\"padding\":{\"unit\":\"%\",\"top\":\"0\",\"right\":\"3\",\"bottom\":\"0\",\"left\":\"3\",\"isLinked\":\"\