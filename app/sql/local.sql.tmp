\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"post_title\":\"March Retirement Webinars\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"march-retirement-webinars-26\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:42:46\",\"post_modified_gmt\":\"2025-04-15 06:42:46\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1766\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1767,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:41:58\",\"post_date_gmt\":\"2025-04-15 06:41:58\",\"post_content\":\"<p><em>This is a multiday event from Feb 28, 2025 - Mar 27, 2025.<\\/em><\\/p>\\r\\n<p>Both TIAA and the State Board of Retirement are offering a variety of webinars for active employees this month. Take a peak and be sure to register now! <a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">Retirement Seminars - Polaris.<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Joanna Nandi<br \\/><a href=\\\"mailto:jnandi@salemstate.edu\\\">jnandi@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.6030\\\">978.542.6030<\\/a><br \\/><a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"post_title\":\"March Retirement Webinars\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"march-retirement-webinars-27\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:43:06\",\"post_modified_gmt\":\"2025-04-15 06:43:06\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1767\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1768,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:42:04\",\"post_date_gmt\":\"2025-04-15 06:42:04\",\"post_content\":\"<p><em>This is a multiday event from Feb 28, 2025 - Mar 27, 2025.<\\/em><\\/p>\\r\\n<p>Both TIAA and the State Board of Retirement are offering a variety of webinars for active employees this month. Take a peak and be sure to register now! <a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">Retirement Seminars - Polaris.<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Joanna Nandi<br \\/><a href=\\\"mailto:jnandi@salemstate.edu\\\">jnandi@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.6030\\\">978.542.6030<\\/a><br \\/><a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"post_title\":\"March Retirement Webinars\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"march-retirement-webinars-28\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:42:40\",\"post_modified_gmt\":\"2025-04-15 06:42:40\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1768\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"}],\"found_posts\":34,\"max_num_pages\":1}','off');
INSERT INTO `wp_options` VALUES (95654,'_transient_timeout_em_2f52ec88fd5451db8e43fd3308175e0e1744956471','1745097382','off');
INSERT INTO `wp_options` VALUES (95656,'_transient_em_2f52ec88fd5451db8e43fd3308175e0e1744956471','{\"posts\":[{\"ID\":804,\"post_author\":\"1\",\"post_date\":\"2025-03-26 04:18:14\",\"post_date_gmt\":\"2025-03-26 04:18:14\",\"post_content\":\"<p>What do you do when you learn that the version of history passed down in your family might not be entirely true and the foundation that held up the grand deeds of your childhood hero abruptly crumbles? How does one disentangle half-truths and relate them to the historical record? These questions form the framework of Matthias Rudolf\\u2019s book project \\u2014 \\\"based on a true story\\\" \\u2014 whose protagonist sets out to make sense of his dying grandfather\\u2019s cryptic last words: \\u201cDer Kaiser hat uns verraten\\u201d (\\u201cThe Emperor has betrayed us\\u201d). The phrase casts a spell of doubt on the grandfather\\u2019s legacy of WWII heroics as a spy and his escape from the Nazis during the German invasion of the Balkan Peninsula in April 1941. Drawing on his research, Professor Rudolf will discuss the challenges of researching memories, making sense of sources in and across geographically dispersed and linguistically diverse archives, and of (not) getting lost in translation.<\\/p>\\r\\n<p>Matthias Rudolf graduated from the University of Basel, Switzerland and received his Ph.D. from the University of Wisconsin, Madison. He has published on romantic poetry, biopolitics, and postcolonial theory and taught at the Universit\\u00e9 de Fribourg, the University of Nevada, Reno, and the University of Oklahoma. Currently he is a visiting professor in the English Department at Salem State.<\\/p>\\r\\n<p>This event is free and open to the public. It will take place in person and will also be livestreamed on Zoom. Registration is required.<\\/p>\\r\\n<p><a href=\\\"http:\\/\\/lp.constantcontactpages.com\\/ev\\/reg\\/7s6zk6w\\\">Register to attend this talk in person.<\\/a><\\/p>\\r\\n<p><a href=\\\"http:\\/\\/salemstate.zoom.us\\/meeting\\/register\\/ygCZnonFQ7Sc5vn2U2wsmQ\\\">Register to view this talk on zoom.<\\/a><\\/p>\\r\\n<p>This event is cosponsored by the Center for Research and Creative Activities, the English department, and the Public History Speakers Series.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Lynn T Blayer<br \\/><a href=\\\"mailto:ctr_lblayer@salemstate.edu\\\">ctr_lblayer@salemstate.edu<\\/a><br \\/><a href=\\\"tel:781.576.9184\\\">781.576.9184<\\/a><br \\/><a href=\\\"https:\\/\\/lp.constantcontactpages.com\\/ev\\/reg\\/7s6zk6w\\\">Get tickets<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"On Researching Fictions\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"on-researching-fictions\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:50:24\",\"post_modified_gmt\":\"2025-04-07 02:50:24\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/on-researching-fictions\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":806,\"post_author\":\"1\",\"post_date\":\"2025-03-26 05:07:43\",\"post_date_gmt\":\"2025-03-26 05:07:43\",\"post_content\":\"<p>Incoming first-year (freshmen) are invited to join First Year Experience for a session to learn about the first year seminar (fall semester course) at Salem State and the process for selecting one. Students choose their seminar after reviewing the various topics. Seats are limited in each seminar so selecting early is important. Seminar selection opens on Monday March 3.<\\/p>\\r\\n<p>Registration for each session closes 48 hours before the session (or on Friday if the session occurs on a Monday).<\\/p>\\r\\n<p><strong>Tuesday April 1, 5pm<\\/strong> <a href=\\\"https:\\/\\/salemstate.zoom.us\\/meeting\\/register\\/_1bquIDXR56ufxTzawgDTAhttps:\\/\\/salemstate.zoom.us\\/meeting\\/register\\/_1bquIDXR56ufxTzawgDTA\\\">REGISTER<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Mathew Chetnik<br \\/><a href=\\\"mailto:firstyearseminar@salemstate.edu\\\">firstyearseminar@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"First Year Seminar Info Session (incoming students)\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"first-year-seminar-info-session-incoming-students\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:50:16\",\"post_modified_gmt\":\"2025-04-07 02:50:16\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/first-year-seminar-info-session-incoming-students\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1519,\"post_author\":\"1\",\"post_date\":\"2025-04-14 23:43:36\",\"post_date_gmt\":\"2025-04-14 23:43:36\",\"post_content\":\"<p><em>This is a multiday event from Mar 31, 2025 - Apr 18, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>The \\\"Trash to Art\\\" initiative, a Collaborative Online International Learning (COIL) project between Salem State University in the United States and Tecnol\\u00f3gico de Monterrey in Mexico, exemplifies the transformative power of global shared learning. Guided by Professors Tereza Swanda and Francisco Gonz\\u00e1lez Romo de Vivar, this project engages students from diverse cultural backgrounds in repurposing discarded materials into meaningful artworks, promoting a profound understanding of environmental sustainability and cross-cultural collaboration. By aligning with the United Nations Sustainable Development Goals #12 (Sustainable Consumption and Production) and #13 (Climate Action), \\\"Trash to Art\\\" challenges participants to critically examine their consumption patterns and the environmental impact of human activities.<\\/p>\\r\\n<h1>Additional Exhibition Events on Thursday, April 10<\\/h1>\\r\\n<p>Artist Talk-12:30-1:30 pm<\\/p>\\r\\n<p>Reception-1:30-3 pm<\\/p>\\r\\n<p>The Winfisky Gallery is open from 10 am-4 pm, Monday through Friday.<\\/p>\\r\\n<h1>Bios<\\/h1>\\r\\n<p><strong>Dr. Francisco Gonz\\u00e1lez Romo de Vivar<\\/strong> is an Assistant Professor at Tecnol\\u00f3gico de Monterrey, Campus Hidalgo, specializing in Art History, Visual Culture, and Semiotics. He holds a PhD in Art History from Centro de Cultura Casa Lamm, where his dissertation focused on cinematic themes using Gilles Deleuze\\u2019s filmic philosophy. His research interests include transdisciplinary practices in cinema, minor cinemas, and the aesthetic implications of technological advancements.<\\/p>\\r\\n<p>In his academic work, Dr. Gonz\\u00e1lez integrates these themes into his teaching, focusing on fostering global collaboration through technology-driven educational projects, including Collaborative Online International Learning (COIL). His courses cover topics such as Film Analysis, Posthumanism, and Audiovisual Narrative, encouraging students to engage critically with both historical and contemporary media.<\\/p>\\r\\n<p>Dr. Gonz\\u00e1lez is committed to creating learning environments that enhance student engagement and develop critical thinking. His current research explores intersections of cinema, media studies, and technology, continuously seeking new ways to enrich the educational experience in a global context.<\\/p>\\r\\n<p><strong>Tereza Swanda\\u2019s<\\/strong> interdisciplinary work centers on integrating with the \\u2018other,\\u2019 a term she uses to refer to diverse cultures, perspectives, and experiences. She resides in CZ and the States, teaching Studio Art and Art History at Salem State University and Roxbury Community College. Swanda holds an MFA from Vermont College of Fine Arts and a BFA in Painting and Sculpture from Massachusetts College of Art and Design.<\\/p>\\r\\n<p>She is currently working on a collaborative online international learning project, Trash2Art, which connects US students across the border to learners in Mexico. During the pandemic, her community engagement project, Touchstone, was included in The Immigrant Artist Biennial\\/ Mother Tongue. The artist asked those affected by COVID-19 to email her photos of loved ones, which she painted on stone. Her curatorial project, Unredacted, brought ten artists together who acknowledged the political post-truth world as artists and activists. Swanda received the A.R.T. Fund award to pursue her project, Capital Cleanse, in a rogue installation at the Metropolitan Museum of Art. She has exhibited her work at the Whitney Center for the Arts (Pittsfield, MA), University of Oregon (Eugene, OR), Berliner Kunstprojekt (Berlin), 450 Broadway Gallery (NY), Bakalar and Paine Galleries (Boston, MA), Chemeketa Community College Art Gallery (Salem, OR), Center on Contemporary Art (Seattle, WA) online in Storyscape Journal and Waves joining over 20,000 women who have contributed over the years. She has been awarded residencies at VSC (Johnson, VT) and the Millay Colony (Austerlitz, NY). She has been attending workshops with Rose Shakinovsky and Claire Gavronsky in Italy and South Africa since 2000.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Trash Transformed: A Binational Perspective on Art and Sustainability\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"trash-transformed-a-binational-perspective-on-art-and-sustainability-2\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:51:36\",\"post_modified_gmt\":\"2025-04-15 05:51:36\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1519\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1517,\"post_author\":\"1\",\"post_date\":\"2025-04-15 00:31:57\",\"post_date_gmt\":\"2025-04-15 00:31:57\",\"post_content\":\"<!-- wp:paragraph -->\\r\\n<p>The Salem Rotary Club and the Salem Chamber of Commerce have joined forces again for a Legislative Luncheon Series. The first luncheon event is on April 1 with Mayor Dominick Pangallo. On May 6, State Representative Manny Cruz will share his experiences in the State House. And on June 3, we\\u2019ll hear from State Senator Joan Lovely. Registration is required.<\\/p>\\r\\n<!-- \\/wp:paragraph -->\\r\\n\\r\\n<!-- wp:paragraph -->\\r\\n<p>Register for the series (April 1: Mayor Dominck Pangallo \\/ May 6: State Representative Manny Cruz \\/ June 3: Sen. Joan Lovely. $100 for members \\/ $120 for non-members.<\\/p>\\r\\n<!-- \\/wp:paragraph -->\\r\\n\\r\\n<!-- wp:paragraph -->\\r\\n<p>Register per event: $35 for members \\/ $45 for non-members.<\\/p>\\r\\n<!-- \\/wp:paragraph -->\\r\\n\\r\\n<!-- wp:paragraph -->\\r\\n<p><a href=\\\"https:\\/\\/salem-chamber.chambermaster.com\\/eventregistration\\/register\\/21708\\\">Register now!<\\/a><\\/p>\\r\\n<!-- \\/wp:paragraph -->\",\"post_title\":\"Legislative Luncheon Series 2025 - Mayor Dominick Pangallo\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"legislative-luncheon-series-2025-mayor-dominick-pangallo\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:49:43\",\"post_modified_gmt\":\"2025-04-15 05:49:43\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1517\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1565,\"post_author\":\"1\",\"post_date\":\"2025-04-15 01:28:38\",\"post_date_gmt\":\"2025-04-15 01:28:38\",\"post_content\":\"<p><a href=\\\"http:\\/\\/www.thebabesalem.com\\/events\\\">The Babe<\\/a> proudly presents \'Jazz Night\' every Tuesday from 6-9pm w\\/ live music by Steve Lacey (guitar) &amp; Pat Dole (upright bass). Join us weekly as we showcase jazz artists from Boston and the North Shore. Instrumentalists are encouraged to come by and sit in. Come by for cocktails, delicious bar snacks and sandwiches made from scratch and a cozy atmosphere to connect with friends and neighbors!<\\/p>\",\"post_title\":\"Live Jazz @ The Babe w\\/ Steve Lacey and Pat Dole\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"live-jazz-the-babe-w-steve-lacey-pat-dole\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:41:26\",\"post_modified_gmt\":\"2025-04-15 05:41:26\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/live-jazz-the-babe-w-steve-lacey-pat-dole\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1728,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:16:16\",\"post_date_gmt\":\"2025-04-15 06:16:16\",\"post_content\":\"<p><em>This is a multiday event from Mar 30, 2025 - Apr 05, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>Are you a student interested in building skills and enhancing strategies related to academic success? Do you need a little bit of guidance and support around a particular academic success topic? Attend a <em><strong>Student Success Series Workshop<\\/strong><\\/em> (via Zoom) happening all this week at a variety of times.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Monday March 31:<\\/strong><\\/p>\\r\\n<p>10:30-11 am: Earning Participation Points in Online Classes<\\/p>\\r\\n<p>3-3:30 pm: Secrets of Successful Students<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Tuesday April 1:<\\/strong><\\/p>\\r\\n<p>11:30 am-12 pm: Online Tools for Success<\\/p>\\r\\n<p>2-2:30 pm: Avoiding Zoom Fatigue<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Wednesday April 2:<\\/strong><\\/p>\\r\\n<p>9:30-10 am: Goal Setting<\\/p>\\r\\n<p>1-1:30 pm: Writing Emails for Success<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Thursday April 3:<\\/strong><\\/p>\\r\\n<p>9-9:30 am: Common Mistakes in Online Classes<\\/p>\\r\\n<p>4-4:30 pm: Apps Which UP Your GPA<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Friday April 4:<\\/strong><\\/p>\\r\\n<p>10:30-11 am: Talking with Professors in Office Hours<\\/p>\\r\\n<p>4-4:30 pm: Conquering Procrastination<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>Can\'t attend a specific session? There are a number of additional academic resources available for students to take advantage of on the main Student Success Canvas page.<\\/p>\\r\\n<p>The full series schedule and Zoom access information are available on the individual Student Success Series section of the <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\\">Student Success Canvas<\\/a> page.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>First Year Experience<br \\/><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Student Success Series Workshops:\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"student-success-series-workshops-15\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:17:00\",\"post_modified_gmt\":\"2025-04-15 06:17:00\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1728\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":809,\"post_author\":\"1\",\"post_date\":\"2025-03-26 05:14:45\",\"post_date_gmt\":\"2025-03-26 05:14:45\",\"post_content\":\"<strong>Open Dialogue Hour for Faculty and Staff<\\/strong>\\n\\nIn order to support open and direct dialogue between campus leadership, faculty and staff, our VP of Diversity and Inclusion, Christopher Macdonald-Dennis, is hosting weekly \\u201cHolding Space\\u201d sessions across campus.\\n\\nThese low-stakes, hour-long drop-in sessions are open to all faculty and staff who wish to stop by and engage in conversation with VP Macdonald-Dennis and other members of the President\\u2019s Executive Council (PEC) and campus leadership. To encourage meaningful connection, each session is scheduled in one of campus\\u2019s smaller conference rooms and open to in-person attendance only<span style=\\\"font-size: revert; color: initial;\\\">.<\\/span>\\n\\nAdditional Holding Space opportunities this semester:\\n\\n<strong>Tuesday, April 8 | 10:30-11:30 am<\\/strong>\\n\\nMarsh Hall 204\\n\\n<strong>Friday, April 18 | 11 am-12 pm<\\/strong>\\n\\nHarrington Building 104\\n\\n<strong>Thursday, April 24 | 3:30-4:30 pm<\\/strong>\\n\\nMeier Hall 316B - Charlotte Forten Legacy Room\\n\\n<strong>Contact<\\/strong>\\nJess Cook\\n<a href=\\\"mailto:jcook2@salemstate.edu\\\">jcook2@salemstate.edu<\\/a>\\n<a href=\\\"tel:978.542.4954\\\">978.542.4954<\\/a>\\nFor access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.\",\"post_title\":\"Holding Space April 2 2025\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"holding-space-april-2-2025\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-04 04:21:28\",\"post_modified_gmt\":\"2025-04-04 04:21:28\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=809\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":810,\"post_author\":\"1\",\"post_date\":\"2025-03-26 05:18:52\",\"post_date_gmt\":\"2025-03-26 05:18:52\",\"post_content\":\"<p><strong>A Panel Discussion on Building and Managing Generational Wealth<\\/strong><\\/p>\\r\\n<p>Join us for an insightful panel discussion featuring Raminder Luther, Dean of the Bertolon School of Business, Investment Advisor Santo Dimino \\u201918, and Founder and President at Nationwide REO Brokers, Inc., Nick Petrocelli \\u201921. The panel will be moderated by Don White, Assistant Dean of Student Success of the Bertolon School of Business, on building and managing generational wealth. Refreshments will be provided!<\\/p>\\r\\n<p>This event is sponsored by The Brotherhood, HSI-MSI Initiatives, and The Bertolon School of Business.<\\/p>\\r\\n<p>All students are welcome and encouraged to attend.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Carlie Pierre<br \\/><a href=\\\"mailto:cpierre@salemstate.edu\\\">cpierre@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4852\\\">978.542.4852<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Generational Wealth Workshop\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"generational-wealth-workshop\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:50:09\",\"post_modified_gmt\":\"2025-04-07 02:50:09\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/generational-wealth-workshop\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":812,\"post_author\":\"1\",\"post_date\":\"2025-03-26 23:51:41\",\"post_date_gmt\":\"2025-03-26 23:51:41\",\"post_content\":\"<p><strong>Jane McManus: The Fast Track: Inside the Surging Business of Women\'s Sports<\\/strong><\\/p>\\r\\n<p>Jane McManus is a New York Times writer who has written a book on the explosion of women\'s sports. Women\'s sports is an expanding industry. We are seeing an expansion in the number of teams and a large increase in terms of support at the university level.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Annmarie T Bedard<br \\/><a href=\\\"mailto:abedard@salemstate.edu\\\">abedard@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.880.8619\\\">978.880.8619<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"SMS Department Speaker Series\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"sms-department-speaker-series\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:50:02\",\"post_modified_gmt\":\"2025-04-07 02:50:02\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/sms-department-speaker-series\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":814,\"post_author\":\"1\",\"post_date\":\"2025-03-26 23:58:21\",\"post_date_gmt\":\"2025-03-26 23:58:21\",\"post_content\":\"<p>As a young boy, Werner Salinger witnessed the violence of Kristallnacht in Berlin, Germany. His family escaped to America, but as a young man in the 1950s, he enlisted in the US Air Force and returned to Germany working in intelligence. It was there that he met his wife Martha, the daughter of a German soldier.<\\/p>\\r\\n<p>Join us as he reflects on how they made their lives together and their long process of familial reconciliation in the shadow of history.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>This event is free and open to the public.<\\/p>\\r\\n<p>Cosponsored by the Jewish Employee Resource Group (JERG), Hillel and by the president\\u2019s office.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Peter Urkowitz<br \\/><a href=\\\"mailto:purkowitz@salemstate.edu\\\">purkowitz@salemstate.edu<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"A Talk with Holocaust Survivor Werner Salinger\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"a-talk-with-holocaust-survivor-werner-salinger\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:49:40\",\"post_modified_gmt\":\"2025-04-07 02:49:40\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/a-talk-with-holocaust-survivor-werner-salinger\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1520,\"post_author\":\"1\",\"post_date\":\"2025-04-14 23:44:06\",\"post_date_gmt\":\"2025-04-14 23:44:06\",\"post_content\":\"<p><em>This is a multiday event from Mar 31, 2025 - Apr 18, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>The \\\"Trash to Art\\\" initiative, a Collaborative Online International Learning (COIL) project between Salem State University in the United States and Tecnol\\u00f3gico de Monterrey in Mexico, exemplifies the transformative power of global shared learning. Guided by Professors Tereza Swanda and Francisco Gonz\\u00e1lez Romo de Vivar, this project engages students from diverse cultural backgrounds in repurposing discarded materials into meaningful artworks, promoting a profound understanding of environmental sustainability and cross-cultural collaboration. By aligning with the United Nations Sustainable Development Goals #12 (Sustainable Consumption and Production) and #13 (Climate Action), \\\"Trash to Art\\\" challenges participants to critically examine their consumption patterns and the environmental impact of human activities.<\\/p>\\r\\n<h1>Additional Exhibition Events on Thursday, April 10<\\/h1>\\r\\n<p>Artist Talk-12:30-1:30 pm<\\/p>\\r\\n<p>Reception-1:30-3 pm<\\/p>\\r\\n<p>The Winfisky Gallery is open from 10 am-4 pm, Monday through Friday.<\\/p>\\r\\n<h1>Bios<\\/h1>\\r\\n<p><strong>Dr. Francisco Gonz\\u00e1lez Romo de Vivar<\\/strong> is an Assistant Professor at Tecnol\\u00f3gico de Monterrey, Campus Hidalgo, specializing in Art History, Visual Culture, and Semiotics. He holds a PhD in Art History from Centro de Cultura Casa Lamm, where his dissertation focused on cinematic themes using Gilles Deleuze\\u2019s filmic philosophy. His research interests include transdisciplinary practices in cinema, minor cinemas, and the aesthetic implications of technological advancements.<\\/p>\\r\\n<p>In his academic work, Dr. Gonz\\u00e1lez integrates these themes into his teaching, focusing on fostering global collaboration through technology-driven educational projects, including Collaborative Online International Learning (COIL). His courses cover topics such as Film Analysis, Posthumanism, and Audiovisual Narrative, encouraging students to engage critically with both historical and contemporary media.<\\/p>\\r\\n<p>Dr. Gonz\\u00e1lez is committed to creating learning environments that enhance student engagement and develop critical thinking. His current research explores intersections of cinema, media studies, and technology, continuously seeking new ways to enrich the educational experience in a global context.<\\/p>\\r\\n<p><strong>Tereza Swanda\\u2019s<\\/strong> interdisciplinary work centers on integrating with the \\u2018other,\\u2019 a term she uses to refer to diverse cultures, perspectives, and experiences. She resides in CZ and the States, teaching Studio Art and Art History at Salem State University and Roxbury Community College. Swanda holds an MFA from Vermont College of Fine Arts and a BFA in Painting and Sculpture from Massachusetts College of Art and Design.<\\/p>\\r\\n<p>She is currently working on a collaborative online international learning project, Trash2Art, which connects US students across the border to learners in Mexico. During the pandemic, her community engagement project, Touchstone, was included in The Immigrant Artist Biennial\\/ Mother Tongue. The artist asked those affected by COVID-19 to email her photos of loved ones, which she painted on stone. Her curatorial project, Unredacted, brought ten artists together who acknowledged the political post-truth world as artists and activists. Swanda received the A.R.T. Fund award to pursue her project, Capital Cleanse, in a rogue installation at the Metropolitan Museum of Art. She has exhibited her work at the Whitney Center for the Arts (Pittsfield, MA), University of Oregon (Eugene, OR), Berliner Kunstprojekt (Berlin), 450 Broadway Gallery (NY), Bakalar and Paine Galleries (Boston, MA), Chemeketa Community College Art Gallery (Salem, OR), Center on Contemporary Art (Seattle, WA) online in Storyscape Journal and Waves joining over 20,000 women who have contributed over the years. She has been awarded residencies at VSC (Johnson, VT) and the Millay Colony (Austerlitz, NY). She has been attending workshops with Rose Shakinovsky and Claire Gavronsky in Italy and South Africa since 2000.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Trash Transformed: A Binational Perspective on Art and Sustainability\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"trash-transformed-a-binational-perspective-on-art-and-sustainability-3\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:51:28\",\"post_modified_gmt\":\"2025-04-15 05:51:28\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1520\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1729,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:16:24\",\"post_date_gmt\":\"2025-04-15 06:16:24\",\"post_content\":\"<p><em>This is a multiday event from Mar 30, 2025 - Apr 05, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>Are you a student interested in building skills and enhancing strategies related to academic success? Do you need a little bit of guidance and support around a particular academic success topic? Attend a <em><strong>Student Success Series Workshop<\\/strong><\\/em> (via Zoom) happening all this week at a variety of times.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Monday March 31:<\\/strong><\\/p>\\r\\n<p>10:30-11 am: Earning Participation Points in Online Classes<\\/p>\\r\\n<p>3-3:30 pm: Secrets of Successful Students<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Tuesday April 1:<\\/strong><\\/p>\\r\\n<p>11:30 am-12 pm: Online Tools for Success<\\/p>\\r\\n<p>2-2:30 pm: Avoiding Zoom Fatigue<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Wednesday April 2:<\\/strong><\\/p>\\r\\n<p>9:30-10 am: Goal Setting<\\/p>\\r\\n<p>1-1:30 pm: Writing Emails for Success<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Thursday April 3:<\\/strong><\\/p>\\r\\n<p>9-9:30 am: Common Mistakes in Online Classes<\\/p>\\r\\n<p>4-4:30 pm: Apps Which UP Your GPA<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Friday April 4:<\\/strong><\\/p>\\r\\n<p>10:30-11 am: Talking with Professors in Office Hours<\\/p>\\r\\n<p>4-4:30 pm: Conquering Procrastination<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>Can\'t attend a specific session? There are a number of additional academic resources available for students to take advantage of on the main Student Success Canvas page.<\\/p>\\r\\n<p>The full series schedule and Zoom access information are available on the individual Student Success Series section of the <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\\">Student Success Canvas<\\/a> page.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>First Year Experience<br \\/><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Student Success Series Workshops:\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"student-success-series-workshops-16\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:17:01\",\"post_modified_gmt\":\"2025-04-15 06:17:01\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1729\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":816,\"post_author\":\"1\",\"post_date\":\"2025-03-27 00:05:16\",\"post_date_gmt\":\"2025-03-27 00:05:16\",\"post_content\":\"<p>Eight teams from business, social work, fire science, healthcare studies, psychology, English, and communication majors presenting on the stage for $5,000 grand prize.<\\/p>\\r\\n<p>See Salem State students shining with their innovative business ideas, and get free food!<\\/p>\\r\\n<p>This free event takes place in the recital hall of academic building on Central Campus at 5-7 pm on Thursday, April 3.<\\/p>\\r\\n<p>The seats in the recital hall are limited, so <a href=\\\"https:\\/\\/www.eventbrite.com\\/e\\/5th-annual-viking-business-pitch-competition-tickets-1274231463609?aff=oddtdtcreator\\\"><strong>please register here to reserve a seat<\\/strong><\\/a>.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/><a href=\\\"https:\\/\\/www.salemstate.edu\\/businesspitch\\\">More about the Viking Business Pitch<\\/a><br \\/><a href=\\\"https:\\/\\/www.eventbrite.com\\/e\\/5th-annual-viking-business-pitch-competition-tickets-1274231463609?aff=oddtdtcreator\\\">Register to attend the final presentations<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Viking Business Pitch Final Presentations\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"viking-business-pitch-final-presentations\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:49:21\",\"post_modified_gmt\":\"2025-04-07 02:49:21\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/viking-business-pitch-final-presentations\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1521,\"post_author\":\"1\",\"post_date\":\"2025-04-14 23:44:37\",\"post_date_gmt\":\"2025-04-14 23:44:37\",\"post_content\":\"<p><em>This is a multiday event from Mar 31, 2025 - Apr 18, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>The \\\"Trash to Art\\\" initiative, a Collaborative Online International Learning (COIL) project between Salem State University in the United States and Tecnol\\u00f3gico de Monterrey in Mexico, exemplifies the transformative power of global shared learning. Guided by Professors Tereza Swanda and Francisco Gonz\\u00e1lez Romo de Vivar, this project engages students from diverse cultural backgrounds in repurposing discarded materials into meaningful artworks, promoting a profound understanding of environmental sustainability and cross-cultural collaboration. By aligning with the United Nations Sustainable Development Goals #12 (Sustainable Consumption and Production) and #13 (Climate Action), \\\"Trash to Art\\\" challenges participants to critically examine their consumption patterns and the environmental impact of human activities.<\\/p>\\r\\n<h1>Additional Exhibition Events on Thursday, April 10<\\/h1>\\r\\n<p>Artist Talk-12:30-1:30 pm<\\/p>\\r\\n<p>Reception-1:30-3 pm<\\/p>\\r\\n<p>The Winfisky Gallery is open from 10 am-4 pm, Monday through Friday.<\\/p>\\r\\n<h1>Bios<\\/h1>\\r\\n<p><strong>Dr. Francisco Gonz\\u00e1lez Romo de Vivar<\\/strong> is an Assistant Professor at Tecnol\\u00f3gico de Monterrey, Campus Hidalgo, specializing in Art History, Visual Culture, and Semiotics. He holds a PhD in Art History from Centro de Cultura Casa Lamm, where his dissertation focused on cinematic themes using Gilles Deleuze\\u2019s filmic philosophy. His research interests include transdisciplinary practices in cinema, minor cinemas, and the aesthetic implications of technological advancements.<\\/p>\\r\\n<p>In his academic work, Dr. Gonz\\u00e1lez integrates these themes into his teaching, focusing on fostering global collaboration through technology-driven educational projects, including Collaborative Online International Learning (COIL). His courses cover topics such as Film Analysis, Posthumanism, and Audiovisual Narrative, encouraging students to engage critically with both historical and contemporary media.<\\/p>\\r\\n<p>Dr. Gonz\\u00e1lez is committed to creating learning environments that enhance student engagement and develop critical thinking. His current research explores intersections of cinema, media studies, and technology, continuously seeking new ways to enrich the educational experience in a global context.<\\/p>\\r\\n<p><strong>Tereza Swanda\\u2019s<\\/strong> interdisciplinary work centers on integrating with the \\u2018other,\\u2019 a term she uses to refer to diverse cultures, perspectives, and experiences. She resides in CZ and the States, teaching Studio Art and Art History at Salem State University and Roxbury Community College. Swanda holds an MFA from Vermont College of Fine Arts and a BFA in Painting and Sculpture from Massachusetts College of Art and Design.<\\/p>\\r\\n<p>She is currently working on a collaborative online international learning project, Trash2Art, which connects US students across the border to learners in Mexico. During the pandemic, her community engagement project, Touchstone, was included in The Immigrant Artist Biennial\\/ Mother Tongue. The artist asked those affected by COVID-19 to email her photos of loved ones, which she painted on stone. Her curatorial project, Unredacted, brought ten artists together who acknowledged the political post-truth world as artists and activists. Swanda received the A.R.T. Fund award to pursue her project, Capital Cleanse, in a rogue installation at the Metropolitan Museum of Art. She has exhibited her work at the Whitney Center for the Arts (Pittsfield, MA), University of Oregon (Eugene, OR), Berliner Kunstprojekt (Berlin), 450 Broadway Gallery (NY), Bakalar and Paine Galleries (Boston, MA), Chemeketa Community College Art Gallery (Salem, OR), Center on Contemporary Art (Seattle, WA) online in Storyscape Journal and Waves joining over 20,000 women who have contributed over the years. She has been awarded residencies at VSC (Johnson, VT) and the Millay Colony (Austerlitz, NY). She has been attending workshops with Rose Shakinovsky and Claire Gavronsky in Italy and South Africa since 2000.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Trash Transformed: A Binational Perspective on Art and Sustainability\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"trash-transformed-a-binational-perspective-on-art-and-sustainability-4\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:51:22\",\"post_modified_gmt\":\"2025-04-15 05:51:22\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1521\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1730,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:16:31\",\"post_date_gmt\":\"2025-04-15 06:16:31\",\"post_content\":\"<p><em>This is a multiday event from Mar 30, 2025 - Apr 05, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>Are you a student interested in building skills and enhancing strategies related to academic success? Do you need a little bit of guidance and support around a particular academic success topic? Attend a <em><strong>Student Success Series Workshop<\\/strong><\\/em> (via Zoom) happening all this week at a variety of times.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Monday March 31:<\\/strong><\\/p>\\r\\n<p>10:30-11 am: Earning Participation Points in Online Classes<\\/p>\\r\\n<p>3-3:30 pm: Secrets of Successful Students<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Tuesday April 1:<\\/strong><\\/p>\\r\\n<p>11:30 am-12 pm: Online Tools for Success<\\/p>\\r\\n<p>2-2:30 pm: Avoiding Zoom Fatigue<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Wednesday April 2:<\\/strong><\\/p>\\r\\n<p>9:30-10 am: Goal Setting<\\/p>\\r\\n<p>1-1:30 pm: Writing Emails for Success<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Thursday April 3:<\\/strong><\\/p>\\r\\n<p>9-9:30 am: Common Mistakes in Online Classes<\\/p>\\r\\n<p>4-4:30 pm: Apps Which UP Your GPA<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Friday April 4:<\\/strong><\\/p>\\r\\n<p>10:30-11 am: Talking with Professors in Office Hours<\\/p>\\r\\n<p>4-4:30 pm: Conquering Procrastination<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>Can\'t attend a specific session? There are a number of additional academic resources available for students to take advantage of on the main Student Success Canvas page.<\\/p>\\r\\n<p>The full series schedule and Zoom access information are available on the individual Student Success Series section of the <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\\">Student Success Canvas<\\/a> page.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>First Year Experience<br \\/><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Student Success Series Workshops:\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"student-success-series-workshops-17\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:17:03\",\"post_modified_gmt\":\"2025-04-15 06:17:03\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1730\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":818,\"post_author\":\"1\",\"post_date\":\"2025-03-27 00:14:24\",\"post_date_gmt\":\"2025-03-27 00:14:24\",\"post_content\":\"<p>Join us for the Haitian Cultural Club\'s Bake Sale! From March 26-28, you can pre-order delicious baked goods that celebrate Haitian culture. Be sure to stop by our tabling locations to place your order:<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<ul>\\r\\n<li><strong>Wednesday, March 26:<\\/strong> 12-2 pm | Dunkin\' Lobby, 3-5 pm | North Dining<\\/li>\\r\\n<li><strong>Thursday, March 27:<\\/strong> 11 am-1 pm | Dunkin\' Lobby, 2-3 pm | North Dining<\\/li>\\r\\n<li><strong>Friday, March 28:<\\/strong> 3-5 pm | Marsh Dining Lobby<\\/li>\\r\\n<\\/ul>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>Pre-sale items will be available for <strong>pickup on Friday, April 4 from 11 am-5 pm in Alumni Plaza (rain location: ECC Lobby).<\\/strong> Stay updated through our Instagram page @hcc_ssu. Don\'t miss out on these tasty treats!<\\/p>\",\"post_title\":\"Bake Sale\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"bake-sale\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 23:19:02\",\"post_modified_gmt\":\"2025-03-27 23:19:02\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/bake-sale\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1522,\"post_author\":\"1\",\"post_date\":\"2025-04-14 23:44:58\",\"post_date_gmt\":\"2025-04-14 23:44:58\",\"post_content\":\"<p><em>This is a multiday event from Mar 31, 2025 - Apr 18, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>The \\\"Trash to Art\\\" initiative, a Collaborative Online International Learning (COIL) project between Salem State University in the United States and Tecnol\\u00f3gico de Monterrey in Mexico, exemplifies the transformative power of global shared learning. Guided by Professors Tereza Swanda and Francisco Gonz\\u00e1lez Romo de Vivar, this project engages students from diverse cultural backgrounds in repurposing discarded materials into meaningful artworks, promoting a profound understanding of environmental sustainability and cross-cultural collaboration. By aligning with the United Nations Sustainable Development Goals #12 (Sustainable Consumption and Production) and #13 (Climate Action), \\\"Trash to Art\\\" challenges participants to critically examine their consumption patterns and the environmental impact of human activities.<\\/p>\\r\\n<h1>Additional Exhibition Events on Thursday, April 10<\\/h1>\\r\\n<p>Artist Talk-12:30-1:30 pm<\\/p>\\r\\n<p>Reception-1:30-3 pm<\\/p>\\r\\n<p>The Winfisky Gallery is open from 10 am-4 pm, Monday through Friday.<\\/p>\\r\\n<h1>Bios<\\/h1>\\r\\n<p><strong>Dr. Francisco Gonz\\u00e1lez Romo de Vivar<\\/strong> is an Assistant Professor at Tecnol\\u00f3gico de Monterrey, Campus Hidalgo, specializing in Art History, Visual Culture, and Semiotics. He holds a PhD in Art History from Centro de Cultura Casa Lamm, where his dissertation focused on cinematic themes using Gilles Deleuze\\u2019s filmic philosophy. His research interests include transdisciplinary practices in cinema, minor cinemas, and the aesthetic implications of technological advancements.<\\/p>\\r\\n<p>In his academic work, Dr. Gonz\\u00e1lez integrates these themes into his teaching, focusing on fostering global collaboration through technology-driven educational projects, including Collaborative Online International Learning (COIL). His courses cover topics such as Film Analysis, Posthumanism, and Audiovisual Narrative, encouraging students to engage critically with both historical and contemporary media.<\\/p>\\r\\n<p>Dr. Gonz\\u00e1lez is committed to creating learning environments that enhance student engagement and develop critical thinking. His current research explores intersections of cinema, media studies, and technology, continuously seeking new ways to enrich the educational experience in a global context.<\\/p>\\r\\n<p><strong>Tereza Swanda\\u2019s<\\/strong> interdisciplinary work centers on integrating with the \\u2018other,\\u2019 a term she uses to refer to diverse cultures, perspectives, and experiences. She resides in CZ and the States, teaching Studio Art and Art History at Salem State University and Roxbury Community College. Swanda holds an MFA from Vermont College of Fine Arts and a BFA in Painting and Sculpture from Massachusetts College of Art and Design.<\\/p>\\r\\n<p>She is currently working on a collaborative online international learning project, Trash2Art, which connects US students across the border to learners in Mexico. During the pandemic, her community engagement project, Touchstone, was included in The Immigrant Artist Biennial\\/ Mother Tongue. The artist asked those affected by COVID-19 to email her photos of loved ones, which she painted on stone. Her curatorial project, Unredacted, brought ten artists together who acknowledged the political post-truth world as artists and activists. Swanda received the A.R.T. Fund award to pursue her project, Capital Cleanse, in a rogue installation at the Metropolitan Museum of Art. She has exhibited her work at the Whitney Center for the Arts (Pittsfield, MA), University of Oregon (Eugene, OR), Berliner Kunstprojekt (Berlin), 450 Broadway Gallery (NY), Bakalar and Paine Galleries (Boston, MA), Chemeketa Community College Art Gallery (Salem, OR), Center on Contemporary Art (Seattle, WA) online in Storyscape Journal and Waves joining over 20,000 women who have contributed over the years. She has been awarded residencies at VSC (Johnson, VT) and the Millay Colony (Austerlitz, NY). She has been attending workshops with Rose Shakinovsky and Claire Gavronsky in Italy and South Africa since 2000.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Trash Transformed: A Binational Perspective on Art and Sustainability\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"trash-transformed-a-binational-perspective-on-art-and-sustainability-5\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:51:12\",\"post_modified_gmt\":\"2025-04-15 05:51:12\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1522\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1575,\"post_author\":\"1\",\"post_date\":\"2025-04-15 01:41:21\",\"post_date_gmt\":\"2025-04-15 01:41:21\",\"post_content\":\"<p>Every Friday night from 6:00PM - 9:00PM enjoy live music from local performers on East Regiment Beer Company\'s covered patio. Different musicians\\/bands every week and no cover charge! <a href=\\\"https:\\/\\/eastregimentbeercompany.com\\/events\\\">Find out who\'s playing this week online here!<\\/a><\\/p>\",\"post_title\":\"Live Music Night at East Regiment\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"live-music-night-at-east-regiment\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:46:37\",\"post_modified_gmt\":\"2025-04-15 05:46:37\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/live-music-night-at-east-regiment\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1731,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:16:47\",\"post_date_gmt\":\"2025-04-15 06:16:47\",\"post_content\":\"<p><em>This is a multiday event from Mar 30, 2025 - Apr 05, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>Are you a student interested in building skills and enhancing strategies related to academic success? Do you need a little bit of guidance and support around a particular academic success topic? Attend a <em><strong>Student Success Series Workshop<\\/strong><\\/em> (via Zoom) happening all this week at a variety of times.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Monday March 31:<\\/strong><\\/p>\\r\\n<p>10:30-11 am: Earning Participation Points in Online Classes<\\/p>\\r\\n<p>3-3:30 pm: Secrets of Successful Students<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Tuesday April 1:<\\/strong><\\/p>\\r\\n<p>11:30 am-12 pm: Online Tools for Success<\\/p>\\r\\n<p>2-2:30 pm: Avoiding Zoom Fatigue<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Wednesday April 2:<\\/strong><\\/p>\\r\\n<p>9:30-10 am: Goal Setting<\\/p>\\r\\n<p>1-1:30 pm: Writing Emails for Success<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Thursday April 3:<\\/strong><\\/p>\\r\\n<p>9-9:30 am: Common Mistakes in Online Classes<\\/p>\\r\\n<p>4-4:30 pm: Apps Which UP Your GPA<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Friday April 4:<\\/strong><\\/p>\\r\\n<p>10:30-11 am: Talking with Professors in Office Hours<\\/p>\\r\\n<p>4-4:30 pm: Conquering Procrastination<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>Can\'t attend a specific session? There are a number of additional academic resources available for students to take advantage of on the main Student Success Canvas page.<\\/p>\\r\\n<p>The full series schedule and Zoom access information are available on the individual Student Success Series section of the <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\\">Student Success Canvas<\\/a> page.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>First Year Experience<br \\/><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Student Success Series Workshops:\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"student-success-series-workshops-18\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:17:05\",\"post_modified_gmt\":\"2025-04-15 06:17:05\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1731\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1523,\"post_author\":\"1\",\"post_date\":\"2025-04-14 23:45:12\",\"post_date_gmt\":\"2025-04-14 23:45:12\",\"post_content\":\"<p><em>This is a multiday event from Mar 31, 2025 - Apr 18, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>The \\\"Trash to Art\\\" initiative, a Collaborative Online International Learning (COIL) project between Salem State University in the United States and Tecnol\\u00f3gico de Monterrey in Mexico, exemplifies the transformative power of global shared learning. Guided by Professors Tereza Swanda and Francisco Gonz\\u00e1lez Romo de Vivar, this project engages students from diverse cultural backgrounds in repurposing discarded materials into meaningful artworks, promoting a profound understanding of environmental sustainability and cross-cultural collaboration. By aligning with the United Nations Sustainable Development Goals #12 (Sustainable Consumption and Production) and #13 (Climate Action), \\\"Trash to Art\\\" challenges participants to critically examine their consumption patterns and the environmental impact of human activities.<\\/p>\\r\\n<h1>Additional Exhibition Events on Thursday, April 10<\\/h1>\\r\\n<p>Artist Talk-12:30-1:30 pm<\\/p>\\r\\n<p>Reception-1:30-3 pm<\\/p>\\r\\n<p>The Winfisky Gallery is open from 10 am-4 pm, Monday through Friday.<\\/p>\\r\\n<h1>Bios<\\/h1>\\r\\n<p><strong>Dr. Francisco Gonz\\u00e1lez Romo de Vivar<\\/strong> is an Assistant Professor at Tecnol\\u00f3gico de Monterrey, Campus Hidalgo, specializing in Art History, Visual Culture, and Semiotics. He holds a PhD in Art History from Centro de Cultura Casa Lamm, where his dissertation focused on cinematic themes using Gilles Deleuze\\u2019s filmic philosophy. His research interests include transdisciplinary practices in cinema, minor cinemas, and the aesthetic implications of technological advancements.<\\/p>\\r\\n<p>In his academic work, Dr. Gonz\\u00e1lez integrates these themes into his teaching, focusing on fostering global collaboration through technology-driven educational projects, including Collaborative Online International Learning (COIL). His courses cover topics such as Film Analysis, Posthumanism, and Audiovisual Narrative, encouraging students to engage critically with both historical and contemporary media.<\\/p>\\r\\n<p>Dr. Gonz\\u00e1lez is committed to creating learning environments that enhance student engagement and develop critical thinking. His current research explores intersections of cinema, media studies, and technology, continuously seeking new ways to enrich the educational experience in a global context.<\\/p>\\r\\n<p><strong>Tereza Swanda\\u2019s<\\/strong> interdisciplinary work centers on integrating with the \\u2018other,\\u2019 a term she uses to refer to diverse cultures, perspectives, and experiences. She resides in CZ and the States, teaching Studio Art and Art History at Salem State University and Roxbury Community College. Swanda holds an MFA from Vermont College of Fine Arts and a BFA in Painting and Sculpture from Massachusetts College of Art and Design.<\\/p>\\r\\n<p>She is currently working on a collaborative online international learning project, Trash2Art, which connects US students across the border to learners in Mexico. During the pandemic, her community engagement project, Touchstone, was included in The Immigrant Artist Biennial\\/ Mother Tongue. The artist asked those affected by COVID-19 to email her photos of loved ones, which she painted on stone. Her curatorial project, Unredacted, brought ten artists together who acknowledged the political post-truth world as artists and activists. Swanda received the A.R.T. Fund award to pursue her project, Capital Cleanse, in a rogue installation at the Metropolitan Museum of Art. She has exhibited her work at the Whitney Center for the Arts (Pittsfield, MA), University of Oregon (Eugene, OR), Berliner Kunstprojekt (Berlin), 450 Broadway Gallery (NY), Bakalar and Paine Galleries (Boston, MA), Chemeketa Community College Art Gallery (Salem, OR), Center on Contemporary Art (Seattle, WA) online in Storyscape Journal and Waves joining over 20,000 women who have contributed over the years. She has been awarded residencies at VSC (Johnson, VT) and the Millay Colony (Austerlitz, NY). She has been attending workshops with Rose Shakinovsky and Claire Gavronsky in Italy and South Africa since 2000.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Trash Transformed: A Binational Perspective on Art and Sustainability\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"trash-transformed-a-binational-perspective-on-art-and-sustainability-6\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:51:05\",\"post_modified_gmt\":\"2025-04-15 05:51:05\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1523\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1583,\"post_author\":\"1\",\"post_date\":\"2025-04-15 02:48:41\",\"post_date_gmt\":\"2025-04-15 02:48:41\",\"post_content\":\"<p>Join us for the launch of \'THE BABE PRESENTS\' music series with co-headliners Alexander (Indie-Alternative \\u2022 Boston, MA) and JD Debris &amp; The Melee (Poetry-Jazz Fusion \\u2022 Salem, MA)! We\'ve partnered with The Wandering Stage for pro staging, sound and lighting and are excited to bring an eclectic mix of local and regional artists to Salem!!! This will be an indoor show at The Babe.<\\/p>\\r\\n<p>ALEXANDER is the music project of Boston-based musician and educator Alex Fatato. In 2018, Alexander released their debut album \'Settle Down\', which was recognized by NPR for lyrics that \\u201cget a grip on distorted thinking.\\u201d In 2024, Alexander released their fourth album, \'Lucky Life\' which was listed as one of Allston Pudding\'s \'Favorite Local Albums of 2024\'. They will release their third EP, EP3, on April 4th, 2025. Alexander\\u2019s music is for everyone.<\\/p>\\r\\n<p>JD DEBRIS &amp; THE MELEE mix bandleader J.D. Debris\\u2019 poetry \\u2014 alternately sung and spoken \\u2014 with hypnotic underground jazz. The author of a prize winning debut book, The Scorpion\'s Question Mark (Autumn HousePress, 2023), Debris carries on the tradition of Gil Scott-Heron as a poet whose work shines brightest when combined with a boisterous live ensemble. The Melee bring a grimy, punkish approach to the jazz and Latin rhythms underlining Debris\\u2019 verses, with an improvisational energy that guarantees no two shows are the same. J.D. Debris\\u2019 newest single, \\u201cWho Shot Alexis Arg\\u00fcello?\\u201d is available on all streaming platforms, with a full-length slated to follow in 2025.<\\/p>\\r\\n<p>Fees\\/Admission<br \\/>$10<\\/p>\",\"post_title\":\"The Babe Presents: Alexander \\/ JD Debris and The Melee\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"the-babe-presents-alexander-jd-debris-the-melee\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:49:36\",\"post_modified_gmt\":\"2025-04-15 05:49:36\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/the-babe-presents-alexander-jd-debris-the-melee\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":820,\"post_author\":\"1\",\"post_date\":\"2025-03-27 00:21:01\",\"post_date_gmt\":\"2025-03-27 00:21:01\",\"post_content\":\"<p>Are you a student interested in building skills and enhancing strategies related to academic success? Do you need a little bit of guidance and support around a particular academic success topic? Attend a <em><strong>Student Success Series Workshop<\\/strong><\\/em> (via Zoom) happening all this week at a variety of times.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Monday April 6:<\\/strong><\\/p>\\r\\n<p>11-11:30 am: Developing an Effective Online Presentation<\\/p>\\r\\n<p>3:30-4 pm: Tricks to Improve Your Memory<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Tuesday April 7:<\\/strong><\\/p>\\r\\n<p>12-12:30 pm: Setting Up A Successful Study Group<\\/p>\\r\\n<p>2:30-3 pm: Making a Plan for the Rest of the Semester<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Wednesday April 8:<\\/strong><\\/p>\\r\\n<p>9:30-10 am: Budgeting and Finance for College Students<\\/p>\\r\\n<p>3-3:30 pm: Tips for online Learning Success<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Thursday April 9:<\\/strong><\\/p>\\r\\n<p>9:30-10 am: Time Management<\\/p>\\r\\n<p>2-2:30pm: Study Skills<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Friday April 10:<\\/strong><\\/p>\\r\\n<p>11-11:30 am: Tips for Taking Notes in Online Classes<\\/p>\\r\\n<p>1:30-2 pm: Earning Participation Points in Online Classes<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>Can\'t attend a specific session? There are a number of additional academic resources available for students to take advantage of on the main <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\\">Student Success Canvas<\\/a> page.<\\/p>\\r\\n<p>The <strong>full series schedule <\\/strong>and <strong>Zoom access information<\\/strong> are available on the individual <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\/pages\\/student-success-workshops\\\">Student Success Series<\\/a> section of the Student Success Canvas page.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>First Year Experience<br \\/><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Student Success Series Workshops:\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"student-success-series-workshops-3\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:23:51\",\"post_modified_gmt\":\"2025-04-15 06:23:51\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/student-success-series-workshops-3\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1524,\"post_author\":\"1\",\"post_date\":\"2025-04-14 23:45:28\",\"post_date_gmt\":\"2025-04-14 23:45:28\",\"post_content\":\"<p><em>This is a multiday event from Mar 31, 2025 - Apr 18, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>The \\\"Trash to Art\\\" initiative, a Collaborative Online International Learning (COIL) project between Salem State University in the United States and Tecnol\\u00f3gico de Monterrey in Mexico, exemplifies the transformative power of global shared learning. Guided by Professors Tereza Swanda and Francisco Gonz\\u00e1lez Romo de Vivar, this project engages students from diverse cultural backgrounds in repurposing discarded materials into meaningful artworks, promoting a profound understanding of environmental sustainability and cross-cultural collaboration. By aligning with the United Nations Sustainable Development Goals #12 (Sustainable Consumption and Production) and #13 (Climate Action), \\\"Trash to Art\\\" challenges participants to critically examine their consumption patterns and the environmental impact of human activities.<\\/p>\\r\\n<h1>Additional Exhibition Events on Thursday, April 10<\\/h1>\\r\\n<p>Artist Talk-12:30-1:30 pm<\\/p>\\r\\n<p>Reception-1:30-3 pm<\\/p>\\r\\n<p>The Winfisky Gallery is open from 10 am-4 pm, Monday through Friday.<\\/p>\\r\\n<h1>Bios<\\/h1>\\r\\n<p><strong>Dr. Francisco Gonz\\u00e1lez Romo de Vivar<\\/strong> is an Assistant Professor at Tecnol\\u00f3gico de Monterrey, Campus Hidalgo, specializing in Art History, Visual Culture, and Semiotics. He holds a PhD in Art History from Centro de Cultura Casa Lamm, where his dissertation focused on cinematic themes using Gilles Deleuze\\u2019s filmic philosophy. His research interests include transdisciplinary practices in cinema, minor cinemas, and the aesthetic implications of technological advancements.<\\/p>\\r\\n<p>In his academic work, Dr. Gonz\\u00e1lez integrates these themes into his teaching, focusing on fostering global collaboration through technology-driven educational projects, including Collaborative Online International Learning (COIL). His courses cover topics such as Film Analysis, Posthumanism, and Audiovisual Narrative, encouraging students to engage critically with both historical and contemporary media.<\\/p>\\r\\n<p>Dr. Gonz\\u00e1lez is committed to creating learning environments that enhance student engagement and develop critical thinking. His current research explores intersections of cinema, media studies, and technology, continuously seeking new ways to enrich the educational experience in a global context.<\\/p>\\r\\n<p><strong>Tereza Swanda\\u2019s<\\/strong> interdisciplinary work centers on integrating with the \\u2018other,\\u2019 a term she uses to refer to diverse cultures, perspectives, and experiences. She resides in CZ and the States, teaching Studio Art and Art History at Salem State University and Roxbury Community College. Swanda holds an MFA from Vermont College of Fine Arts and a BFA in Painting and Sculpture from Massachusetts College of Art and Design.<\\/p>\\r\\n<p>She is currently working on a collaborative online international learning project, Trash2Art, which connects US students across the border to learners in Mexico. During the pandemic, her community engagement project, Touchstone, was included in The Immigrant Artist Biennial\\/ Mother Tongue. The artist asked those affected by COVID-19 to email her photos of loved ones, which she painted on stone. Her curatorial project, Unredacted, brought ten artists together who acknowledged the political post-truth world as artists and activists. Swanda received the A.R.T. Fund award to pursue her project, Capital Cleanse, in a rogue installation at the Metropolitan Museum of Art. She has exhibited her work at the Whitney Center for the Arts (Pittsfield, MA), University of Oregon (Eugene, OR), Berliner Kunstprojekt (Berlin), 450 Broadway Gallery (NY), Bakalar and Paine Galleries (Boston, MA), Chemeketa Community College Art Gallery (Salem, OR), Center on Contemporary Art (Seattle, WA) online in Storyscape Journal and Waves joining over 20,000 women who have contributed over the years. She has been awarded residencies at VSC (Johnson, VT) and the Millay Colony (Austerlitz, NY). She has been attending workshops with Rose Shakinovsky and Claire Gavronsky in Italy and South Africa since 2000.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Trash Transformed: A Binational Perspective on Art and Sustainability\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"trash-transformed-a-binational-perspective-on-art-and-sustainability-7\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:50:57\",\"post_modified_gmt\":\"2025-04-15 05:50:57\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1524\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":822,\"post_author\":\"1\",\"post_date\":\"2025-03-27 00:30:06\",\"post_date_gmt\":\"2025-03-27 00:30:06\",\"post_content\":\"<p><em>This is a multiday event from Apr 07, 2025 - Apr 12, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>This year\'s Earth Days theme, Climate Change and Biodiversity, touches on many areas of study across campus. Please save the dates April 7 - 11, 2025 and be on the lookout for more information about lectures, panels, films and other activities during this week.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Tara Gallagher<br \\/><a href=\\\"mailto:Tgallagher@salemstate.edu\\\">Tgallagher@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.793.3913\\\">978.793.3913<\\/a><br \\/><a href=\\\"https:\\/\\/www.salemstate.edu\\/offices-and-services\\/sustainability\\/earth-days\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Earth Days 2025: Climate Change and Biodiversity\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"earth-days-2025-climate-change-and-biodiversity\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:22:57\",\"post_modified_gmt\":\"2025-04-11 05:22:57\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/earth-days-2025-climate-change-and-biodiversity\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":824,\"post_author\":\"1\",\"post_date\":\"2025-03-27 00:46:05\",\"post_date_gmt\":\"2025-03-27 00:46:05\",\"post_content\":\"<p><strong>Open to All SSU Students<\\/strong><\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>What<\\/strong>: We seem to have a titanic love affair with plastics. Their creation began as a means of making our lives easier. The use of plastics and their immense proliferation has become a detriment to both us and our environment.<\\/p>\\r\\n<p>After gathering information about plastic, its impact on our lives and effect upon the environment, students in Professor Ken Reker\\u2019s Form and Design classes are fabricating sculptural works using found objects, plastic and petroleum-based products, and consumer refuse.<\\/p>\\r\\n<p><strong>When<\\/strong>: These artworks will be displayed during the poster session on opening day of the 2025 Earth Day Celebration on Monday, April 7 from 11 am-12 pm in Vets Hall, ECC. Cash prizes are offered for winning pieces.<\\/p>\\r\\n<p><strong>You can participate too!<\\/strong> This project is open to any student in the SSU community who would like to participate with a sculpture. Please contact Ken Reker at <a href=\\\"mailto:k_reker@salemstate.edu\\\">k_reker@salemstate.edu<\\/a> for additional information.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Karen A Gahagan<br \\/><a href=\\\"mailto:kgahagan@salemstate.edu\\\">kgahagan@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.7890\\\">978.542.7890<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Message in a Bottle: Earth Days Art Competition\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"message-in-a-bottle-earth-days-art-competition\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:22:52\",\"post_modified_gmt\":\"2025-04-11 05:22:52\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/message-in-a-bottle-earth-days-art-competition\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":826,\"post_author\":\"1\",\"post_date\":\"2025-03-27 00:58:37\",\"post_date_gmt\":\"2025-03-27 00:58:37\",\"post_content\":\"<p>Discuss comprehensive, holistic, trauma-informed care to trafficking victims and to partner with local and regional social service providers to assist survivors in rebuilding their lives.<\\/p>\\r\\n<p>Speakers:<\\/p>\\r\\n<ul>\\r\\n<li><strong>Andrea Reilly MD,<\\/strong> Medical Director, MGH Freedom Clinic<\\/li>\\r\\n<li><strong>Zo\\u00eb Kessler, PhD,<\\/strong> Professor at the School of Social Work at Salem State University<\\/li>\\r\\n<\\/ul>\\r\\n<p>This is an online event and <a href=\\\"https:\\/\\/salemstateuniversity.wufoo.com\\/forms\\/salem-state-chhs-interprofessional-events\\/\\\"><strong>registration<\\/strong> <\\/a>is required.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Jeramie Silveira<br \\/><a href=\\\"mailto:jsilveira@salemstate.edu\\\">jsilveira@salemstate.edu<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Human Trafficking and Trauma Informed Care\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"human-trafficking-and-trauma-informed-care\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:22:46\",\"post_modified_gmt\":\"2025-04-11 05:22:46\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/human-trafficking-and-trauma-informed-care\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":828,\"post_author\":\"1\",\"post_date\":\"2025-03-27 01:03:31\",\"post_date_gmt\":\"2025-03-27 01:03:31\",\"post_content\":\"<p>Campus Life and Recreation\\/Gassett Fitness Center partner with a local Physical Therapist every month to offer you free advice! Stop by at the time most convenient for you between 5-7 pm. No need to pre-register.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Alejandro Rubero<br \\/><a href=\\\"mailto:arubero@salemstate.edu\\\">arubero@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.5181\\\">978.542.5181<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Ask a PT\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"ask-a-pt\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:22:38\",\"post_modified_gmt\":\"2025-04-11 05:22:38\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/ask-a-pt\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":832,\"post_author\":\"1\",\"post_date\":\"2025-03-27 01:25:12\",\"post_date_gmt\":\"2025-03-27 01:25:12\",\"post_content\":\"<p>Looking for a place to connect, practice Spanish, and build community?<\\/p>\\n<p>Faculty, staff, and students of all proficiency levels are invited to join us for <strong>Caf\\u00e9 y Tertulia<\\/strong>, a twice-monthly gathering for anyone seeking to improve their Spanish or help others learn the language.<\\/p>\\n<p>Together, we\\u2019ll practice, share ideas, and learn from one another in a fun and supportive environment. Come relax after class or work\\u2014we\\u2019ll provide discussion topics, coffee and treats. \\u00a1V\\u00e1monos!<\\/p>\\n<p>Every other Monday during spring semester:<\\/p>\\n<p>February 10<br \\/>February 24 <br \\/>March 10<br \\/>March 24<br \\/>April 7<br \\/>April 28<br \\/>May 12<\\/p>\\n<p>When: 5:30 pm - 6:30 pm<\\/p>\\n<p>This recurring event is sponsored by HSI-MSI Initiatives, part of Inclusive Excellence.<\\/p>\\n<p><strong>Contact<\\/strong><br \\/>Jess Cook<br \\/><a href=\\\"mailto:jcook2@salemstate.edu\\\">jcook2@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4954\\\">978.542.4954<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\n\\n<!-- wp:paragraph -->\\n<p><\\/p>\\n<!-- \\/wp:paragraph -->\",\"post_title\":\"Caf\\u00e9 y Tertulia | Coffee and Spanish Conversation April 7\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"cafe-y-tertulia-coffee-and-spanish-conversation-2\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-31 03:59:18\",\"post_modified_gmt\":\"2025-03-31 03:59:18\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=832\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1525,\"post_author\":\"1\",\"post_date\":\"2025-04-14 23:45:44\",\"post_date_gmt\":\"2025-04-14 23:45:44\",\"post_content\":\"<p><em>This is a multiday event from Mar 31, 2025 - Apr 18, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>The \\\"Trash to Art\\\" initiative, a Collaborative Online International Learning (COIL) project between Salem State University in the United States and Tecnol\\u00f3gico de Monterrey in Mexico, exemplifies the transformative power of global shared learning. Guided by Professors Tereza Swanda and Francisco Gonz\\u00e1lez Romo de Vivar, this project engages students from diverse cultural backgrounds in repurposing discarded materials into meaningful artworks, promoting a profound understanding of environmental sustainability and cross-cultural collaboration. By aligning with the United Nations Sustainable Development Goals #12 (Sustainable Consumption and Production) and #13 (Climate Action), \\\"Trash to Art\\\" challenges participants to critically examine their consumption patterns and the environmental impact of human activities.<\\/p>\\r\\n<h1>Additional Exhibition Events on Thursday, April 10<\\/h1>\\r\\n<p>Artist Talk-12:30-1:30 pm<\\/p>\\r\\n<p>Reception-1:30-3 pm<\\/p>\\r\\n<p>The Winfisky Gallery is open from 10 am-4 pm, Monday through Friday.<\\/p>\\r\\n<h1>Bios<\\/h1>\\r\\n<p><strong>Dr. Francisco Gonz\\u00e1lez Romo de Vivar<\\/strong> is an Assistant Professor at Tecnol\\u00f3gico de Monterrey, Campus Hidalgo, specializing in Art History, Visual Culture, and Semiotics. He holds a PhD in Art History from Centro de Cultura Casa Lamm, where his dissertation focused on cinematic themes using Gilles Deleuze\\u2019s filmic philosophy. His research interests include transdisciplinary practices in cinema, minor cinemas, and the aesthetic implications of technological advancements.<\\/p>\\r\\n<p>In his academic work, Dr. Gonz\\u00e1lez integrates these themes into his teaching, focusing on fostering global collaboration through technology-driven educational projects, including Collaborative Online International Learning (COIL). His courses cover topics such as Film Analysis, Posthumanism, and Audiovisual Narrative, encouraging students to engage critically with both historical and contemporary media.<\\/p>\\r\\n<p>Dr. Gonz\\u00e1lez is committed to creating learning environments that enhance student engagement and develop critical thinking. His current research explores intersections of cinema, media studies, and technology, continuously seeking new ways to enrich the educational experience in a global context.<\\/p>\\r\\n<p><strong>Tereza Swanda\\u2019s<\\/strong> interdisciplinary work centers on integrating with the \\u2018other,\\u2019 a term she uses to refer to diverse cultures, perspectives, and experiences. She resides in CZ and the States, teaching Studio Art and Art History at Salem State University and Roxbury Community College. Swanda holds an MFA from Vermont College of Fine Arts and a BFA in Painting and Sculpture from Massachusetts College of Art and Design.<\\/p>\\r\\n<p>She is currently working on a collaborative online international learning project, Trash2Art, which connects US students across the border to learners in Mexico. During the pandemic, her community engagement project, Touchstone, was included in The Immigrant Artist Biennial\\/ Mother Tongue. The artist asked those affected by COVID-19 to email her photos of loved ones, which she painted on stone. Her curatorial project, Unredacted, brought ten artists together who acknowledged the political post-truth world as artists and activists. Swanda received the A.R.T. Fund award to pursue her project, Capital Cleanse, in a rogue installation at the Metropolitan Museum of Art. She has exhibited her work at the Whitney Center for the Arts (Pittsfield, MA), University of Oregon (Eugene, OR), Berliner Kunstprojekt (Berlin), 450 Broadway Gallery (NY), Bakalar and Paine Galleries (Boston, MA), Chemeketa Community College Art Gallery (Salem, OR), Center on Contemporary Art (Seattle, WA) online in Storyscape Journal and Waves joining over 20,000 women who have contributed over the years. She has been awarded residencies at VSC (Johnson, VT) and the Millay Colony (Austerlitz, NY). She has been attending workshops with Rose Shakinovsky and Claire Gavronsky in Italy and South Africa since 2000.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Trash Transformed: A Binational Perspective on Art and Sustainability\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"trash-transformed-a-binational-perspective-on-art-and-sustainability-8\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:50:51\",\"post_modified_gmt\":\"2025-04-15 05:50:51\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1525\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1738,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:23:06\",\"post_date_gmt\":\"2025-04-15 06:23:06\",\"post_content\":\"<p>Are you a student interested in building skills and enhancing strategies related to academic success? Do you need a little bit of guidance and support around a particular academic success topic? Attend a <em><strong>Student Success Series Workshop<\\/strong><\\/em> (via Zoom) happening all this week at a variety of times.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Monday April 6:<\\/strong><\\/p>\\r\\n<p>11-11:30 am: Developing an Effective Online Presentation<\\/p>\\r\\n<p>3:30-4 pm: Tricks to Improve Your Memory<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Tuesday April 7:<\\/strong><\\/p>\\r\\n<p>12-12:30 pm: Setting Up A Successful Study Group<\\/p>\\r\\n<p>2:30-3 pm: Making a Plan for the Rest of the Semester<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Wednesday April 8:<\\/strong><\\/p>\\r\\n<p>9:30-10 am: Budgeting and Finance for College Students<\\/p>\\r\\n<p>3-3:30 pm: Tips for online Learning Success<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Thursday April 9:<\\/strong><\\/p>\\r\\n<p>9:30-10 am: Time Management<\\/p>\\r\\n<p>2-2:30pm: Study Skills<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Friday April 10:<\\/strong><\\/p>\\r\\n<p>11-11:30 am: Tips for Taking Notes in Online Classes<\\/p>\\r\\n<p>1:30-2 pm: Earning Participation Points in Online Classes<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>Can\'t attend a specific session? There are a number of additional academic resources available for students to take advantage of on the main <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\\">Student Success Canvas<\\/a> page.<\\/p>\\r\\n<p>The <strong>full series schedule <\\/strong>and <strong>Zoom access information<\\/strong> are available on the individual <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\/pages\\/student-success-workshops\\\">Student Success Series<\\/a> section of the Student Success Canvas page.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>First Year Experience<br \\/><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Student Success Series Workshops:\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"student-success-series-workshops-25\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:23:53\",\"post_modified_gmt\":\"2025-04-15 06:23:53\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1738\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":831,\"post_author\":\"1\",\"post_date\":\"2025-03-27 01:13:00\",\"post_date_gmt\":\"2025-03-27 01:13:00\",\"post_content\":\"<strong>Open Dialogue Hour for Faculty and Staff<\\/strong>\\n\\nIn order to support open and direct dialogue between campus leadership, faculty and staff, our VP of Diversity and Inclusion, Christopher Macdonald-Dennis, is hosting weekly \\u201cHolding Space\\u201d sessions across campus.\\n\\nThese low-stakes, hour-long drop-in sessions are open to all faculty and staff who wish to stop by and engage in conversation with VP Macdonald-Dennis and other members of the President\\u2019s Executive Council (PEC) and campus leadership. To encourage meaningful connection, each session is scheduled in one of campus\\u2019s smaller conference rooms and open to in-person attendance only<span style=\\\"font-size: revert; color: initial;\\\">.<\\/span>\\n\\nAdditional Holding Space opportunities this semester:\\n\\n<strong>Friday, April 18 | 11 am-12 pm<\\/strong>\\n\\nHarrington Building 104\\n\\n<strong>Thursday, April 24 | 3:30-4:30 pm<\\/strong>\\n\\nMeier Hall 316B - Charlotte Forten Legacy Room\\n\\n<strong>Monday, April 28 | 1:30-2:30 pm<\\/strong>\\n\\nMarsh Hall 204\\n\\n<strong>Contact<\\/strong>\\nJess Cook\\n<a href=\\\"mailto:jcook2@salemstate.edu\\\">jcook2@salemstate.edu<\\/a>\\n<a href=\\\"tel:978.542.4954\\\">978.542.4954<\\/a>\\nFor access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.\",\"post_title\":\"Holding Space April 8 2025\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"holding-space-april-8-2025\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 01:13:00\",\"post_modified_gmt\":\"2025-03-27 01:13:00\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=831\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":833,\"post_author\":\"1\",\"post_date\":\"2025-03-27 01:29:36\",\"post_date_gmt\":\"2025-03-27 01:29:36\",\"post_content\":\"<p><strong>Graduate School Panel Discussion and Information Session<\\/strong><br \\/><br \\/>Join us for a panel discussion and information session over light bites on why you should consider graduate school at Salem State University, and how to set yourself up for success, regardless of where you are in the process!<\\/p>\\r\\n<p>This event is free and open to the Salem State University community and guests.<\\/p>\\r\\n<p>Coordinated by: Inclusive Excellence, School of Graduate Studies, Graduate Admissions, and Career Services<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Carlie Pierre<br \\/><a href=\\\"mailto:cpierre@salemstate.edu\\\">cpierre@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4852\\\">978.542.4852<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Navigating Your Future: A Guide to Graduate School\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"navigating-your-future-a-guide-to-graduate-school\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:22:32\",\"post_modified_gmt\":\"2025-04-11 05:22:32\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/navigating-your-future-a-guide-to-graduate-school\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":835,\"post_author\":\"1\",\"post_date\":\"2025-03-27 01:37:20\",\"post_date_gmt\":\"2025-03-27 01:37:20\",\"post_content\":\"<p>Join us for a student panel on successfully transitioning from your first to second year of college!<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Megan Wigton<br \\/><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Transitioning to Sophomore Year\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"transitioning-to-sophomore-year\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:22:27\",\"post_modified_gmt\":\"2025-04-11 05:22:27\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/transitioning-to-sophomore-year\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1526,\"post_author\":\"1\",\"post_date\":\"2025-04-14 23:46:02\",\"post_date_gmt\":\"2025-04-14 23:46:02\",\"post_content\":\"<p><em>This is a multiday event from Mar 31, 2025 - Apr 18, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>The \\\"Trash to Art\\\" initiative, a Collaborative Online International Learning (COIL) project between Salem State University in the United States and Tecnol\\u00f3gico de Monterrey in Mexico, exemplifies the transformative power of global shared learning. Guided by Professors Tereza Swanda and Francisco Gonz\\u00e1lez Romo de Vivar, this project engages students from diverse cultural backgrounds in repurposing discarded materials into meaningful artworks, promoting a profound understanding of environmental sustainability and cross-cultural collaboration. By aligning with the United Nations Sustainable Development Goals #12 (Sustainable Consumption and Production) and #13 (Climate Action), \\\"Trash to Art\\\" challenges participants to critically examine their consumption patterns and the environmental impact of human activities.<\\/p>\\r\\n<h1>Additional Exhibition Events on Thursday, April 10<\\/h1>\\r\\n<p>Artist Talk-12:30-1:30 pm<\\/p>\\r\\n<p>Reception-1:30-3 pm<\\/p>\\r\\n<p>The Winfisky Gallery is open from 10 am-4 pm, Monday through Friday.<\\/p>\\r\\n<h1>Bios<\\/h1>\\r\\n<p><strong>Dr. Francisco Gonz\\u00e1lez Romo de Vivar<\\/strong> is an Assistant Professor at Tecnol\\u00f3gico de Monterrey, Campus Hidalgo, specializing in Art History, Visual Culture, and Semiotics. He holds a PhD in Art History from Centro de Cultura Casa Lamm, where his dissertation focused on cinematic themes using Gilles Deleuze\\u2019s filmic philosophy. His research interests include transdisciplinary practices in cinema, minor cinemas, and the aesthetic implications of technological advancements.<\\/p>\\r\\n<p>In his academic work, Dr. Gonz\\u00e1lez integrates these themes into his teaching, focusing on fostering global collaboration through technology-driven educational projects, including Collaborative Online International Learning (COIL). His courses cover topics such as Film Analysis, Posthumanism, and Audiovisual Narrative, encouraging students to engage critically with both historical and contemporary media.<\\/p>\\r\\n<p>Dr. Gonz\\u00e1lez is committed to creating learning environments that enhance student engagement and develop critical thinking. His current research explores intersections of cinema, media studies, and technology, continuously seeking new ways to enrich the educational experience in a global context.<\\/p>\\r\\n<p><strong>Tereza Swanda\\u2019s<\\/strong> interdisciplinary work centers on integrating with the \\u2018other,\\u2019 a term she uses to refer to diverse cultures, perspectives, and experiences. She resides in CZ and the States, teaching Studio Art and Art History at Salem State University and Roxbury Community College. Swanda holds an MFA from Vermont College of Fine Arts and a BFA in Painting and Sculpture from Massachusetts College of Art and Design.<\\/p>\\r\\n<p>She is currently working on a collaborative online international learning project, Trash2Art, which connects US students across the border to learners in Mexico. During the pandemic, her community engagement project, Touchstone, was included in The Immigrant Artist Biennial\\/ Mother Tongue. The artist asked those affected by COVID-19 to email her photos of loved ones, which she painted on stone. Her curatorial project, Unredacted, brought ten artists together who acknowledged the political post-truth world as artists and activists. Swanda received the A.R.T. Fund award to pursue her project, Capital Cleanse, in a rogue installation at the Metropolitan Museum of Art. She has exhibited her work at the Whitney Center for the Arts (Pittsfield, MA), University of Oregon (Eugene, OR), Berliner Kunstprojekt (Berlin), 450 Broadway Gallery (NY), Bakalar and Paine Galleries (Boston, MA), Chemeketa Community College Art Gallery (Salem, OR), Center on Contemporary Art (Seattle, WA) online in Storyscape Journal and Waves joining over 20,000 women who have contributed over the years. She has been awarded residencies at VSC (Johnson, VT) and the Millay Colony (Austerlitz, NY). She has been attending workshops with Rose Shakinovsky and Claire Gavronsky in Italy and South Africa since 2000.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Trash Transformed: A Binational Perspective on Art and Sustainability\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"trash-transformed-a-binational-perspective-on-art-and-sustainability-9\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:50:43\",\"post_modified_gmt\":\"2025-04-15 05:50:43\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1526\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1567,\"post_author\":\"1\",\"post_date\":\"2025-04-15 01:32:07\",\"post_date_gmt\":\"2025-04-15 01:32:07\",\"post_content\":\"<p><a href=\\\"http:\\/\\/www.thebabesalem.com\\/events\\\">The Babe<\\/a> proudly presents \'Jazz Night\' every Tuesday from 6-9pm w\\/ live music by Steve Lacey (guitar) &amp; Pat Dole (upright bass). Join us weekly as we showcase jazz artists from Boston and the North Shore. Instrumentalists are encouraged to come by and sit in. Come by for cocktails, delicious bar snacks and sandwiches made from scratch and a cozy atmosphere to connect with friends and neighbors!<\\/p>\",\"post_title\":\"Live Jazz @ The Babe w\\/ Steve Lacey and Pat Dole\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"live-jazz-the-babe-w-steve-lacey-pat-dole-2\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:41:24\",\"post_modified_gmt\":\"2025-04-15 05:41:24\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1567\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1739,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:23:16\",\"post_date_gmt\":\"2025-04-15 06:23:16\",\"post_content\":\"<p>Are you a student interested in building skills and enhancing strategies related to academic success? Do you need a little bit of guidance and support around a particular academic success topic? Attend a <em><strong>Student Success Series Workshop<\\/strong><\\/em> (via Zoom) happening all this week at a variety of times.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Monday April 6:<\\/strong><\\/p>\\r\\n<p>11-11:30 am: Developing an Effective Online Presentation<\\/p>\\r\\n<p>3:30-4 pm: Tricks to Improve Your Memory<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Tuesday April 7:<\\/strong><\\/p>\\r\\n<p>12-12:30 pm: Setting Up A Successful Study Group<\\/p>\\r\\n<p>2:30-3 pm: Making a Plan for the Rest of the Semester<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Wednesday April 8:<\\/strong><\\/p>\\r\\n<p>9:30-10 am: Budgeting and Finance for College Students<\\/p>\\r\\n<p>3-3:30 pm: Tips for online Learning Success<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Thursday April 9:<\\/strong><\\/p>\\r\\n<p>9:30-10 am: Time Management<\\/p>\\r\\n<p>2-2:30pm: Study Skills<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Friday April 10:<\\/strong><\\/p>\\r\\n<p>11-11:30 am: Tips for Taking Notes in Online Classes<\\/p>\\r\\n<p>1:30-2 pm: Earning Participation Points in Online Classes<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>Can\'t attend a specific session? There are a number of additional academic resources available for students to take advantage of on the main <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\\">Student Success Canvas<\\/a> page.<\\/p>\\r\\n<p>The <strong>full series schedule <\\/strong>and <strong>Zoom access information<\\/strong> are available on the individual <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\/pages\\/student-success-workshops\\\">Student Success Series<\\/a> section of the Student Success Canvas page.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>First Year Experience<br \\/><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Student Success Series Workshops:\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"student-success-series-workshops-26\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:23:54\",\"post_modified_gmt\":\"2025-04-15 06:23:54\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1739\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":837,\"post_author\":\"1\",\"post_date\":\"2025-03-27 01:46:07\",\"post_date_gmt\":\"2025-03-27 01:46:07\",\"post_content\":\"<h1><strong>Save a Life! Donate!<\\/strong><\\/h1>\\r\\n<p>Join Community Service Initiative at the next Red Cross Blood Drive! <a href=\\\"https:\\/\\/nam10.safelinks.protection.outlook.com\\/?url=https%3A%2F%2Fwww.redcrossblood.org%2Fgive.html%2Fdrive-results%3FzipSponsor%3DSalem%2520State&amp;data=05%7C02%7Cbperry%40salemstate.edu%7C35b7b61e4a8a46c139ef08dd097404b7%7C70d32b73b45749d1950c4f78aeffc21b%7C0%7C0%7C638677116461295597%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=xKzObPsDrAtqWx6LYJwzf9dm6qlJ4gOyOgGOGqx1dHU%3D&amp;reserved=0\\\">Schedule an appointment<\\/a> or <a href=\\\"https:\\/\\/nam10.safelinks.protection.outlook.com\\/?url=https%3A%2F%2Fwww.redcrossblood.org%2F&amp;data=05%7C02%7Cbperry%40salemstate.edu%7C35b7b61e4a8a46c139ef08dd097404b7%7C70d32b73b45749d1950c4f78aeffc21b%7C0%7C0%7C638677116461313131%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=%2FJDJU5jQDaUYRYaPj%2B8SkZ1NiW8nSe1YxijioqPnEiQ%3D&amp;reserved=0\\\">visit the Red Cross website<\\/a> and search \\\"Salem State\\\" to sign up to donate at the drive.<\\/p>\\r\\n<p>Volunteers are also needed to check in donors and to assist donors by providing snacks and drinks after they have donated. Anyone interested in volunteering, please email <a href=\\\"mailto:service@salemstate.edu\\\">service@salemstate.edu<\\/a> to indicate when you may be available to volunteer.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Bruce Perry<br \\/><a href=\\\"mailto:service@salemstate.edu\\\">service@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2823\\\">978.542.2823<\\/a><br \\/><a href=\\\"https:\\/\\/www.redcrossblood.org\\/\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Red Cross Blood Drive\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"red-cross-blood-drive\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:22:21\",\"post_modified_gmt\":\"2025-04-11 05:22:21\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/red-cross-blood-drive\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1527,\"post_author\":\"1\",\"post_date\":\"2025-04-14 23:46:19\",\"post_date_gmt\":\"2025-04-14 23:46:19\",\"post_content\":\"<p><em>This is a multiday event from Mar 31, 2025 - Apr 18, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>The \\\"Trash to Art\\\" initiative, a Collaborative Online International Learning (COIL) project between Salem State University in the United States and Tecnol\\u00f3gico de Monterrey in Mexico, exemplifies the transformative power of global shared learning. Guided by Professors Tereza Swanda and Francisco Gonz\\u00e1lez Romo de Vivar, this project engages students from diverse cultural backgrounds in repurposing discarded materials into meaningful artworks, promoting a profound understanding of environmental sustainability and cross-cultural collaboration. By aligning with the United Nations Sustainable Development Goals #12 (Sustainable Consumption and Production) and #13 (Climate Action), \\\"Trash to Art\\\" challenges participants to critically examine their consumption patterns and the environmental impact of human activities.<\\/p>\\r\\n<h1>Additional Exhibition Events on Thursday, April 10<\\/h1>\\r\\n<p>Artist Talk-12:30-1:30 pm<\\/p>\\r\\n<p>Reception-1:30-3 pm<\\/p>\\r\\n<p>The Winfisky Gallery is open from 10 am-4 pm, Monday through Friday.<\\/p>\\r\\n<h1>Bios<\\/h1>\\r\\n<p><strong>Dr. Francisco Gonz\\u00e1lez Romo de Vivar<\\/strong> is an Assistant Professor at Tecnol\\u00f3gico de Monterrey, Campus Hidalgo, specializing in Art History, Visual Culture, and Semiotics. He holds a PhD in Art History from Centro de Cultura Casa Lamm, where his dissertation focused on cinematic themes using Gilles Deleuze\\u2019s filmic philosophy. His research interests include transdisciplinary practices in cinema, minor cinemas, and the aesthetic implications of technological advancements.<\\/p>\\r\\n<p>In his academic work, Dr. Gonz\\u00e1lez integrates these themes into his teaching, focusing on fostering global collaboration through technology-driven educational projects, including Collaborative Online International Learning (COIL). His courses cover topics such as Film Analysis, Posthumanism, and Audiovisual Narrative, encouraging students to engage critically with both historical and contemporary media.<\\/p>\\r\\n<p>Dr. Gonz\\u00e1lez is committed to creating learning environments that enhance student engagement and develop critical thinking. His current research explores intersections of cinema, media studies, and technology, continuously seeking new ways to enrich the educational experience in a global context.<\\/p>\\r\\n<p><strong>Tereza Swanda\\u2019s<\\/strong> interdisciplinary work centers on integrating with the \\u2018other,\\u2019 a term she uses to refer to diverse cultures, perspectives, and experiences. She resides in CZ and the States, teaching Studio Art and Art History at Salem State University and Roxbury Community College. Swanda holds an MFA from Vermont College of Fine Arts and a BFA in Painting and Sculpture from Massachusetts College of Art and Design.<\\/p>\\r\\n<p>She is currently working on a collaborative online international learning project, Trash2Art, which connects US students across the border to learners in Mexico. During the pandemic, her community engagement project, Touchstone, was included in The Immigrant Artist Biennial\\/ Mother Tongue. The artist asked those affected by COVID-19 to email her photos of loved ones, which she painted on stone. Her curatorial project, Unredacted, brought ten artists together who acknowledged the political post-truth world as artists and activists. Swanda received the A.R.T. Fund award to pursue her project, Capital Cleanse, in a rogue installation at the Metropolitan Museum of Art. She has exhibited her work at the Whitney Center for the Arts (Pittsfield, MA), University of Oregon (Eugene, OR), Berliner Kunstprojekt (Berlin), 450 Broadway Gallery (NY), Bakalar and Paine Galleries (Boston, MA), Chemeketa Community College Art Gallery (Salem, OR), Center on Contemporary Art (Seattle, WA) online in Storyscape Journal and Waves joining over 20,000 women who have contributed over the years. She has been awarded residencies at VSC (Johnson, VT) and the Millay Colony (Austerlitz, NY). She has been attending workshops with Rose Shakinovsky and Claire Gavronsky in Italy and South Africa since 2000.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Trash Transformed: A Binational Perspective on Art and Sustainability\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"trash-transformed-a-binational-perspective-on-art-and-sustainability-10\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:50:37\",\"post_modified_gmt\":\"2025-04-15 05:50:37\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1527\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1740,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:23:23\",\"post_date_gmt\":\"2025-04-15 06:23:23\",\"post_content\":\"<p>Are you a student interested in building skills and enhancing strategies related to academic success? Do you need a little bit of guidance and support around a particular academic success topic? Attend a <em><strong>Student Success Series Workshop<\\/strong><\\/em> (via Zoom) happening all this week at a variety of times.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Monday April 6:<\\/strong><\\/p>\\r\\n<p>11-11:30 am: Developing an Effective Online Presentation<\\/p>\\r\\n<p>3:30-4 pm: Tricks to Improve Your Memory<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Tuesday April 7:<\\/strong><\\/p>\\r\\n<p>12-12:30 pm: Setting Up A Successful Study Group<\\/p>\\r\\n<p>2:30-3 pm: Making a Plan for the Rest of the Semester<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Wednesday April 8:<\\/strong><\\/p>\\r\\n<p>9:30-10 am: Budgeting and Finance for College Students<\\/p>\\r\\n<p>3-3:30 pm: Tips for online Learning Success<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Thursday April 9:<\\/strong><\\/p>\\r\\n<p>9:30-10 am: Time Management<\\/p>\\r\\n<p>2-2:30pm: Study Skills<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Friday April 10:<\\/strong><\\/p>\\r\\n<p>11-11:30 am: Tips for Taking Notes in Online Classes<\\/p>\\r\\n<p>1:30-2 pm: Earning Participation Points in Online Classes<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>Can\'t attend a specific session? There are a number of additional academic resources available for students to take advantage of on the main <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\\">Student Success Canvas<\\/a> page.<\\/p>\\r\\n<p>The <strong>full series schedule <\\/strong>and <strong>Zoom access information<\\/strong> are available on the individual <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\/pages\\/student-success-workshops\\\">Student Success Series<\\/a> section of the Student Success Canvas page.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>First Year Experience<br \\/><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Student Success Series Workshops:\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"student-success-series-workshops-27\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:23:55\",\"post_modified_gmt\":\"2025-04-15 06:23:55\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1740\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":839,\"post_author\":\"1\",\"post_date\":\"2025-03-27 02:01:22\",\"post_date_gmt\":\"2025-03-27 02:01:22\",\"post_content\":\"<p>It\'s time once again to determine the fastest racer on campus! Challenge yourself against our returning winners or come watch the action. Don\'t slip on a banana!<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Sean Conners<br \\/><a href=\\\"mailto:sconners@salemstate.edu\\\">sconners@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4965\\\">978.542.4965<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Mario Kart Tournament\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"mario-kart-tournament\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:22:16\",\"post_modified_gmt\":\"2025-04-11 05:22:16\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/mario-kart-tournament\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":841,\"post_author\":\"1\",\"post_date\":\"2025-03-27 02:11:26\",\"post_date_gmt\":\"2025-03-27 02:11:26\",\"post_content\":\"<p>Join us as we Meet the Moment\\u00ae by celebrating all those who completed the 2025 educator license program.<\\/p>\\r\\n<p>The Educators Pinning Ceremony will include appetizers and refreshments, networking, and words of inspiration for our graduating students!<\\/p>\\r\\n<p>This event is proudly hosted by the Salem State University Friends of the McKeown School of Education and the Salem State University Alumni Association and Foundation, Inc.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Alumni Engagement<br \\/><a href=\\\"mailto:alumni@salemstate.edu\\\">alumni@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.7530\\\">978.542.7530<\\/a><br \\/><a href=\\\"https:\\/\\/participate.salemstate.edu\\/pinningceremony\\\">Get tickets<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"The 11th Annual Sheila P. Kearney \\u201954, \\u201867G Educators Pinning Ceremony\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"the-11th-annual-sheila-p-kearney-54-67g-educators-pinning-ceremony\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:22:12\",\"post_modified_gmt\":\"2025-04-11 05:22:12\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/the-11th-annual-sheila-p-kearney-54-67g-educators-pinning-ceremony\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":843,\"post_author\":\"1\",\"post_date\":\"2025-03-27 02:14:44\",\"post_date_gmt\":\"2025-03-27 02:14:44\",\"post_content\":\"<p>Calling all SSU Student Creatives! Sign up for the Spring Arts Coffeehouse.<\\/p>\\r\\n<p>Interested in art, creative writing, dance, music, or theatre? Join us for a night of performing, mingling with creatives on campus, and snacks!<\\/p>\\r\\n<p>This event is co-sponsored by Center for Creative and Performing Arts, Student Involvement and Activities, and Salem State Audio Engineer Society.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Karen A Gahagan<br \\/><a href=\\\"mailto:kgahagan@salemstate.edu\\\">kgahagan@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.7890\\\">978.542.7890<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Spring Arts Coffeehouse\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"spring-arts-coffeehouse\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:22:08\",\"post_modified_gmt\":\"2025-04-11 05:22:08\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/spring-arts-coffeehouse\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1453,\"post_author\":\"1\",\"post_date\":\"2025-04-11 03:32:45\",\"post_date_gmt\":\"2025-04-11 03:32:45\",\"post_content\":\"<p>Join us for a night of bold flavors and laid-back vibes at <em>Ember &amp; Ale: Smoked Beer Night!<\\/em> \\ud83c\\udf7a\\ud83d\\udd25<\\/p>\\r\\n<p>Explore a curated selection of smoky, roasty, and robust craft beers that bring the heat in the best way. Whether you\'re a seasoned beer enthusiast or just curious about trying something new, this is your chance to sip, savor, and discover the rich world of smoked brews.<\\/p>\\r\\n<p>Expect good pours, good people, and that warm campfire kind of chill \\u2014 without needing to chop any wood.<\\/p>\\r\\n<p><strong>21+<\\/strong><\\/p>\",\"post_title\":\"Ember and Ale: Smoked Beer Night\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"ember-and-ale-smoked-beer-night\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:48:50\",\"post_modified_gmt\":\"2025-04-15 05:48:50\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/ember-and-ale-smoked-beer-night\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1528,\"post_author\":\"1\",\"post_date\":\"2025-04-14 23:46:35\",\"post_date_gmt\":\"2025-04-14 23:46:35\",\"post_content\":\"<p><em>This is a multiday event from Mar 31, 2025 - Apr 18, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>The \\\"Trash to Art\\\" initiative, a Collaborative Online International Learning (COIL) project between Salem State University in the United States and Tecnol\\u00f3gico de Monterrey in Mexico, exemplifies the transformative power of global shared learning. Guided by Professors Tereza Swanda and Francisco Gonz\\u00e1lez Romo de Vivar, this project engages students from diverse cultural backgrounds in repurposing discarded materials into meaningful artworks, promoting a profound understanding of environmental sustainability and cross-cultural collaboration. By aligning with the United Nations Sustainable Development Goals #12 (Sustainable Consumption and Production) and #13 (Climate Action), \\\"Trash to Art\\\" challenges participants to critically examine their consumption patterns and the environmental impact of human activities.<\\/p>\\r\\n<h1>Additional Exhibition Events on Thursday, April 10<\\/h1>\\r\\n<p>Artist Talk-12:30-1:30 pm<\\/p>\\r\\n<p>Reception-1:30-3 pm<\\/p>\\r\\n<p>The Winfisky Gallery is open from 10 am-4 pm, Monday through Friday.<\\/p>\\r\\n<h1>Bios<\\/h1>\\r\\n<p><strong>Dr. Francisco Gonz\\u00e1lez Romo de Vivar<\\/strong> is an Assistant Professor at Tecnol\\u00f3gico de Monterrey, Campus Hidalgo, specializing in Art History, Visual Culture, and Semiotics. He holds a PhD in Art History from Centro de Cultura Casa Lamm, where his dissertation focused on cinematic themes using Gilles Deleuze\\u2019s filmic philosophy. His research interests include transdisciplinary practices in cinema, minor cinemas, and the aesthetic implications of technological advancements.<\\/p>\\r\\n<p>In his academic work, Dr. Gonz\\u00e1lez integrates these themes into his teaching, focusing on fostering global collaboration through technology-driven educational projects, including Collaborative Online International Learning (COIL). His courses cover topics such as Film Analysis, Posthumanism, and Audiovisual Narrative, encouraging students to engage critically with both historical and contemporary media.<\\/p>\\r\\n<p>Dr. Gonz\\u00e1lez is committed to creating learning environments that enhance student engagement and develop critical thinking. His current research explores intersections of cinema, media studies, and technology, continuously seeking new ways to enrich the educational experience in a global context.<\\/p>\\r\\n<p><strong>Tereza Swanda\\u2019s<\\/strong> interdisciplinary work centers on integrating with the \\u2018other,\\u2019 a term she uses to refer to diverse cultures, perspectives, and experiences. She resides in CZ and the States, teaching Studio Art and Art History at Salem State University and Roxbury Community College. Swanda holds an MFA from Vermont College of Fine Arts and a BFA in Painting and Sculpture from Massachusetts College of Art and Design.<\\/p>\\r\\n<p>She is currently working on a collaborative online international learning project, Trash2Art, which connects US students across the border to learners in Mexico. During the pandemic, her community engagement project, Touchstone, was included in The Immigrant Artist Biennial\\/ Mother Tongue. The artist asked those affected by COVID-19 to email her photos of loved ones, which she painted on stone. Her curatorial project, Unredacted, brought ten artists together who acknowledged the political post-truth world as artists and activists. Swanda received the A.R.T. Fund award to pursue her project, Capital Cleanse, in a rogue installation at the Metropolitan Museum of Art. She has exhibited her work at the Whitney Center for the Arts (Pittsfield, MA), University of Oregon (Eugene, OR), Berliner Kunstprojekt (Berlin), 450 Broadway Gallery (NY), Bakalar and Paine Galleries (Boston, MA), Chemeketa Community College Art Gallery (Salem, OR), Center on Contemporary Art (Seattle, WA) online in Storyscape Journal and Waves joining over 20,000 women who have contributed over the years. She has been awarded residencies at VSC (Johnson, VT) and the Millay Colony (Austerlitz, NY). She has been attending workshops with Rose Shakinovsky and Claire Gavronsky in Italy and South Africa since 2000.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Trash Transformed: A Binational Perspective on Art and Sustainability\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"trash-transformed-a-binational-perspective-on-art-and-sustainability-11\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:50:28\",\"post_modified_gmt\":\"2025-04-15 05:50:28\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1528\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1741,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:23:42\",\"post_date_gmt\":\"2025-04-15 06:23:42\",\"post_content\":\"<p>Are you a student interested in building skills and enhancing strategies related to academic success? Do you need a little bit of guidance and support around a particular academic success topic? Attend a <em><strong>Student Success Series Workshop<\\/strong><\\/em> (via Zoom) happening all this week at a variety of times.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Monday April 6:<\\/strong><\\/p>\\r\\n<p>11-11:30 am: Developing an Effective Online Presentation<\\/p>\\r\\n<p>3:30-4 pm: Tricks to Improve Your Memory<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Tuesday April 7:<\\/strong><\\/p>\\r\\n<p>12-12:30 pm: Setting Up A Successful Study Group<\\/p>\\r\\n<p>2:30-3 pm: Making a Plan for the Rest of the Semester<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Wednesday April 8:<\\/strong><\\/p>\\r\\n<p>9:30-10 am: Budgeting and Finance for College Students<\\/p>\\r\\n<p>3-3:30 pm: Tips for online Learning Success<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Thursday April 9:<\\/strong><\\/p>\\r\\n<p>9:30-10 am: Time Management<\\/p>\\r\\n<p>2-2:30pm: Study Skills<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Friday April 10:<\\/strong><\\/p>\\r\\n<p>11-11:30 am: Tips for Taking Notes in Online Classes<\\/p>\\r\\n<p>1:30-2 pm: Earning Participation Points in Online Classes<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>Can\'t attend a specific session? There are a number of additional academic resources available for students to take advantage of on the main <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\\">Student Success Canvas<\\/a> page.<\\/p>\\r\\n<p>The <strong>full series schedule <\\/strong>and <strong>Zoom access information<\\/strong> are available on the individual <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\/pages\\/student-success-workshops\\\">Student Success Series<\\/a> section of the Student Success Canvas page.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>First Year Experience<br \\/><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Student Success Series Workshops:\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"student-success-series-workshops-28\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:23:58\",\"post_modified_gmt\":\"2025-04-15 06:23:58\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1741\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":845,\"post_author\":\"1\",\"post_date\":\"2025-03-27 02:20:53\",\"post_date_gmt\":\"2025-03-27 02:20:53\",\"post_content\":\"<p><strong>Friday, April 11, 7 am-3 pm | Virtual<\\/strong><\\/p>\\r\\n<p>Learn more about innovative trends in education that are being used around the globe at the SSU Center for Childhood &amp; Youth Studies annual conference. Presenters from China, England, Nigeria, Pakistan, Vienna, India, Turkey, and the USA will present their cutting-edge suggestions for how to make education more relevant for students.<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/www.theworldasitcouldbe.org\\/5260-2\\/\\\"><strong>Learn more.<\\/strong><\\/a><\\/p>\\r\\n<p>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Innovative Strategies for Enhancing Youth Education\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"innovative-strategies-for-enhancing-youth-education\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:50:45\",\"post_modified_gmt\":\"2025-04-17 04:50:45\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/innovative-strategies-for-enhancing-youth-education\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":847,\"post_author\":\"1\",\"post_date\":\"2025-03-27 02:26:28\",\"post_date_gmt\":\"2025-03-27 02:26:28\",\"post_content\":\"<p>Salem State Athletics and the Alumni Association and Foundation invite members of the campus community to the 2025 Athletic Hall of Fame induction celebration.<\\/p>\\r\\n<p>This year\\u2019s celebration highlights the best and most significant contributions to Salem State athletics by four individuals and one team.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/ssuathletichof.eventbrite.com\\/\\\"><strong>Register today!<\\/strong><\\/a><\\/p>\\r\\n<p><br \\/><strong>Contact<\\/strong><br \\/>Alumni Relations<br \\/><a href=\\\"mailto:alumni@salemstate.edu\\\">alumni@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.7530\\\">978.542.7530<\\/a><br \\/><a href=\\\"https:\\/\\/ssuathletichof.eventbrite.com\\/\\\">Get tickets<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Salem State University Athletic Hall of Fame Class of 2025 Induction Celebration\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"salem-state-university-athletic-hall-of-fame-class-of-2025-induction-celebration\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:50:51\",\"post_modified_gmt\":\"2025-04-17 04:50:51\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/salem-state-university-athletic-hall-of-fame-class-of-2025-induction-celebration\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":849,\"post_author\":\"1\",\"post_date\":\"2025-03-27 02:28:47\",\"post_date_gmt\":\"2025-03-27 02:28:47\",\"post_content\":\"<p>Hosted by the Muslim Student Association!<\\/p>\\r\\n<p>Join the MSA for a cozy bonfire night as we enjoy the warmer weather and welcome the arrival of spring!<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Alaa Atoui<br \\/><a href=\\\"mailto:a_atoui@salemstate.edu\\\">a_atoui@salemstate.edu<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Smores Bonfire\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"smores-bonfire\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 03:38:19\",\"post_modified_gmt\":\"2025-04-07 03:38:19\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/smores-bonfire\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":851,\"post_author\":\"1\",\"post_date\":\"2025-03-27 02:48:24\",\"post_date_gmt\":\"2025-03-27 02:48:24\",\"post_content\":\"<p>Iaorana ASA Fam!<\\/p>\\r\\n<p>Ready to immerse yourself in the vibrant and rich culture of the Pacific Islands? Join us for an unforgettable Polynesian Dance Workshop with Yumi Matsumoto!<\\/p>\\r\\n<p>There will be a lei greeting to welcome you with love and aloha, as well as a breathtaking Polynesian dance performance featuring the beauty of Hula and Ori Tahiti. This will follow with an interactive workshop where YOU get to learn the graceful and powerful moves of these traditional dances. We will accommodate spam musubis from Manoa Poke to grab after the event to enjoy the taste of the islands! See you there with an open heart and dancing feet.<\\/p>\\r\\n<p>Mauruuru,<\\/p>\\r\\n<p>The ASA Executive Board<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Vivica Vu-Le<br \\/><a href=\\\"mailto:v_vule@salemstate.edu\\\">v_vule@salemstate.edu<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"APIDAHM Polynesian Dance Workshop\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"apidahm-polynesian-dance-workshop\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:50:57\",\"post_modified_gmt\":\"2025-04-17 04:50:57\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/apidahm-polynesian-dance-workshop\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1493,\"post_author\":\"1\",\"post_date\":\"2025-04-11 17:59:48\",\"post_date_gmt\":\"2025-04-11 17:59:48\",\"post_content\":\"<p>Bunny Spa Day \\u2013 April 11, 2025<\\/p>\\r\\n<p>Workshop Time: 10:00AM \\u2013 11:00AM<br \\/>Location: The Good Witch of Salem @ 2 North Street, Salem MA 01970<br \\/>Hosted By: <a href=\\\"https:\\/\\/goodwitchofsalem.com\\/products\\/bunny-spa-day-4-11?_pos=4&amp;_psq=bunnny&amp;_ss=e&amp;_v=1.0\\\">Witch Apprentice<\\/a><\\/p>\\r\\n<p>Fees\\/Admission: $35.50<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>Let\\u2019s have a Bunny Spa Day! Join us for a little pampering and relaxation with our Witch Apprentices. Children will create their own spring potion and receive sparkly nails, bunny hair accessories, and a touch of glitter with pink lips and rosy cheeks.<\\/p>\\r\\n<p>This workshop is limited to 8 children, pre-registration is required. Under age 4 may attend with the help of a supervising adult.<\\/p>\\r\\n<p>Due to space constraints, please refrain from bringing in strollers and wagons. Ticket purchase only admits one (1) participating child.<\\/p>\\r\\n<p>Please note: Event ticket purchases are non-refundable at this time.<\\/p>\",\"post_title\":\"Bunny Spa Day\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"bunny-spa-day\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:49:23\",\"post_modified_gmt\":\"2025-04-15 05:49:23\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/bunny-spa-day\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"}],\"found_posts\":228,\"max_num_pages\":5}','off');
INSERT INTO `wp_options` VALUES (95659,'_transient_timeout_em_56524b55de5123558ad16ed09152f55c1744956471','1745097391','off');
INSERT INTO `wp_options` VALUES (95660,'_transient_em_56524b55de5123558ad16ed09152f55c1744956471','{\"posts\":[{\"ID\":1529,\"post_author\":\"1\",\"post_date\":\"2025-04-14 23:46:56\",\"post_date_gmt\":\"2025-04-14 23:46:56\",\"post_content\":\"<p><em>This is a multiday event from Mar 31, 2025 - Apr 18, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>The \\\"Trash to Art\\\" initiative, a Collaborative Online International Learning (COIL) project between Salem State University in the United States and Tecnol\\u00f3gico de Monterrey in Mexico, exemplifies the transformative power of global shared learning. Guided by Professors Tereza Swanda and Francisco Gonz\\u00e1lez Romo de Vivar, this project engages students from diverse cultural backgrounds in repurposing discarded materials into meaningful artworks, promoting a profound understanding of environmental sustainability and cross-cultural collaboration. By aligning with the United Nations Sustainable Development Goals #12 (Sustainable Consumption and Production) and #13 (Climate Action), \\\"Trash to Art\\\" challenges participants to critically examine their consumption patterns and the environmental impact of human activities.<\\/p>\\r\\n<h1>Additional Exhibition Events on Thursday, April 10<\\/h1>\\r\\n<p>Artist Talk-12:30-1:30 pm<\\/p>\\r\\n<p>Reception-1:30-3 pm<\\/p>\\r\\n<p>The Winfisky Gallery is open from 10 am-4 pm, Monday through Friday.<\\/p>\\r\\n<h1>Bios<\\/h1>\\r\\n<p><strong>Dr. Francisco Gonz\\u00e1lez Romo de Vivar<\\/strong> is an Assistant Professor at Tecnol\\u00f3gico de Monterrey, Campus Hidalgo, specializing in Art History, Visual Culture, and Semiotics. He holds a PhD in Art History from Centro de Cultura Casa Lamm, where his dissertation focused on cinematic themes using Gilles Deleuze\\u2019s filmic philosophy. His research interests include transdisciplinary practices in cinema, minor cinemas, and the aesthetic implications of technological advancements.<\\/p>\\r\\n<p>In his academic work, Dr. Gonz\\u00e1lez integrates these themes into his teaching, focusing on fostering global collaboration through technology-driven educational projects, including Collaborative Online International Learning (COIL). His courses cover topics such as Film Analysis, Posthumanism, and Audiovisual Narrative, encouraging students to engage critically with both historical and contemporary media.<\\/p>\\r\\n<p>Dr. Gonz\\u00e1lez is committed to creating learning environments that enhance student engagement and develop critical thinking. His current research explores intersections of cinema, media studies, and technology, continuously seeking new ways to enrich the educational experience in a global context.<\\/p>\\r\\n<p><strong>Tereza Swanda\\u2019s<\\/strong> interdisciplinary work centers on integrating with the \\u2018other,\\u2019 a term she uses to refer to diverse cultures, perspectives, and experiences. She resides in CZ and the States, teaching Studio Art and Art History at Salem State University and Roxbury Community College. Swanda holds an MFA from Vermont College of Fine Arts and a BFA in Painting and Sculpture from Massachusetts College of Art and Design.<\\/p>\\r\\n<p>She is currently working on a collaborative online international learning project, Trash2Art, which connects US students across the border to learners in Mexico. During the pandemic, her community engagement project, Touchstone, was included in The Immigrant Artist Biennial\\/ Mother Tongue. The artist asked those affected by COVID-19 to email her photos of loved ones, which she painted on stone. Her curatorial project, Unredacted, brought ten artists together who acknowledged the political post-truth world as artists and activists. Swanda received the A.R.T. Fund award to pursue her project, Capital Cleanse, in a rogue installation at the Metropolitan Museum of Art. She has exhibited her work at the Whitney Center for the Arts (Pittsfield, MA), University of Oregon (Eugene, OR), Berliner Kunstprojekt (Berlin), 450 Broadway Gallery (NY), Bakalar and Paine Galleries (Boston, MA), Chemeketa Community College Art Gallery (Salem, OR), Center on Contemporary Art (Seattle, WA) online in Storyscape Journal and Waves joining over 20,000 women who have contributed over the years. She has been awarded residencies at VSC (Johnson, VT) and the Millay Colony (Austerlitz, NY). She has been attending workshops with Rose Shakinovsky and Claire Gavronsky in Italy and South Africa since 2000.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Trash Transformed: A Binational Perspective on Art and Sustainability\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"trash-transformed-a-binational-perspective-on-art-and-sustainability-12\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:50:15\",\"post_modified_gmt\":\"2025-04-15 05:50:15\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1529\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1577,\"post_author\":\"1\",\"post_date\":\"2025-04-15 01:42:09\",\"post_date_gmt\":\"2025-04-15 01:42:09\",\"post_content\":\"<p>Every Friday night from 6:00PM - 9:00PM enjoy live music from local performers on East Regiment Beer Company\'s covered patio. Different musicians\\/bands every week and no cover charge! <a href=\\\"https:\\/\\/eastregimentbeercompany.com\\/events\\\">Find out who\'s playing this week online here!<\\/a><\\/p>\",\"post_title\":\"Live Music Night at East Regiment\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"live-music-night-at-east-regiment-2\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:46:35\",\"post_modified_gmt\":\"2025-04-15 05:46:35\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1577\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1458,\"post_author\":\"1\",\"post_date\":\"2025-04-11 03:51:26\",\"post_date_gmt\":\"2025-04-11 03:51:26\",\"post_content\":\"<p>Create your own custom cocktail candle! You will start by choosing your wax color and stirring in fragrances to make your candle truly one-of-a-kind! Whether you want to make an \\ud83c\\udf78 espresso martini candle, \\ud83e\\udd43 old fashioned, or \\ud83c\\udf79 a cocktail of your choice - you will have the freedom to make your own custom piece. Choose from fun garnishes like umbrellas, dried fruits, or even make your own wax toppings. This will be a hands-on experience for you to melt, stir, and pour your own candle! All supplies provided and no prior experience needed.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/www.hoamsy.com\\/experiences\\/detail\\/gp6lP6HRAhtmmYpAPwev\\\">SIGN UP<\\/a><\\/p>\",\"post_title\":\"Cocktail Candle Crafting\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"cocktail-candle-crafting\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:48:54\",\"post_modified_gmt\":\"2025-04-15 05:48:54\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/cocktail-candle-crafting\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1530,\"post_author\":\"1\",\"post_date\":\"2025-04-14 23:47:10\",\"post_date_gmt\":\"2025-04-14 23:47:10\",\"post_content\":\"<p><em>This is a multiday event from Mar 31, 2025 - Apr 18, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>The \\\"Trash to Art\\\" initiative, a Collaborative Online International Learning (COIL) project between Salem State University in the United States and Tecnol\\u00f3gico de Monterrey in Mexico, exemplifies the transformative power of global shared learning. Guided by Professors Tereza Swanda and Francisco Gonz\\u00e1lez Romo de Vivar, this project engages students from diverse cultural backgrounds in repurposing discarded materials into meaningful artworks, promoting a profound understanding of environmental sustainability and cross-cultural collaboration. By aligning with the United Nations Sustainable Development Goals #12 (Sustainable Consumption and Production) and #13 (Climate Action), \\\"Trash to Art\\\" challenges participants to critically examine their consumption patterns and the environmental impact of human activities.<\\/p>\\r\\n<h1>Additional Exhibition Events on Thursday, April 10<\\/h1>\\r\\n<p>Artist Talk-12:30-1:30 pm<\\/p>\\r\\n<p>Reception-1:30-3 pm<\\/p>\\r\\n<p>The Winfisky Gallery is open from 10 am-4 pm, Monday through Friday.<\\/p>\\r\\n<h1>Bios<\\/h1>\\r\\n<p><strong>Dr. Francisco Gonz\\u00e1lez Romo de Vivar<\\/strong> is an Assistant Professor at Tecnol\\u00f3gico de Monterrey, Campus Hidalgo, specializing in Art History, Visual Culture, and Semiotics. He holds a PhD in Art History from Centro de Cultura Casa Lamm, where his dissertation focused on cinematic themes using Gilles Deleuze\\u2019s filmic philosophy. His research interests include transdisciplinary practices in cinema, minor cinemas, and the aesthetic implications of technological advancements.<\\/p>\\r\\n<p>In his academic work, Dr. Gonz\\u00e1lez integrates these themes into his teaching, focusing on fostering global collaboration through technology-driven educational projects, including Collaborative Online International Learning (COIL). His courses cover topics such as Film Analysis, Posthumanism, and Audiovisual Narrative, encouraging students to engage critically with both historical and contemporary media.<\\/p>\\r\\n<p>Dr. Gonz\\u00e1lez is committed to creating learning environments that enhance student engagement and develop critical thinking. His current research explores intersections of cinema, media studies, and technology, continuously seeking new ways to enrich the educational experience in a global context.<\\/p>\\r\\n<p><strong>Tereza Swanda\\u2019s<\\/strong> interdisciplinary work centers on integrating with the \\u2018other,\\u2019 a term she uses to refer to diverse cultures, perspectives, and experiences. She resides in CZ and the States, teaching Studio Art and Art History at Salem State University and Roxbury Community College. Swanda holds an MFA from Vermont College of Fine Arts and a BFA in Painting and Sculpture from Massachusetts College of Art and Design.<\\/p>\\r\\n<p>She is currently working on a collaborative online international learning project, Trash2Art, which connects US students across the border to learners in Mexico. During the pandemic, her community engagement project, Touchstone, was included in The Immigrant Artist Biennial\\/ Mother Tongue. The artist asked those affected by COVID-19 to email her photos of loved ones, which she painted on stone. Her curatorial project, Unredacted, brought ten artists together who acknowledged the political post-truth world as artists and activists. Swanda received the A.R.T. Fund award to pursue her project, Capital Cleanse, in a rogue installation at the Metropolitan Museum of Art. She has exhibited her work at the Whitney Center for the Arts (Pittsfield, MA), University of Oregon (Eugene, OR), Berliner Kunstprojekt (Berlin), 450 Broadway Gallery (NY), Bakalar and Paine Galleries (Boston, MA), Chemeketa Community College Art Gallery (Salem, OR), Center on Contemporary Art (Seattle, WA) online in Storyscape Journal and Waves joining over 20,000 women who have contributed over the years. She has been awarded residencies at VSC (Johnson, VT) and the Millay Colony (Austerlitz, NY). She has been attending workshops with Rose Shakinovsky and Claire Gavronsky in Italy and South Africa since 2000.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Trash Transformed: A Binational Perspective on Art and Sustainability\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"trash-transformed-a-binational-perspective-on-art-and-sustainability-13\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:50:09\",\"post_modified_gmt\":\"2025-04-15 05:50:09\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1530\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1588,\"post_author\":\"1\",\"post_date\":\"2025-04-15 03:46:34\",\"post_date_gmt\":\"2025-04-15 03:46:34\",\"post_content\":\"<p>As part of our weekend celebration of the Edwardian era, don your best period costume and join us in the Hawthorne Ballroom, inspired by Titanic\\u2019s grand interiors. Enjoy a live performance on arrival with Edwardian classics and Titanic-themed music that will fill the room with reflection. Sip on themed cocktails from the cash bar, and savor passed hors oeuvres \\u2013 curated bites from the era. The masquerade ball then comes to life with an upbeat dance party, where the live performer will join the modern-day disc jockey. Stick around for the costume contest and the grand dessert display of Titanic classics accompanied by coffee and tea. For the complete experience, remain on the dance floor until you hear the final bell. Tickets are $135 per person and available via <a href=\\\"http:\\/\\/eventbrite.com\\\">eventbrite.com<\\/a>.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"post_title\":\"Titanic Masquerade: The Grand Descent\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"titanic-masquerade-the-grand-descent\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 03:46:34\",\"post_modified_gmt\":\"2025-04-15 03:46:34\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/titanic-masquerade-the-grand-descent\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1460,\"post_author\":\"1\",\"post_date\":\"2025-04-11 03:54:25\",\"post_date_gmt\":\"2025-04-11 03:54:25\",\"post_content\":\"<!-- wp:paragraph -->\\r\\n<p>Love is in the air. Join us at Hotel Salem for their Wedding Expo. Sample our beer, learn about our private events and catering, meet other vendors.<\\/p>\\r\\n<!-- \\/wp:paragraph -->\\r\\n\\r\\n<!-- wp:paragraph -->\\r\\n<p>Free to register or show up!<\\/p>\\r\\n<!-- \\/wp:paragraph -->\",\"post_title\":\"Hotel Salem Wedding Expo\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"hotel-salem-wedding-expo\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-14 04:30:20\",\"post_modified_gmt\":\"2025-04-14 04:30:20\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1460\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1531,\"post_author\":\"1\",\"post_date\":\"2025-04-14 23:47:30\",\"post_date_gmt\":\"2025-04-14 23:47:30\",\"post_content\":\"<p><em>This is a multiday event from Mar 31, 2025 - Apr 18, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>The \\\"Trash to Art\\\" initiative, a Collaborative Online International Learning (COIL) project between Salem State University in the United States and Tecnol\\u00f3gico de Monterrey in Mexico, exemplifies the transformative power of global shared learning. Guided by Professors Tereza Swanda and Francisco Gonz\\u00e1lez Romo de Vivar, this project engages students from diverse cultural backgrounds in repurposing discarded materials into meaningful artworks, promoting a profound understanding of environmental sustainability and cross-cultural collaboration. By aligning with the United Nations Sustainable Development Goals #12 (Sustainable Consumption and Production) and #13 (Climate Action), \\\"Trash to Art\\\" challenges participants to critically examine their consumption patterns and the environmental impact of human activities.<\\/p>\\r\\n<h1>Additional Exhibition Events on Thursday, April 10<\\/h1>\\r\\n<p>Artist Talk-12:30-1:30 pm<\\/p>\\r\\n<p>Reception-1:30-3 pm<\\/p>\\r\\n<p>The Winfisky Gallery is open from 10 am-4 pm, Monday through Friday.<\\/p>\\r\\n<h1>Bios<\\/h1>\\r\\n<p><strong>Dr. Francisco Gonz\\u00e1lez Romo de Vivar<\\/strong> is an Assistant Professor at Tecnol\\u00f3gico de Monterrey, Campus Hidalgo, specializing in Art History, Visual Culture, and Semiotics. He holds a PhD in Art History from Centro de Cultura Casa Lamm, where his dissertation focused on cinematic themes using Gilles Deleuze\\u2019s filmic philosophy. His research interests include transdisciplinary practices in cinema, minor cinemas, and the aesthetic implications of technological advancements.<\\/p>\\r\\n<p>In his academic work, Dr. Gonz\\u00e1lez integrates these themes into his teaching, focusing on fostering global collaboration through technology-driven educational projects, including Collaborative Online International Learning (COIL). His courses cover topics such as Film Analysis, Posthumanism, and Audiovisual Narrative, encouraging students to engage critically with both historical and contemporary media.<\\/p>\\r\\n<p>Dr. Gonz\\u00e1lez is committed to creating learning environments that enhance student engagement and develop critical thinking. His current research explores intersections of cinema, media studies, and technology, continuously seeking new ways to enrich the educational experience in a global context.<\\/p>\\r\\n<p><strong>Tereza Swanda\\u2019s<\\/strong> interdisciplinary work centers on integrating with the \\u2018other,\\u2019 a term she uses to refer to diverse cultures, perspectives, and experiences. She resides in CZ and the States, teaching Studio Art and Art History at Salem State University and Roxbury Community College. Swanda holds an MFA from Vermont College of Fine Arts and a BFA in Painting and Sculpture from Massachusetts College of Art and Design.<\\/p>\\r\\n<p>She is currently working on a collaborative online international learning project, Trash2Art, which connects US students across the border to learners in Mexico. During the pandemic, her community engagement project, Touchstone, was included in The Immigrant Artist Biennial\\/ Mother Tongue. The artist asked those affected by COVID-19 to email her photos of loved ones, which she painted on stone. Her curatorial project, Unredacted, brought ten artists together who acknowledged the political post-truth world as artists and activists. Swanda received the A.R.T. Fund award to pursue her project, Capital Cleanse, in a rogue installation at the Metropolitan Museum of Art. She has exhibited her work at the Whitney Center for the Arts (Pittsfield, MA), University of Oregon (Eugene, OR), Berliner Kunstprojekt (Berlin), 450 Broadway Gallery (NY), Bakalar and Paine Galleries (Boston, MA), Chemeketa Community College Art Gallery (Salem, OR), Center on Contemporary Art (Seattle, WA) online in Storyscape Journal and Waves joining over 20,000 women who have contributed over the years. She has been awarded residencies at VSC (Johnson, VT) and the Millay Colony (Austerlitz, NY). She has been attending workshops with Rose Shakinovsky and Claire Gavronsky in Italy and South Africa since 2000.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Trash Transformed: A Binational Perspective on Art and Sustainability\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"trash-transformed-a-binational-perspective-on-art-and-sustainability-14\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:50:01\",\"post_modified_gmt\":\"2025-04-15 05:50:01\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1531\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":853,\"post_author\":\"1\",\"post_date\":\"2025-03-27 02:52:11\",\"post_date_gmt\":\"2025-03-27 02:52:11\",\"post_content\":\"<p>Are you a student interested in building skills and enhancing strategies related to academic success? Do you need a little bit of guidance and support around a particular academic success topic? Attend a <em><strong>Student Success Series Workshop<\\/strong><\\/em> (via Zoom) happening all this week at a variety of times.<\\/p>\\r\\n<p><strong>M<\\/strong><strong>onday April 14:<\\/strong><\\/p>\\r\\n<p>11:30am-12 pm: Managing Stress and Anxiety<\\/p>\\r\\n<p>4-4:30 pm: Common Mistakes in Online Classes<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Tuesday April 15:<\\/strong><\\/p>\\r\\n<p>11:30am-12 pm: Writing Emails for Success<\\/p>\\r\\n<p>3-3:30 pm: Talking with Professors in Office Hours<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Wednesday April 16:<\\/strong><\\/p>\\r\\n<p>12:30-1 pm: Tips for Online Learning Success<\\/p>\\r\\n<p>3:30-4 pm: Tricks to Improve Your Memory<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Thursday April 17:<\\/strong><\\/p>\\r\\n<p>10-10:30 am: Secrets of Successful Students<\\/p>\\r\\n<p>2:30-3 pm: Staying Focused in an Online Class<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Friday April 18:<\\/strong><\\/p>\\r\\n<p>10:30-11 am: Online Tools for Success<\\/p>\\r\\n<p>2-2:30 pm: Goal Setting<\\/p>\\r\\n<p>Can\'t attend a specific session? There are a number of additional academic resources available for students to take advantage of on the main <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\\">Student Success Canvas<\\/a> page. The <strong>full series schedule <\\/strong>and <strong>Zoom access information<\\/strong> are available on the individual <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\/pages\\/student-success-workshops\\\">Student Success Series<\\/a> section of the Student Success Canvas page.<\\/p>\\r\\n<p><strong>Contact<\\/strong><\\/p>\\r\\n<p>First Year Experience<\\/p>\\r\\n<p><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><\\/p>\\r\\n<p><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><\\/p>\\r\\n<p>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Student Success Series Workshops:\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"student-success-series-workshops-4\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:12:32\",\"post_modified_gmt\":\"2025-04-15 06:12:32\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=853\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":855,\"post_author\":\"1\",\"post_date\":\"2025-03-27 03:02:17\",\"post_date_gmt\":\"2025-03-27 03:02:17\",\"post_content\":\"<p>Get your steps in for well-being for a chance to win! Create a team or you can be placed on a team to compete against other university employees! Team with the most steps during the time period, will win a Campus Life and Recreation prize. Challenge will run from 4\\/14-4\\/27. Contact <a href=\\\"mailto:arubero@salemstate.edu\\\">arubero@salemstate.edu<\\/a> to build your team and for more information.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Alejandro Rubero<br \\/><a href=\\\"mailto:arubero@salemstate.edu\\\">arubero@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.5181\\\">978.542.5181<\\/a><br \\/><a href=\\\"https:\\/\\/brightbreaks.com\\/salemstate\\/\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Bright Breaks Step Challenge\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"bright-breaks-step-challenge\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:51:03\",\"post_modified_gmt\":\"2025-04-17 04:51:03\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/bright-breaks-step-challenge\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":857,\"post_author\":\"1\",\"post_date\":\"2025-03-27 03:12:46\",\"post_date_gmt\":\"2025-03-27 03:12:46\",\"post_content\":\"<p><strong>Explore your next chapter at Salem State<\\/strong><br \\/><em>This is a multiday event from Apr 14, 2025 - Apr 17, 2025.<\\/em><\\/p>\\r\\n<p>Thinking about graduate school? Join us online for a series of workshops covering all things graduate school at Salem State! Meet with program coordinators, ask questions, learn about financial support, and so much more.<\\/p>\\r\\n<h2>Virtual Graduate Open House Schedule<\\/h2>\\r\\n<p>Click a session name to register.<\\/p>\\r\\n<p><strong>Monday, April 14<\\/strong><\\/p>\\r\\n<p><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZQc5MAG\\\">Graduate Financial Aid and Admissions Q&amp;A<\\/a>, 12 pm<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZRGPMA4\\\">MS Direct Entry Occupational Therapy<\\/a>, 5 pm<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZRLFMA4\\\">Business Administration (MBA)\\/MS Accounting<\\/a>, 6 pm<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZS4QMAW\\\">MS Athletic Training\\/ MS Criminal Justice<\\/a>, 7 pm<\\/p>\\r\\n<p><strong>Tuesday, April 15<\\/strong><br \\/><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZXAXMA4\\\">Graduate International Information Session<\\/a>, 12 pm<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZXKDMA4\\\">MS Nursing\\/ MS Adult-Gerontology NP<\\/a>, 5 pm<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZRMrMAO\\\">MA English\\/History and MS Mathematics<\\/a>, 6 pm<\\/p>\\r\\n<p><strong>Wednesday, April 16<\\/strong><br \\/><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZQk9MAG\\\">Graduate Student Panel,<\\/a> 12 pm<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZXP3MAO\\\">MS Psychology Programs<\\/a>, 5 pm<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZRWXMA4\\\">McKeown School of Education<\\/a>, 6 pm<\\/p>\\r\\n<p><strong>Thursday, April 17<\\/strong><br \\/><a href=\\\"http:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZXFNMA4\\\">Informacion sobre finanzas y admisiones para estudios graduados<\\/a>, 12 pm<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZXSHMA4\\\">MS Geo-Information Science<\\/a>, 5 pm<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/nam10.safelinks.protection.outlook.com\\/?url=https%3A%2F%2Fsalemstate.my.salesforce-sites.com%2Fevents%2FtargetX_eventsb__events%23%2Fesr%3Feid%3Da0RRm000006WDptMAG&amp;data=05%7C02%7Cacollins%40salemstate.edu%7Ca09a43d914ea45ec3eab08dd52b864e5%7C70d32b73b45749d1950c4f78aeffc21b%7C0%7C0%7C638757674098596683%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=O%2FaInZYlKM9IMkJi8QQYv2n6RKw41VcUigIylVGu%2Bn0%3D&amp;reserved=0\\\">Master of Social Work (MSW)<\\/a>, 6 pm<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Graduate Admissions<br \\/><a href=\\\"mailto:gradadmissions@salemstate.edu\\\">gradadmissions@salemstate.edu<\\/a><br \\/><a href=\\\"https:\\/\\/www.salemstate.edu\\/graduate\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Virtual Graduate Open House\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"virtual-graduate-open-house\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-18 00:21:27\",\"post_modified_gmt\":\"2025-04-18 00:21:27\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/virtual-graduate-open-house\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":859,\"post_author\":\"1\",\"post_date\":\"2025-03-27 03:23:04\",\"post_date_gmt\":\"2025-03-27 03:23:04\",\"post_content\":\"<p>Inclusive Excellence invites you to mark your calendars and join us on Monday, April 14, 2025, from 11:15 am to 1 pm in ECC Veterans Hall for the Inaugural Inclusive Excellence Showcase and Recognition Luncheon.<\\/p>\\r\\n<p><strong>Doors will open for lunch at 11:15 am and the event will start promptly at 11:30 am.<\\/strong><\\/p>\\r\\n<p>This event is free and open to the Salem State University community and invited guests. Come celebrate our 24-25 academic year successes and connect with our community members over a delicious lunch!<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/forms.office.com\\/r\\/2uPp8b1YbP\\\"><strong>Inclusive Excellence Awards Nominations<\\/strong><\\/a><br \\/>As the hub for institutional transformation for equity here at Salem State University, Inclusive Excellence is excited to introduce this opportunity to elevate and celebrate members of our community for exemplary contributions toward inclusive excellence in best practices, research, leadership, or service.<\\/p>\\r\\n<p>Our goal is to encourage departments, faculty, staff, and students to implement comprehensive policies, practices, and initiatives designed to increase innovative, inclusive practices within our respective areas. We look forward to receiving many nominations of individuals and departments doing incredible work!<\\/p>\\r\\n<p>Award recipients will be recognized at the Inaugural Inclusive Excellence Showcase.<\\/p>\\r\\n<p><strong>Award categories for 2025 are as follows:<\\/strong><\\/p>\\r\\n<ul>\\r\\n<li>The Catalyst Award<\\/li>\\r\\n<li>Outstanding Service Award<\\/li>\\r\\n<li>Departmental Excellence Award<\\/li>\\r\\n<li>Outstanding Contribution to Education Award<\\/li>\\r\\n<\\/ul>\\r\\n<p><br \\/>The deadline to <a href=\\\"http:\\/\\/forms.office.com\\/r\\/2uPp8b1YbP\\\">submit a nomination<\\/a> is Sunday, March 30, 2025, at 11:59 pm.<\\/p>\\r\\n<p>Submission requirements for the Catalyst, Outstanding Service, and Departmental Excellence awards include a statement (250 words maximum) detailing why the nominee deserves recognition for the designated award, including the specific criteria associated with the award, as outlined in the award description.<\\/p>\\r\\n<p>Submissions for the Outstanding Contribute to Education Award will entail a statement (250 words maximum) on how the proposed contribution fits the award criteria and a completed copy of the deliverable attached. Supporting materials can be attached but are not required.<\\/p>\\r\\n<p><strong>Overview of Awards<\\/strong><br \\/><strong>The Catalyst Award<\\/strong> will be presented to a Salem State University undergraduate or graduate student for their exemplified commitment to inclusive excellence through exercising innovative and courageous leadership practices within their student organization, in a classroom, university program, and\\/or the development and implementation of campus programs and initiatives.<\\/p>\\r\\n<p><strong>The Outstanding Service Award<\\/strong> will be awarded to a Salem State University faculty, staff, or administrator, who, through a record of consistent service, has contributed substantially to advancing inclusive excellence at Salem State University.<\\/p>\\r\\n<p><strong>The Departmental Excellence Award<\\/strong> recognizes and honors a department, academic or administrative, that has demonstrated an outstanding commitment to championing diversity, equity, and inclusion. This award celebrates the collective commitment of the department to foster a more inclusive and equitable departmental community through transformative policies, best practices, and a profound contribution to the betterment of the departmental environment and the larger campus community.<\\/p>\\r\\n<p><strong>The Outstanding Contribution to Education Award<\\/strong> will recognize a faculty, staff member, or graduate student who has contributed substantially to furthering diversity and inclusion in higher education. Outstanding contributions to education may include research and creative inquiry, workshop development, campus diversity initiatives, curricular transformation, culturally affirming practices, capacity building, the influence of technology on diversity\\/equity, funding, and policies and inclusive practices.<\\/p>\\r\\n<p>The Inclusive Excellence team will review all nominations and select recipients after the submission deadline. Any Salem State community members can submit a nomination on their behalf or nominate a peer or colleague. Nominees will be notified by Friday, April 4.<\\/p>\\r\\n<p>Please address all questions or concerns to <a href=\\\"cpierre@salemstate.edu\\\">Carlie Pierre<\\/a>, Director of Education and Training.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Carlie Pierre<br \\/><a href=\\\"mailto:cpierre@salemstate.edu\\\">cpierre@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4852\\\">978.542.4852<\\/a><br \\/><a href=\\\"https:\\/\\/www.salemstate.edu\\/news\\/call-nominations-inaugural-inclusive-excellence-awards-mar-06-2025\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Inaugural Inclusive Excellence Showcase\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"inaugural-inclusive-excellence-showcase\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:51:09\",\"post_modified_gmt\":\"2025-04-17 04:51:09\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/inaugural-inclusive-excellence-showcase\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":861,\"post_author\":\"1\",\"post_date\":\"2025-03-27 03:26:36\",\"post_date_gmt\":\"2025-03-27 03:26:36\",\"post_content\":\"<p><strong>Undergraduate, graduate, and faculty history research showcase<\\/strong><\\/p>\\r\\n<p>History majors, graduate students, and faculty will showcase their current research in several sessions at the first annual History Research Showcase on April 14 from 1-4:30 pm on the first floor of the Sullivan Building and the MLK Room. We welcome back Professor Emeritus Dane Morrison for the keynote on \\\"The Revolution Comes to Essex County\\\" at 1 pm in the MLK room followed by concurrent sessions.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Michele Louro<br \\/><a href=\\\"mailto:mlouro@salemstate.edu\\\">mlouro@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2419\\\">978.542.2419<\\/a><br \\/><a href=\\\"https:\\/\\/www.salemstate.edu\\/academics\\/college-arts-and-sciences\\/history\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"History Research Showcase\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"history-research-showcase\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:51:16\",\"post_modified_gmt\":\"2025-04-17 04:51:16\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/history-research-showcase\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":863,\"post_author\":\"1\",\"post_date\":\"2025-03-27 03:38:22\",\"post_date_gmt\":\"2025-03-27 03:38:22\",\"post_content\":\"<p>Sudan is suffering famine for the fourth time\\u2014at least\\u2014in forty years. Darfur region is the location of genocide for the second time in twenty years. Why are these calamities unfolding yet again? Why has the world failed to prevent them? What might be done differently today? As we mark two years since the eruption of Sudan\\u2019s latest civil war, join us for a talk with Dr. Alex de Waal, a world-renowned expert on Sudan, who will speak about the region\\u2019s history, its people, and the origins of this new round of violence and mass starvation.<\\/p>\\r\\n<p>Alex de Waal is the executive director of the World Peace Foundation and Research Professor at the Fletcher School, Tufts University. He has worked on the Horn of Africa, and on famine, conflict, and related issues since the 1980s as a researcher and practitioner. He served as a senior advisor to the African Union on Sudan and South Sudan in various capacities. He is the author of numerous studies including, <em>Mass Starvation: The history and future of famine <\\/em>(Polity, 2018) and<em> Sudan\\u2019s Unfinished Democracy: The promise and betrayal of a people\\u2019s revolution <\\/em>(Hurst, 2022). His next book is <em>Negotiating the Sudans: The African Union High Level Panels 2009-2014<\\/em> (Cornell University Press, 2025).<\\/p>\\r\\n<p>This event is free and open to the public. It will take place in person and will also be livestreamed on zoom. Registration is required.<\\/p>\\r\\n<p>Please <a href=\\\"https:\\/\\/lp.constantcontactpages.com\\/ev\\/reg\\/3w9288n\\\">register<\\/a> here to attend this talk in person.<\\/p>\\r\\n<p>Please <a href=\\\"https:\\/\\/nam10.safelinks.protection.outlook.com\\/?url=https%3A%2F%2Fsalemstate.zoom.us%2Fwebinar%2Fregister%2FWN_l_fjMq0_SdSxPpA2gEBdrg%23%2Fregistration&amp;data=05%7C02%7Cctr_lblayer%40salemstate.edu%7Cde81f258c668420e730608dd3fb2f4f4%7C70d32b73b45749d1950c4f78aeffc21b%7C0%7C0%7C638736760016993703%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=ApADVJxgXW0%2BdsTteX93sZgt%2FDyucNtce1juS1rU%2BrQ%3D&amp;reserved=0\\\">register<\\/a> here to view this talk on zoom.<\\/p>\\r\\n<p>This talk is cosponsored by the Center for Civic Engagement, the Politics, Policy and International Relations Department at Salem State University.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Lynn T Blayer<br \\/><a href=\\\"mailto:ctr_lblayer@salemstate.edu\\\">ctr_lblayer@salemstate.edu<\\/a><br \\/><a href=\\\"https:\\/\\/lp.constantcontactpages.com\\/ev\\/reg\\/3w9288n\\\">Get tickets<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Genocide and Famine in Sudan: What\\u2019s New? What\\u2019s to be Done?\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"genocide-and-famine-in-sudan-whats-new-whats-to-be-done\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:51:22\",\"post_modified_gmt\":\"2025-04-17 04:51:22\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/genocide-and-famine-in-sudan-whats-new-whats-to-be-done\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":865,\"post_author\":\"1\",\"post_date\":\"2025-03-27 03:41:25\",\"post_date_gmt\":\"2025-03-27 03:41:25\",\"post_content\":\"<p><strong>Step into the future of concert going with professors Sanae Kanda and Mike Testa<\\/strong><\\/p>\\r\\n<p>Step into the future of music at a groundbreaking concert where tradition meets innovation! Experience an interesting fusion of traditional acoustic music and cutting-edge AI-driven images, how we interpret AI-driven notations, and more. This unique performance explores the possibilities of traditional music with the precision and creativity of artificial intelligence, creating an ever-evolving musical journey. Be a part of this one-of-a-kind event that pushes the boundaries of sound and visual images, offering a fresh twist on timeless acoustic music. Join us for a night where the past and future collide in perfect harmony!<\\/p>\\r\\n<p>Studio Electronica<\\/p>\\r\\n<p>Admission is free. Donations at the door are welcome to support scholarships for music majors.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Karen A Gahagan<br \\/><a href=\\\"mailto:kgahagan@salemstate.edu\\\">kgahagan@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.7890\\\">978.542.7890<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"post_title\":\"Proof of Concept: Studio E\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"proof-of-concept-studio-e\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:51:28\",\"post_modified_gmt\":\"2025-04-17 04:51:28\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/proof-of-concept-studio-e\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1462,\"post_author\":\"1\",\"post_date\":\"2025-04-11 04:00:06\",\"post_date_gmt\":\"2025-04-11 04:00:06\",\"post_content\":\"<p>INDUSTRY NIGHT OPEN MIC<br \\/>6:30pm Sign Ups Start<br \\/>7-9pm Open Mic<br \\/>First come, first serve, with PA provided. <br \\/>Drink, sing, and be merry with your host, Dylan!<\\/p>\\r\\n<p>Can\\u2019t make it this week? We\\u2019ll be ready for you next week!<br \\/>Open Mic will be every Monday!<\\/p>\",\"post_title\":\"Industry Music Open Mic Night\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"industry-music-open-mic-night\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:48:59\",\"post_modified_gmt\":\"2025-04-15 05:48:59\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/industry-music-open-mic-night\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1495,\"post_author\":\"10\",\"post_date\":\"2025-04-11 18:15:46\",\"post_date_gmt\":\"2025-04-11 18:15:46\",\"post_content\":\"<p>test<\\/p>\",\"post_title\":\"TestEvent\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"testevent\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 00:10:52\",\"post_modified_gmt\":\"2025-04-15 00:10:52\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/testevent\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1503,\"post_author\":\"1\",\"post_date\":\"2025-04-14 03:53:08\",\"post_date_gmt\":\"2025-04-14 03:53:08\",\"post_content\":\"<p>hello<\\/p>\",\"post_title\":\"Testforupdate\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"testforupdate\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-14 03:53:08\",\"post_modified_gmt\":\"2025-04-14 03:53:08\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/testforupdate\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1505,\"post_author\":\"1\",\"post_date\":\"2025-04-14 04:09:00\",\"post_date_gmt\":\"2025-04-14 04:09:00\",\"post_content\":\"<p>saddsfsdf<\\/p>\",\"post_title\":\"EBB\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"ebb\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-14 04:10:18\",\"post_modified_gmt\":\"2025-04-14 04:10:18\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/ebb\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1507,\"post_author\":\"1\",\"post_date\":\"2025-04-14 04:19:55\",\"post_date_gmt\":\"2025-04-14 04:19:55\",\"post_content\":\"<p>sfdsfserser<\\/p>\",\"post_title\":\"TestBeach\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"testbeach\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 00:10:52\",\"post_modified_gmt\":\"2025-04-15 00:10:52\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/testbeach\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1509,\"post_author\":\"1\",\"post_date\":\"2025-04-14 04:26:09\",\"post_date_gmt\":\"2025-04-14 04:26:09\",\"post_content\":\"<p>eweewwe<\\/p>\",\"post_title\":\"hieieie\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"hieieie\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 00:10:52\",\"post_modified_gmt\":\"2025-04-15 00:10:52\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/hieieie\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1511,\"post_author\":\"29\",\"post_date\":\"2025-04-14 04:38:19\",\"post_date_gmt\":\"2025-04-14 04:38:19\",\"post_content\":\"<p>test without making account first<\\/p>\",\"post_title\":\"Test wo singing in\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"test-wo-singing-in\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 00:10:52\",\"post_modified_gmt\":\"2025-04-15 00:10:52\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/test-wo-singing-in\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1532,\"post_author\":\"1\",\"post_date\":\"2025-04-14 23:47:45\",\"post_date_gmt\":\"2025-04-14 23:47:45\",\"post_content\":\"<p><em>This is a multiday event from Mar 31, 2025 - Apr 18, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>The \\\"Trash to Art\\\" initiative, a Collaborative Online International Learning (COIL) project between Salem State University in the United States and Tecnol\\u00f3gico de Monterrey in Mexico, exemplifies the transformative power of global shared learning. Guided by Professors Tereza Swanda and Francisco Gonz\\u00e1lez Romo de Vivar, this project engages students from diverse cultural backgrounds in repurposing discarded materials into meaningful artworks, promoting a profound understanding of environmental sustainability and cross-cultural collaboration. By aligning with the United Nations Sustainable Development Goals #12 (Sustainable Consumption and Production) and #13 (Climate Action), \\\"Trash to Art\\\" challenges participants to critically examine their consumption patterns and the environmental impact of human activities.<\\/p>\\r\\n<h1>Additional Exhibition Events on Thursday, April 10<\\/h1>\\r\\n<p>Artist Talk-12:30-1:30 pm<\\/p>\\r\\n<p>Reception-1:30-3 pm<\\/p>\\r\\n<p>The Winfisky Gallery is open from 10 am-4 pm, Monday through Friday.<\\/p>\\r\\n<h1>Bios<\\/h1>\\r\\n<p><strong>Dr. Francisco Gonz\\u00e1lez Romo de Vivar<\\/strong> is an Assistant Professor at Tecnol\\u00f3gico de Monterrey, Campus Hidalgo, specializing in Art History, Visual Culture, and Semiotics. He holds a PhD in Art History from Centro de Cultura Casa Lamm, where his dissertation focused on cinematic themes using Gilles Deleuze\\u2019s filmic philosophy. His research interests include transdisciplinary practices in cinema, minor cinemas, and the aesthetic implications of technological advancements.<\\/p>\\r\\n<p>In his academic work, Dr. Gonz\\u00e1lez integrates these themes into his teaching, focusing on fostering global collaboration through technology-driven educational projects, including Collaborative Online International Learning (COIL). His courses cover topics such as Film Analysis, Posthumanism, and Audiovisual Narrative, encouraging students to engage critically with both historical and contemporary media.<\\/p>\\r\\n<p>Dr. Gonz\\u00e1lez is committed to creating learning environments that enhance student engagement and develop critical thinking. His current research explores intersections of cinema, media studies, and technology, continuously seeking new ways to enrich the educational experience in a global context.<\\/p>\\r\\n<p><strong>Tereza Swanda\\u2019s<\\/strong> interdisciplinary work centers on integrating with the \\u2018other,\\u2019 a term she uses to refer to diverse cultures, perspectives, and experiences. She resides in CZ and the States, teaching Studio Art and Art History at Salem State University and Roxbury Community College. Swanda holds an MFA from Vermont College of Fine Arts and a BFA in Painting and Sculpture from Massachusetts College of Art and Design.<\\/p>\\r\\n<p>She is currently working on a collaborative online international learning project, Trash2Art, which connects US students across the border to learners in Mexico. During the pandemic, her community engagement project, Touchstone, was included in The Immigrant Artist Biennial\\/ Mother Tongue. The artist asked those affected by COVID-19 to email her photos of loved ones, which she painted on stone. Her curatorial project, Unredacted, brought ten artists together who acknowledged the political post-truth world as artists and activists. Swanda received the A.R.T. Fund award to pursue her project, Capital Cleanse, in a rogue installation at the Metropolitan Museum of Art. She has exhibited her work at the Whitney Center for the Arts (Pittsfield, MA), University of Oregon (Eugene, OR), Berliner Kunstprojekt (Berlin), 450 Broadway Gallery (NY), Bakalar and Paine Galleries (Boston, MA), Chemeketa Community College Art Gallery (Salem, OR), Center on Contemporary Art (Seattle, WA) online in Storyscape Journal and Waves joining over 20,000 women who have contributed over the years. She has been awarded residencies at VSC (Johnson, VT) and the Millay Colony (Austerlitz, NY). She has been attending workshops with Rose Shakinovsky and Claire Gavronsky in Italy and South Africa since 2000.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Trash Transformed: A Binational Perspective on Art and Sustainability\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"trash-transformed-a-binational-perspective-on-art-and-sustainability-15\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:49:52\",\"post_modified_gmt\":\"2025-04-15 05:49:52\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1532\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":867,\"post_author\":\"1\",\"post_date\":\"2025-03-27 03:43:29\",\"post_date_gmt\":\"2025-03-27 03:43:29\",\"post_content\":\"<p>Campus Life and Recreation\\/Gassett Fitness Center is partnering with your campus dietitian to offer nutritional advice! Stop by at the time most convenient for you between 3:30-5:30pm to learn about \\\"macros made easy\\\", try free samples, and spin the wheel for a prize! No need to pre-register.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Alejandro Rubero<br \\/><a href=\\\"mailto:arubero@salemstate.edu\\\">arubero@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.5181\\\">978.542.5181<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Ask a Dietitian\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"ask-a-dietitian\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:51:34\",\"post_modified_gmt\":\"2025-04-17 04:51:34\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/ask-a-dietitian\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":869,\"post_author\":\"1\",\"post_date\":\"2025-03-27 03:49:25\",\"post_date_gmt\":\"2025-03-27 03:49:25\",\"post_content\":\"<p><strong>Celebrating the Class of 2025 and their guests<\\/strong><\\/p>\\r\\n<p>Find out about commencement tickets, graduation portraits, and everything that graduates and guests need to know as the countdown to cap and gown nears! President Keenan, Academic Affairs, and Alumni Affairs invite you to a Zoom presentation about celebrating the Class of 2025! <a href=\\\"https:\\/\\/salemstate.zoom.us\\/meeting\\/register\\/W0tX7bBST3238IyndVyoNg\\\"><strong>Register<\\/strong> <\\/a>to attend on Tuesday, April 15 at 6 pm.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Bruce Perry<br \\/><a href=\\\"mailto:commencement@salemstate.edu\\\">commencement@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4723\\\">978.542.4723<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Commencement 101: Countdown to Cap and Gown!\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"commencement-101-countdown-to-cap-and-gown-2\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:51:39\",\"post_modified_gmt\":\"2025-04-17 04:51:39\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/commencement-101-countdown-to-cap-and-gown-2\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":872,\"post_author\":\"1\",\"post_date\":\"2025-03-27 03:56:27\",\"post_date_gmt\":\"2025-03-27 03:56:27\",\"post_content\":\"<p><strong>A Student Panel on Addressing Bias and Creating Welcoming Spaces<\\/strong><br \\/><br \\/>In these complicated times, effective communication is critical across our communities. Join us for an evening of cross-campus dialogue. We\\u2019ll begin with a panel of SSU students who will share their experiences on campus, what a \\u201cwelcoming environment\\u201d means to them, and their insights on best practices for effectively handling moments of campus bias and conflict.<\\/p>\\r\\n<p>Afterwards, faculty and staff will engage in small group discussions on the feedback and stories shared, and what it might mean for our work. Faculty and staff are encouraged to attend this interactive, student-centered event.<\\/p>\\r\\n<p><strong>Faculty and staff are encouraged to attend this interactive, student-centered event!<\\/strong><\\/p>\\r\\n<p>Coordinated by: Abigail Machson-Carter, Instructional Designer, Center for Teaching Innovation, and Carlie Pierre, Director of Education and Training, Inclusive Excellence<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Carlie Pierre<br \\/><a href=\\\"mailto:cpierre@salemstate.edu\\\">cpierre@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4852\\\">978.542.4852<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Amplifying Student Voices: Addressing Bias at SSU\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"amplifying-student-voices-addressing-bias-at-ssu\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:51:46\",\"post_modified_gmt\":\"2025-04-17 04:51:46\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/amplifying-student-voices-addressing-bias-at-ssu\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":874,\"post_author\":\"1\",\"post_date\":\"2025-03-27 04:00:03\",\"post_date_gmt\":\"2025-03-27 04:00:03\",\"post_content\":\"<p>Did you know that April is Financial Literacy month? To help students build their financial foundation, we are offering assistance filing the 2025-26 FAFSA! Come join the Student Navigation Center on April 15 for our in-person event where we\'ll have experts on hand to guide you through the process.<\\/p>\\r\\n<p>Whether you\'re a first-time applicant or just need a refresher, we\'re here to help! Don\'t miss out on this opportunity to get the financial aid you need for college.<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/www.eventbrite.com\\/e\\/fafsa-assistance-tickets-1291300948899?aff=oddtdtcreator\\\"><strong>Register today!<\\/strong><\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Student Navigation Center<br \\/><a href=\\\"mailto:navcenter@salemstate.edu\\\">navcenter@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.8000\\\">978.542.8000<\\/a><br \\/><a href=\\\"https:\\/\\/www.eventbrite.com\\/e\\/fafsa-assistance-tickets-1291300948899?aff=oddtdtcreator\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"FAFSA Assistance\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"fafsa-assistance\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:51:52\",\"post_modified_gmt\":\"2025-04-17 04:51:52\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/fafsa-assistance\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":876,\"post_author\":\"1\",\"post_date\":\"2025-03-27 04:02:16\",\"post_date_gmt\":\"2025-03-27 04:02:16\",\"post_content\":\"<p>The Viking Video Chat Series is a live webinar series for incoming students. It is a great way to hang out with currently enrolled Salem State upper-class students and ask any questions you may have about life at the University. Any and all questions are welcomed!<\\/p>\\r\\n<p><a href=\\\"http:\\/\\/salemstate.zoom.us\\/meeting\\/register\\/D4j3E5pKSBKrVG-RK23CBA\\\"><strong>Register!<\\/strong><\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>First Year Experience<br \\/><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Viking Video Chat\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"viking-video-chat\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:51:59\",\"post_modified_gmt\":\"2025-04-17 04:51:59\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/viking-video-chat\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1464,\"post_author\":\"1\",\"post_date\":\"2025-04-11 04:02:03\",\"post_date_gmt\":\"2025-04-11 04:02:03\",\"post_content\":\"<p>Join us for a 5 rounds of pub trivia. Winning team goes home with a gift card and bragging rights!<\\/p>\",\"post_title\":\"Trivia Night\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"trivia-night\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:52:21\",\"post_modified_gmt\":\"2025-04-17 04:52:21\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/trivia-night\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1515,\"post_author\":\"1\",\"post_date\":\"2025-04-14 05:09:54\",\"post_date_gmt\":\"2025-04-14 05:09:54\",\"post_content\":\"<p>ff<\\/p>\",\"post_title\":\"df\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"df\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-16 00:12:37\",\"post_modified_gmt\":\"2025-04-16 00:12:37\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/df\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1533,\"post_author\":\"1\",\"post_date\":\"2025-04-14 23:48:08\",\"post_date_gmt\":\"2025-04-14 23:48:08\",\"post_content\":\"<p><em>This is a multiday event from Mar 31, 2025 - Apr 18, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>The \\\"Trash to Art\\\" initiative, a Collaborative Online International Learning (COIL) project between Salem State University in the United States and Tecnol\\u00f3gico de Monterrey in Mexico, exemplifies the transformative power of global shared learning. Guided by Professors Tereza Swanda and Francisco Gonz\\u00e1lez Romo de Vivar, this project engages students from diverse cultural backgrounds in repurposing discarded materials into meaningful artworks, promoting a profound understanding of environmental sustainability and cross-cultural collaboration. By aligning with the United Nations Sustainable Development Goals #12 (Sustainable Consumption and Production) and #13 (Climate Action), \\\"Trash to Art\\\" challenges participants to critically examine their consumption patterns and the environmental impact of human activities.<\\/p>\\r\\n<h1>Additional Exhibition Events on Thursday, April 10<\\/h1>\\r\\n<p>Artist Talk-12:30-1:30 pm<\\/p>\\r\\n<p>Reception-1:30-3 pm<\\/p>\\r\\n<p>The Winfisky Gallery is open from 10 am-4 pm, Monday through Friday.<\\/p>\\r\\n<h1>Bios<\\/h1>\\r\\n<p><strong>Dr. Francisco Gonz\\u00e1lez Romo de Vivar<\\/strong> is an Assistant Professor at Tecnol\\u00f3gico de Monterrey, Campus Hidalgo, specializing in Art History, Visual Culture, and Semiotics. He holds a PhD in Art History from Centro de Cultura Casa Lamm, where his dissertation focused on cinematic themes using Gilles Deleuze\\u2019s filmic philosophy. His research interests include transdisciplinary practices in cinema, minor cinemas, and the aesthetic implications of technological advancements.<\\/p>\\r\\n<p>In his academic work, Dr. Gonz\\u00e1lez integrates these themes into his teaching, focusing on fostering global collaboration through technology-driven educational projects, including Collaborative Online International Learning (COIL). His courses cover topics such as Film Analysis, Posthumanism, and Audiovisual Narrative, encouraging students to engage critically with both historical and contemporary media.<\\/p>\\r\\n<p>Dr. Gonz\\u00e1lez is committed to creating learning environments that enhance student engagement and develop critical thinking. His current research explores intersections of cinema, media studies, and technology, continuously seeking new ways to enrich the educational experience in a global context.<\\/p>\\r\\n<p><strong>Tereza Swanda\\u2019s<\\/strong> interdisciplinary work centers on integrating with the \\u2018other,\\u2019 a term she uses to refer to diverse cultures, perspectives, and experiences. She resides in CZ and the States, teaching Studio Art and Art History at Salem State University and Roxbury Community College. Swanda holds an MFA from Vermont College of Fine Arts and a BFA in Painting and Sculpture from Massachusetts College of Art and Design.<\\/p>\\r\\n<p>She is currently working on a collaborative online international learning project, Trash2Art, which connects US students across the border to learners in Mexico. During the pandemic, her community engagement project, Touchstone, was included in The Immigrant Artist Biennial\\/ Mother Tongue. The artist asked those affected by COVID-19 to email her photos of loved ones, which she painted on stone. Her curatorial project, Unredacted, brought ten artists together who acknowledged the political post-truth world as artists and activists. Swanda received the A.R.T. Fund award to pursue her project, Capital Cleanse, in a rogue installation at the Metropolitan Museum of Art. She has exhibited her work at the Whitney Center for the Arts (Pittsfield, MA), University of Oregon (Eugene, OR), Berliner Kunstprojekt (Berlin), 450 Broadway Gallery (NY), Bakalar and Paine Galleries (Boston, MA), Chemeketa Community College Art Gallery (Salem, OR), Center on Contemporary Art (Seattle, WA) online in Storyscape Journal and Waves joining over 20,000 women who have contributed over the years. She has been awarded residencies at VSC (Johnson, VT) and the Millay Colony (Austerlitz, NY). She has been attending workshops with Rose Shakinovsky and Claire Gavronsky in Italy and South Africa since 2000.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Trash Transformed: A Binational Perspective on Art and Sustainability\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"trash-transformed-a-binational-perspective-on-art-and-sustainability-16\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:49:17\",\"post_modified_gmt\":\"2025-04-17 04:49:17\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1533\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1715,\"post_author\":\"1\",\"post_date\":\"2025-04-15 05:41:08\",\"post_date_gmt\":\"2025-04-15 05:41:08\",\"post_content\":\"<p><a href=\\\"http:\\/\\/www.thebabesalem.com\\/events\\\">The Babe<\\/a> proudly presents \'Jazz Night\' every Tuesday from 6-9pm w\\/ live music by Steve Lacey (guitar) &amp; Pat Dole (upright bass). Join us weekly as we showcase jazz artists from Boston and the North Shore. Instrumentalists are encouraged to come by and sit in. Come by for cocktails, delicious bar snacks and sandwiches made from scratch and a cozy atmosphere to connect with friends and neighbors!<\\/p>\",\"post_title\":\"Live Jazz @ The Babe w\\/ Steve Lacey and Pat Dole\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"live-jazz-the-babe-w-steve-lacey-and-pat-dole-3\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 05:41:21\",\"post_modified_gmt\":\"2025-04-15 05:41:21\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1715\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1724,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:11:23\",\"post_date_gmt\":\"2025-04-15 06:11:23\",\"post_content\":\"<p>Are you a student interested in building skills and enhancing strategies related to academic success? Do you need a little bit of guidance and support around a particular academic success topic? Attend a <em><strong>Student Success Series Workshop<\\/strong><\\/em> (via Zoom) happening all this week at a variety of times.<\\/p>\\r\\n<p><strong>M<\\/strong><strong>onday April 14:<\\/strong><\\/p>\\r\\n<p>11:30am-12 pm: Managing Stress and Anxiety<\\/p>\\r\\n<p>4-4:30 pm: Common Mistakes in Online Classes<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Tuesday April 15:<\\/strong><\\/p>\\r\\n<p>11:30am-12 pm: Writing Emails for Success<\\/p>\\r\\n<p>3-3:30 pm: Talking with Professors in Office Hours<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Wednesday April 16:<\\/strong><\\/p>\\r\\n<p>12:30-1 pm: Tips for Online Learning Success<\\/p>\\r\\n<p>3:30-4 pm: Tricks to Improve Your Memory<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Thursday April 17:<\\/strong><\\/p>\\r\\n<p>10-10:30 am: Secrets of Successful Students<\\/p>\\r\\n<p>2:30-3 pm: Staying Focused in an Online Class<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Friday April 18:<\\/strong><\\/p>\\r\\n<p>10:30-11 am: Online Tools for Success<\\/p>\\r\\n<p>2-2:30 pm: Goal Setting<\\/p>\\r\\n<p>Can\'t attend a specific session? There are a number of additional academic resources available for students to take advantage of on the main <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\\">Student Success Canvas<\\/a> page. The <strong>full series schedule <\\/strong>and <strong>Zoom access information<\\/strong> are available on the individual <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\/pages\\/student-success-workshops\\\">Student Success Series<\\/a> section of the Student Success Canvas page.<\\/p>\\r\\n<p><strong>Contact<\\/strong><\\/p>\\r\\n<p>First Year Experience<\\/p>\\r\\n<p><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><\\/p>\\r\\n<p><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><\\/p>\\r\\n<p>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Student Success Series Workshops:\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"student-success-series-workshops-11\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:12:28\",\"post_modified_gmt\":\"2025-04-15 06:12:28\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1724\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":878,\"post_author\":\"1\",\"post_date\":\"2025-03-27 04:18:55\",\"post_date_gmt\":\"2025-03-27 04:18:55\",\"post_content\":\"<p>Operation House Call (OHC) teaches students in medical, nursing, and allied health professional schools the essential skills and mindsets to enhance the health care of persons with autism and other intellectual and developmental disabilities (IDD). OHC turns to families, parents and individual self-advocates as educators in a health care field that seldom focuses on more than making a diagnosis.<\\/p>\\r\\n<p>Speaker:<\\/p>\\r\\n<ul>\\r\\n<li>Maura Sullivan, Chief Executive Officer, The Arc of Massachusetts, Director of Operation House Call<\\/li>\\r\\n<\\/ul>\\r\\n<p>This is an online event and <a href=\\\"https:\\/\\/salemstateuniversity.wufoo.com\\/forms\\/salem-state-chhs-interprofessional-events\\/\\\">registration<\\/a> is required.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Jeramie Silveira<br \\/><a href=\\\"mailto:jsilveira@salemstate.edu\\\">jsilveira@salemstate.edu<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Operation House Call\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"operation-house-call\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:52:06\",\"post_modified_gmt\":\"2025-04-17 04:52:06\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/operation-house-call\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":880,\"post_author\":\"1\",\"post_date\":\"2025-03-27 04:21:03\",\"post_date_gmt\":\"2025-03-27 04:21:03\",\"post_content\":\"<p>First-generation graduating seniors who have been approved for graduation (as part of the Class of 2025) are invited to the annual cording ceremony, to receive their honor cords.<\\/p>\\r\\n<p>Join university representatives to recognize your achievements as a first-generation college graduate.<\\/p>\\r\\n<p>First-generation students are defined as \\\"neither parent\\/guardian has received a bachelor\'s degree (four year college degree) in the United States\\\". Eligible students will receive an email invitation in early April.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Mathew R Chetnik<br \\/><a href=\\\"mailto:firstgen@salemstate.edu\\\">firstgen@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"First-Generation Graduating Senior Cording Ceremony\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"first-generation-graduating-senior-cording-ceremony\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:52:13\",\"post_modified_gmt\":\"2025-04-17 04:52:13\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/first-generation-graduating-senior-cording-ceremony\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1534,\"post_author\":\"1\",\"post_date\":\"2025-04-14 23:48:22\",\"post_date_gmt\":\"2025-04-14 23:48:22\",\"post_content\":\"<p><em>This is a multiday event from Mar 31, 2025 - Apr 18, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>The \\\"Trash to Art\\\" initiative, a Collaborative Online International Learning (COIL) project between Salem State University in the United States and Tecnol\\u00f3gico de Monterrey in Mexico, exemplifies the transformative power of global shared learning. Guided by Professors Tereza Swanda and Francisco Gonz\\u00e1lez Romo de Vivar, this project engages students from diverse cultural backgrounds in repurposing discarded materials into meaningful artworks, promoting a profound understanding of environmental sustainability and cross-cultural collaboration. By aligning with the United Nations Sustainable Development Goals #12 (Sustainable Consumption and Production) and #13 (Climate Action), \\\"Trash to Art\\\" challenges participants to critically examine their consumption patterns and the environmental impact of human activities.<\\/p>\\r\\n<h1>Additional Exhibition Events on Thursday, April 10<\\/h1>\\r\\n<p>Artist Talk-12:30-1:30 pm<\\/p>\\r\\n<p>Reception-1:30-3 pm<\\/p>\\r\\n<p>The Winfisky Gallery is open from 10 am-4 pm, Monday through Friday.<\\/p>\\r\\n<h1>Bios<\\/h1>\\r\\n<p><strong>Dr. Francisco Gonz\\u00e1lez Romo de Vivar<\\/strong> is an Assistant Professor at Tecnol\\u00f3gico de Monterrey, Campus Hidalgo, specializing in Art History, Visual Culture, and Semiotics. He holds a PhD in Art History from Centro de Cultura Casa Lamm, where his dissertation focused on cinematic themes using Gilles Deleuze\\u2019s filmic philosophy. His research interests include transdisciplinary practices in cinema, minor cinemas, and the aesthetic implications of technological advancements.<\\/p>\\r\\n<p>In his academic work, Dr. Gonz\\u00e1lez integrates these themes into his teaching, focusing on fostering global collaboration through technology-driven educational projects, including Collaborative Online International Learning (COIL). His courses cover topics such as Film Analysis, Posthumanism, and Audiovisual Narrative, encouraging students to engage critically with both historical and contemporary media.<\\/p>\\r\\n<p>Dr. Gonz\\u00e1lez is committed to creating learning environments that enhance student engagement and develop critical thinking. His current research explores intersections of cinema, media studies, and technology, continuously seeking new ways to enrich the educational experience in a global context.<\\/p>\\r\\n<p><strong>Tereza Swanda\\u2019s<\\/strong> interdisciplinary work centers on integrating with the \\u2018other,\\u2019 a term she uses to refer to diverse cultures, perspectives, and experiences. She resides in CZ and the States, teaching Studio Art and Art History at Salem State University and Roxbury Community College. Swanda holds an MFA from Vermont College of Fine Arts and a BFA in Painting and Sculpture from Massachusetts College of Art and Design.<\\/p>\\r\\n<p>She is currently working on a collaborative online international learning project, Trash2Art, which connects US students across the border to learners in Mexico. During the pandemic, her community engagement project, Touchstone, was included in The Immigrant Artist Biennial\\/ Mother Tongue. The artist asked those affected by COVID-19 to email her photos of loved ones, which she painted on stone. Her curatorial project, Unredacted, brought ten artists together who acknowledged the political post-truth world as artists and activists. Swanda received the A.R.T. Fund award to pursue her project, Capital Cleanse, in a rogue installation at the Metropolitan Museum of Art. She has exhibited her work at the Whitney Center for the Arts (Pittsfield, MA), University of Oregon (Eugene, OR), Berliner Kunstprojekt (Berlin), 450 Broadway Gallery (NY), Bakalar and Paine Galleries (Boston, MA), Chemeketa Community College Art Gallery (Salem, OR), Center on Contemporary Art (Seattle, WA) online in Storyscape Journal and Waves joining over 20,000 women who have contributed over the years. She has been awarded residencies at VSC (Johnson, VT) and the Millay Colony (Austerlitz, NY). She has been attending workshops with Rose Shakinovsky and Claire Gavronsky in Italy and South Africa since 2000.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Trash Transformed: A Binational Perspective on Art and Sustainability\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"trash-transformed-a-binational-perspective-on-art-and-sustainability-17\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:49:12\",\"post_modified_gmt\":\"2025-04-17 04:49:12\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1534\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1725,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:11:45\",\"post_date_gmt\":\"2025-04-15 06:11:45\",\"post_content\":\"<p>Are you a student interested in building skills and enhancing strategies related to academic success? Do you need a little bit of guidance and support around a particular academic success topic? Attend a <em><strong>Student Success Series Workshop<\\/strong><\\/em> (via Zoom) happening all this week at a variety of times.<\\/p>\\r\\n<p><strong>M<\\/strong><strong>onday April 14:<\\/strong><\\/p>\\r\\n<p>11:30am-12 pm: Managing Stress and Anxiety<\\/p>\\r\\n<p>4-4:30 pm: Common Mistakes in Online Classes<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Tuesday April 15:<\\/strong><\\/p>\\r\\n<p>11:30am-12 pm: Writing Emails for Success<\\/p>\\r\\n<p>3-3:30 pm: Talking with Professors in Office Hours<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Wednesday April 16:<\\/strong><\\/p>\\r\\n<p>12:30-1 pm: Tips for Online Learning Success<\\/p>\\r\\n<p>3:30-4 pm: Tricks to Improve Your Memory<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Thursday April 17:<\\/strong><\\/p>\\r\\n<p>10-10:30 am: Secrets of Successful Students<\\/p>\\r\\n<p>2:30-3 pm: Staying Focused in an Online Class<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Friday April 18:<\\/strong><\\/p>\\r\\n<p>10:30-11 am: Online Tools for Success<\\/p>\\r\\n<p>2-2:30 pm: Goal Setting<\\/p>\\r\\n<p>Can\'t attend a specific session? There are a number of additional academic resources available for students to take advantage of on the main <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\\">Student Success Canvas<\\/a> page. The <strong>full series schedule <\\/strong>and <strong>Zoom access information<\\/strong> are available on the individual <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\/pages\\/student-success-workshops\\\">Student Success Series<\\/a> section of the Student Success Canvas page.<\\/p>\\r\\n<p><strong>Contact<\\/strong><\\/p>\\r\\n<p>First Year Experience<\\/p>\\r\\n<p><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><\\/p>\\r\\n<p><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><\\/p>\\r\\n<p>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Student Success Series Workshops:\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"student-success-series-workshops-12\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:12:26\",\"post_modified_gmt\":\"2025-04-15 06:12:26\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1725\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1772,\"post_author\":\"1\",\"post_date\":\"2025-04-16 00:33:49\",\"post_date_gmt\":\"2025-04-16 00:33:49\",\"post_content\":\"<p>Two recreational baseball teams, the River Dogs and Adler\\u2019s Paint, have been meeting on their New England field on Sunday afternoons for longer than anyone can remember. These middle-aged sportsmen can\\u2019t run as fast as they used to or connect as reliably with a pitch, but their vigorous appetite for socializing, squabbling, and busting chops remains undiminished. After the know-nothing county board opts to raze the baseball diamond to make way for a school, the teams meet for one final game at their beloved Soldier\\u2019s Field, with girlfriends, kids, and local hooligans as intermittent spectators. As day turns to night and innings bleed together, the players face the uncertainty of a new era. Lovingly laid in a vanished Massachusetts of the mid-1990s, Carson Lund\\u2019s poignant feature debut plays like a lazy afternoon, perfectly attuned to the rhythms of America\\u2019s eternal pastime. Named for a rarely-deployed curveball, Eephus is both a ribald comedy for the baseball connoisseur and a movie for anyone who\\u2019s ever lamented their community slipping away.<\\/p>\\r\\n<p>Date: April 16, 2025 - April 17, 2025<br \\/>Duration: 99 Minutes<br \\/>Show Times: 7:00pm<br \\/><a href=\\\"https:\\/\\/thecabot.org\\/event\\/eephus\\/#book\\\">Buy Tickets<\\/a><\\/p>\",\"post_title\":\"Eephus\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"eephus\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:49:03\",\"post_modified_gmt\":\"2025-04-17 04:49:03\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/eephus\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1779,\"post_author\":\"1\",\"post_date\":\"2025-04-16 01:29:34\",\"post_date_gmt\":\"2025-04-16 01:29:34\",\"post_content\":\"<p>fhfhdjfddffdfdf<\\/p>\",\"post_title\":\"testylolll\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"testylolll\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-16 01:29:34\",\"post_modified_gmt\":\"2025-04-16 01:29:34\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/testylolll\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1787,\"post_author\":\"1\",\"post_date\":\"2025-04-16 04:21:33\",\"post_date_gmt\":\"2025-04-16 04:21:33\",\"post_content\":\"<p>This National Park Service exhibit will explore why Crown soldiers under Lt. Col. Alexander Leslie came to Salem on February 26, 1775, who were the major players in the event, and how this event has been remembered and celebrated in Salem in the last 250 years.<\\/p>\\r\\n<p>This <a href=\\\"http:\\/\\/www.nps.gov\\/SaMa\\\">free exhibit<\\/a> will be on display from February 15th -April 27th at the Salem Armory Visitor Center, 2 New Liberty Street, Salem.<\\/p>\\r\\n<p>The Salem Armory Visitor Center is open Wednesday \\u2013 Sunday, 10 am \\u2013 4 pm.<\\/p>\",\"post_title\":\"Leslies Retreat: Salem on the Brink of Revolution Exhibit\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"leslies-retreat-salem-on-the-brink-of-revolution-exhibit\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:49:24\",\"post_modified_gmt\":\"2025-04-17 04:49:24\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/leslies-retreat-salem-on-the-brink-of-revolution-exhibit\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":882,\"post_author\":\"1\",\"post_date\":\"2025-03-27 04:23:30\",\"post_date_gmt\":\"2025-03-27 04:23:30\",\"post_content\":\"<p><strong>For students who are in the undeclared major<\\/strong><\\/p>\\r\\n<p>Exploratory (undeclared) students - join peer leaders Nate and Elios to prepare to declare your major! Review some different majors and plan for the end of your semester so you finish strong.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Carolyn Tracy<br \\/><a href=\\\"mailto:ctracy@salemstate.edu\\\">ctracy@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4719\\\">978.542.4719<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Exploratory Major Review and Planning Time!\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"exploratory-major-review-and-planning-time\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-18 00:21:27\",\"post_modified_gmt\":\"2025-04-18 00:21:27\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/exploratory-major-review-and-planning-time\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":884,\"post_author\":\"1\",\"post_date\":\"2025-03-27 04:32:22\",\"post_date_gmt\":\"2025-03-27 04:32:22\",\"post_content\":\"<p><strong>Hosted by the International Student Association!<\\/strong><br \\/><br \\/>Culture Night has always been an important platform for our community to showcase multiculturalism and promote cross-cultural exchange. This year, ISA will present our rich and colorful cultural heritage through art, music, dance, food, etc. In 2025, we hope to continue this tradition and create an even more exciting, inclusive, and creative cultural feast.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Jier Qiu<br \\/><a href=\\\"mailto:j_qiu@salemstate.edu\\\">j_qiu@salemstate.edu<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"2025 Culture Night\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"2025-culture-night\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-18 00:21:27\",\"post_modified_gmt\":\"2025-04-18 00:21:27\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/2025-culture-night\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":886,\"post_author\":\"1\",\"post_date\":\"2025-03-27 04:34:58\",\"post_date_gmt\":\"2025-03-27 04:34:58\",\"post_content\":\"<p>Salem State University President John D. Keenan invites you and a guest to join him with host Kim D. Gassett-Schiller \'83, \'18H for a complimentary reception in San Francisco!<\\/p>\\r\\n<p>Join fellow alumni and friends for drinks, hors d\'oeuvres and camaraderie and hear an update about MEET THE MOMENT\\u00ae, the campaign for Salem State University.<\\/p>\\r\\n<p>For questions, please email: <a href=\\\"mailto:RSVP@salemstate.edu\\\">RSVP@salemstate.edu<\\/a>.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Engagement Events<br \\/><a href=\\\"mailto:RSVP@salemstate.edu\\\">RSVP@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2293\\\">978.542.2293<\\/a><br \\/><a href=\\\"https:\\/\\/participate.salemstate.edu\\/California\\\">Get tickets<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"San Francisco Alumni and Friends Reception\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"san-francisco-alumni-and-friends-reception\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-18 00:21:27\",\"post_modified_gmt\":\"2025-04-18 00:21:27\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/san-francisco-alumni-and-friends-reception\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1466,\"post_author\":\"1\",\"post_date\":\"2025-04-11 04:14:30\",\"post_date_gmt\":\"2025-04-11 04:14:30\",\"post_content\":\"<p>Join us for a night of bold flavors and laid-back vibes at <em>Ember &amp; Ale: Smoked Beer Night!<\\/em> \\ud83c\\udf7a\\ud83d\\udd25<\\/p>\\r\\n<p>Explore a curated selection of smoky, roasty, and robust craft beers that bring the heat in the best way. Whether you\'re a seasoned beer enthusiast or just curious about trying something new, this is your chance to sip, savor, and discover the rich world of smoked brews.<\\/p>\\r\\n<p>Expect good pours, good people, and that warm campfire kind of chill \\u2014 without needing to chop any wood.<\\/p>\\r\\n<p><strong>21+<\\/strong><\\/p>\",\"post_title\":\"Ember and Ale: Smoked Beer Night\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"ember-and-ale-smoked-beer-night-2\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-18 00:21:27\",\"post_modified_gmt\":\"2025-04-18 00:21:27\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1466\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1535,\"post_author\":\"1\",\"post_date\":\"2025-04-14 23:48:54\",\"post_date_gmt\":\"2025-04-14 23:48:54\",\"post_content\":\"<p><em>This is a multiday event from Mar 31, 2025 - Apr 18, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>The \\\"Trash to Art\\\" initiative, a Collaborative Online International Learning (COIL) project between Salem State University in the United States and Tecnol\\u00f3gico de Monterrey in Mexico, exemplifies the transformative power of global shared learning. Guided by Professors Tereza Swanda and Francisco Gonz\\u00e1lez Romo de Vivar, this project engages students from diverse cultural backgrounds in repurposing discarded materials into meaningful artworks, promoting a profound understanding of environmental sustainability and cross-cultural collaboration. By aligning with the United Nations Sustainable Development Goals #12 (Sustainable Consumption and Production) and #13 (Climate Action), \\\"Trash to Art\\\" challenges participants to critically examine their consumption patterns and the environmental impact of human activities.<\\/p>\\r\\n<h1>Additional Exhibition Events on Thursday, April 10<\\/h1>\\r\\n<p>Artist Talk-12:30-1:30 pm<\\/p>\\r\\n<p>Reception-1:30-3 pm<\\/p>\\r\\n<p>The Winfisky Gallery is open from 10 am-4 pm, Monday through Friday.<\\/p>\\r\\n<h1>Bios<\\/h1>\\r\\n<p><strong>Dr. Francisco Gonz\\u00e1lez Romo de Vivar<\\/strong> is an Assistant Professor at Tecnol\\u00f3gico de Monterrey, Campus Hidalgo, specializing in Art History, Visual Culture, and Semiotics. He holds a PhD in Art History from Centro de Cultura Casa Lamm, where his dissertation focused on cinematic themes using Gilles Deleuze\\u2019s filmic philosophy. His research interests include transdisciplinary practices in cinema, minor cinemas, and the aesthetic implications of technological advancements.<\\/p>\\r\\n<p>In his academic work, Dr. Gonz\\u00e1lez integrates these themes into his teaching, focusing on fostering global collaboration through technology-driven educational projects, including Collaborative Online International Learning (COIL). His courses cover topics such as Film Analysis, Posthumanism, and Audiovisual Narrative, encouraging students to engage critically with both historical and contemporary media.<\\/p>\\r\\n<p>Dr. Gonz\\u00e1lez is committed to creating learning environments that enhance student engagement and develop critical thinking. His current research explores intersections of cinema, media studies, and technology, continuously seeking new ways to enrich the educational experience in a global context.<\\/p>\\r\\n<p><strong>Tereza Swanda\\u2019s<\\/strong> interdisciplinary work centers on integrating with the \\u2018other,\\u2019 a term she uses to refer to diverse cultures, perspectives, and experiences. She resides in CZ and the States, teaching Studio Art and Art History at Salem State University and Roxbury Community College. Swanda holds an MFA from Vermont College of Fine Arts and a BFA in Painting and Sculpture from Massachusetts College of Art and Design.<\\/p>\\r\\n<p>She is currently working on a collaborative online international learning project, Trash2Art, which connects US students across the border to learners in Mexico. During the pandemic, her community engagement project, Touchstone, was included in The Immigrant Artist Biennial\\/ Mother Tongue. The artist asked those affected by COVID-19 to email her photos of loved ones, which she painted on stone. Her curatorial project, Unredacted, brought ten artists together who acknowledged the political post-truth world as artists and activists. Swanda received the A.R.T. Fund award to pursue her project, Capital Cleanse, in a rogue installation at the Metropolitan Museum of Art. She has exhibited her work at the Whitney Center for the Arts (Pittsfield, MA), University of Oregon (Eugene, OR), Berliner Kunstprojekt (Berlin), 450 Broadway Gallery (NY), Bakalar and Paine Galleries (Boston, MA), Chemeketa Community College Art Gallery (Salem, OR), Center on Contemporary Art (Seattle, WA) online in Storyscape Journal and Waves joining over 20,000 women who have contributed over the years. She has been awarded residencies at VSC (Johnson, VT) and the Millay Colony (Austerlitz, NY). She has been attending workshops with Rose Shakinovsky and Claire Gavronsky in Italy and South Africa since 2000.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Trash Transformed: A Binational Perspective on Art and Sustainability\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"trash-transformed-a-binational-perspective-on-art-and-sustainability-19\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-18 00:21:27\",\"post_modified_gmt\":\"2025-04-18 00:21:27\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1535\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1726,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:11:58\",\"post_date_gmt\":\"2025-04-15 06:11:58\",\"post_content\":\"<p>Are you a student interested in building skills and enhancing strategies related to academic success? Do you need a little bit of guidance and support around a particular academic success topic? Attend a <em><strong>Student Success Series Workshop<\\/strong><\\/em> (via Zoom) happening all this week at a variety of times.<\\/p>\\r\\n<p><strong>M<\\/strong><strong>onday April 14:<\\/strong><\\/p>\\r\\n<p>11:30am-12 pm: Managing Stress and Anxiety<\\/p>\\r\\n<p>4-4:30 pm: Common Mistakes in Online Classes<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Tuesday April 15:<\\/strong><\\/p>\\r\\n<p>11:30am-12 pm: Writing Emails for Success<\\/p>\\r\\n<p>3-3:30 pm: Talking with Professors in Office Hours<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Wednesday April 16:<\\/strong><\\/p>\\r\\n<p>12:30-1 pm: Tips for Online Learning Success<\\/p>\\r\\n<p>3:30-4 pm: Tricks to Improve Your Memory<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Thursday April 17:<\\/strong><\\/p>\\r\\n<p>10-10:30 am: Secrets of Successful Students<\\/p>\\r\\n<p>2:30-3 pm: Staying Focused in an Online Class<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Friday April 18:<\\/strong><\\/p>\\r\\n<p>10:30-11 am: Online Tools for Success<\\/p>\\r\\n<p>2-2:30 pm: Goal Setting<\\/p>\\r\\n<p>Can\'t attend a specific session? There are a number of additional academic resources available for students to take advantage of on the main <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\\">Student Success Canvas<\\/a> page. The <strong>full series schedule <\\/strong>and <strong>Zoom access information<\\/strong> are available on the individual <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\/pages\\/student-success-workshops\\\">Student Success Series<\\/a> section of the Student Success Canvas page.<\\/p>\\r\\n<p><strong>Contact<\\/strong><\\/p>\\r\\n<p>First Year Experience<\\/p>\\r\\n<p><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><\\/p>\\r\\n<p><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><\\/p>\\r\\n<p>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Student Success Series Workshops:\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"student-success-series-workshops-13\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:12:22\",\"post_modified_gmt\":\"2025-04-15 06:12:22\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1726\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1776,\"post_author\":\"1\",\"post_date\":\"2025-04-16 01:04:07\",\"post_date_gmt\":\"2025-04-16 01:04:07\",\"post_content\":\"<p>Two recreational baseball teams, the River Dogs and Adler\\u2019s Paint, have been meeting on their New England field on Sunday afternoons for longer than anyone can remember. These middle-aged sportsmen can\\u2019t run as fast as they used to or connect as reliably with a pitch, but their vigorous appetite for socializing, squabbling, and busting chops remains undiminished. After the know-nothing county board opts to raze the baseball diamond to make way for a school, the teams meet for one final game at their beloved Soldier\\u2019s Field, with girlfriends, kids, and local hooligans as intermittent spectators. As day turns to night and innings bleed together, the players face the uncertainty of a new era. Lovingly laid in a vanished Massachusetts of the mid-1990s, Carson Lund\\u2019s poignant feature debut plays like a lazy afternoon, perfectly attuned to the rhythms of America\\u2019s eternal pastime. Named for a rarely-deployed curveball, Eephus is both a ribald comedy for the baseball connoisseur and a movie for anyone who\\u2019s ever lamented their community slipping away.<\\/p>\\r\\n<p>Date: April 16, 2025 - April 17, 2025<br \\/>Duration: 99 Minutes<br \\/>Show Times: 7:00pm<br \\/><a href=\\\"https:\\/\\/thecabot.org\\/event\\/eephus\\/#book\\\">Buy Tickets<\\/a><\\/p>\",\"post_title\":\"Eephus\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"eephus-2\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-18 00:21:27\",\"post_modified_gmt\":\"2025-04-18 00:21:27\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/eephus-2\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1791,\"post_author\":\"1\",\"post_date\":\"2025-04-16 04:35:06\",\"post_date_gmt\":\"2025-04-16 04:35:06\",\"post_content\":\"<p>Craft Witch is a DIY crafting session with something for everyone! Choose from a wide array of options to create your very own one-of-a-kind craft. Whichever craft you decide to create, you\\u2019ll be provided with all the materials, tools, and knowledge needed to let your creativity flourish. Unlike our broom making, bookbinding, and spelljar making workshops in which participants are being guided through the crafting process step-by step by an instructor, the DIY nature of Craft Witch means that you can use the studio time however you wish. Check out the crafting options on our website!<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"post_title\":\"Craft Witch\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"craft-witch\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-18 00:21:27\",\"post_modified_gmt\":\"2025-04-18 00:21:27\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/craft-witch\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1793,\"post_author\":\"1\",\"post_date\":\"2025-04-17 03:15:40\",\"post_date_gmt\":\"2025-04-17 03:15:40\",\"post_content\":\"<p>Come<\\/p>\",\"post_title\":\"s\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"spread-the-love-comedy-show\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-18 00:21:27\",\"post_modified_gmt\":\"2025-04-18 00:21:27\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/spread-the-love-comedy-show\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":888,\"post_author\":\"1\",\"post_date\":\"2025-03-27 04:39:46\",\"post_date_gmt\":\"2025-03-27 04:39:46\",\"post_content\":\"<p><em><strong>This is a multiday event<\\/strong> from Apr 18, 2025 - Apr 26, 2025.<\\/em><\\/p>\\r\\n<p>Join the Center for Holocaust and Genocide Studies and the History Department for a study and travel course to Poland in April 2025. \\u201cHST991\\/EDG845: Teaching the Holocaust in Poland\\u201d is specifically designed for graduate students and current and future educators administrators interested in learning more deeply about the Holocaust in Poland. The course includes three evening seminars during the spring semester followed by group travel to Poland during MA school vacation from April 18-26, 2025.<\\/p>\\r\\n<p>With special attention to learning and teaching methods and strategies, we will visit:<\\/p>\\r\\n<ul>\\r\\n<li>Locally guided tour of Krakow, Poland with a visit to Jagiellonian University<\\/li>\\r\\n<li>Guided tour of the former Jewish Quarter, the Krakow Ghetto, the Memorial Site of the Plaszow Concentration Camp, and free time to visit Oscar Schindler\'s Factory (Krakow)<\\/li>\\r\\n<li>Specially designed educational tour of Auschwitz-Birkenau Concentration Camp and class meeting with the museum\\u2019s social media director<\\/li>\\r\\n<li>Tour of the former Kielce Ghetto and Kielce Pogrom Memorial Site<\\/li>\\r\\n<li>Visit to the Jewish Historical Institute with an educational tour of the Warsaw Ghetto and free time to visit the POLIN Museum of the History of Polish Jews<\\/li>\\r\\n<li>Visit to the Pawiak Prison Museum and the Warsaw Rising Museum<\\/li>\\r\\n<li>There will be free time in Krakow and Warsaw to develop your own itinerary and visit separate museums, sites, restaurants, and\\/or cultural events.<\\/li>\\r\\n<\\/ul>\\r\\n<p>Registered students are eligible for $500 scholarships to help cover the separate cost of 3 graduate credits at SSU. Students can register for HST 991 or EDG 845 depending on their program (MA, MAT, HGS Certificate, 4+1 program). 3 graduate credits can be converted to 67.5 PDPs for re-licensing of professional teachers.<\\/p>\\r\\n<p>For more information about the course and study and travel, please email Professor Christopher Mauriello at <a href=\\\"mailto:cmauriello@salemstate.edu\\\">cmauriello@salemstate.edu<\\/a>.<\\/p>\\r\\n<p>To register, please visit <a href=\\\"https:\\/\\/abroad.salemstate.edu\\/index.cfm?FuseAction=Programs.ViewProgramAngular&amp;id=30385\\\">Salem State Study Abroad<\\/a> or email Lauren Prema at <a href=\\\"mailto:lprema@salemstate.edu\\\">lprema@salemstate.edu<\\/a> for more information about the registration process.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Christopher Mauriello<br \\/><a href=\\\"mailto:cmauriello@salemstate.edu\\\">cmauriello@salemstate.edu<\\/a><br \\/><a href=\\\"https:\\/\\/abroad.salemstate.edu\\/index.cfm?FuseAction=Programs.ViewProgramAngular&amp;id=30385\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Study and Travel Course: Poland and the Holocaust\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"study-and-travel-course-poland-and-the-holocaust\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 04:39:46\",\"post_modified_gmt\":\"2025-03-27 04:39:46\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/study-and-travel-course-poland-and-the-holocaust\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":894,\"post_author\":\"1\",\"post_date\":\"2025-03-27 04:49:40\",\"post_date_gmt\":\"2025-03-27 04:49:40\",\"post_content\":\"<p><strong>Open Dialogue Hour for Faculty and Staff<\\/strong><\\/p>\\r\\n<p>In order to support open and direct dialogue between campus leadership, faculty and staff, our VP of Diversity and Inclusion, Christopher Macdonald-Dennis, is hosting weekly \\u201cHolding Space\\u201d sessions across campus.<\\/p>\\r\\n<p>These low-stakes, hour-long drop-in sessions are open to all faculty and staff who wish to stop by and engage in conversation with VP Macdonald-Dennis and other members of the President\\u2019s Executive Council (PEC) and campus leadership. To encourage meaningful connection, each session is scheduled in one of campus\\u2019s smaller conference rooms and open to in-person attendance only<span style=\\\"font-size: revert;color: initial\\\">.<\\/span><\\/p>\\r\\n<p>Additional Holding Space opportunities this semester:<\\/p>\\r\\n<p><strong>Thursday, April 24 | 3:30-4:30 pm<\\/strong> Meier Hall 316B - Charlotte Forten Legacy Room<\\/p>\\r\\n<p><strong>Monday, April 28 | 1:30-2:30 pm<\\/strong> Marsh Hall 204<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Contact<\\/strong><\\/p>\\r\\n<p>Jess Cook<\\/p>\\r\\n<p><a href=\\\"mailto:jcook2@salemstate.edu\\\">jcook2@salemstate.edu<\\/a><\\/p>\\r\\n<p><a href=\\\"tel:978.542.4954\\\">978.542.4954<\\/a><\\/p>\\r\\n<p>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Holding Space April 18 2025\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"holding-space-april-18-2025\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 22:34:03\",\"post_modified_gmt\":\"2025-03-27 22:34:03\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=894\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"}],\"found_posts\":228,\"max_num_pages\":5}','off');
