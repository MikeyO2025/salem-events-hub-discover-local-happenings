y_font_size\":{\"unit\":\"px\",\"size\":\"16\",\"sizes\":[]},\"description_typography_font_size_tablet\":{\"unit\":\"px\",\"size\":\"14\",\"sizes\":[]},\"description_typography_font_weight\":\"300\",\"description_typography_text_transform\":\"none\",\"description_typography_font_style\":\"normal\",\"description_typography_text_decoration\":\"none\",\"description_typography_line_height\":{\"unit\":\"em\",\"size\":\"1.5\",\"sizes\":[]},\"description_typography_letter_spacing\":{\"unit\":\"px\",\"size\":\"0\",\"sizes\":[]},\"description_typography_word_spacing\":{\"unit\":\"px\",\"size\":\"0\",\"sizes\":[]}},\"elements\":[],\"widgetType\":\"image-box\"}],\"isInner\":true}],\"isInner\":true}],\"isInner\":false},{\"id\":\"497106a\",\"elType\":\"container\",\"settings\":[],\"elements\":[{\"id\":\"bb255b0\",\"elType\":\"widget\",\"settings\":{\"html\":\"<style>\\r\\n    \\/* Container to keep the calendar centered and styled *\\/\\r\\n    .calendar-container {\\r\\n        max-width: 850px;\\r\\n        margin: 20px auto; \\/* Adds space from the top *\\/\\r\\n        background: white;\\r\\n        padding: 15px;\\r\\n        border-radius: 12px;\\r\\n        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);\\r\\n        transition: transform 0.3s ease, box-shadow 0.3s ease;\\r\\n    }\\r\\n\\r\\n    \\/* Hover effect for a slight lift *\\/\\r\\n    .calendar-container:hover {\\r\\n        transform: scale(1.02);\\r\\n        box-shadow: 0px 6px 15px rgba(0, 0, 0, 0.2);\\r\\n    }\\r\\n\\r\\n    \\/* Title style *\\/\\r\\n    .calendar-title {\\r\\n        font-size: 22px;\\r\\n        font-weight: bold;\\r\\n        color: #333;\\r\\n        text-align: center;\\r\\n        margin-bottom: 10px;\\r\\n    }\\r\\n\\r\\n    \\/* Calendar iframe styling *\\/\\r\\n    .calendar-frame {\\r\\n        width: 100%;\\r\\n        height: 600px;\\r\\n        border: none;\\r\\n        border-radius: 10px;\\r\\n        overflow: hidden;\\r\\n    }\\r\\n\\r\\n    \\/* Prevent layout shift or extra spacing issues *\\/\\r\\n    .wp-block-group, .wp-block-column {\\r\\n        overflow: hidden;\\r\\n    }\\r\\n\\r\\n    \\/* Responsive Fixes *\\/\\r\\n    @media (max-width: 768px) {\\r\\n        .calendar-container {\\r\\n            padding: 10px;\\r\\n        }\\r\\n        \\r\\n        .calendar-frame {\\r\\n            height: 500px;\\r\\n        }\\r\\n    }\\r\\n\\r\\n    @media (max-width: 480px) {\\r\\n        .calendar-frame {\\r\\n            height: 450px;\\r\\n        }\\r\\n    }\\r\\n<\\/style>\\r\\n\\r\\n<!-- Calendar Embed -->\\r\\n<div class=\\\"calendar-container\\\">\\r\\n    <div class=\\\"calendar-title\\\">\\ud83d\\udcc5 Upcoming Events<\\/div>\\r\\n    <iframe class=\\\"calendar-frame\\\" src=\\\"https:\\/\\/calendar.google.com\\/calendar\\/embed?src=024644856d6ce196b325d729d1a86f3b46e47080de04e38ddc0fe5ecb018f050%40group.calendar.google.com&ctz=America%2FNew_York\\\" frameborder=\\\"0\\\" scrolling=\\\"no\\\"><\\/iframe>\\r\\n<\\/div>\\r\\n\",\"_background_background\":\"gradient\",\"_background_color\":\"#FFFFFF\"},\"elements\":[],\"widgetType\":\"html\"}],\"isInner\":false},{\"id\":\"f3ca4dc\",\"elType\":\"container\",\"settings\":{\"background_background\":\"gradient\",\"background_color\":\"#DA8197\",\"background_color_b\":\"#FFFFFF\"},\"elements\":[{\"id\":\"d70d89c\",\"elType\":\"widget\",\"settings\":{\"address\":\" Where O\'Keefe Complex, O\'Keefe Campus 225 Canal Street, Salem, MA 01970 Multipurpose Gym\",\"height\":{\"unit\":\"px\",\"size\":334,\"sizes\":[]}},\"elements\":[],\"widgetType\":\"google_maps\"}],\"isInner\":false},{\"id\":\"3639a21\",\"elType\":\"container\",\"settings\":{\"boxed_width\":{\"unit\":\"px\",\"size\":861,\"sizes\":[]},\"flex_gap\":{\"size\":30,\"unit\":\"px\",\"column\":\"30\",\"row\":\"30\",\"isLinked\":true},\"min_height\":{\"unit\":\"px\",\"size\":760,\"sizes\":[]},\"min_height_tablet\":{\"unit\":\"px\",\"size\":421,\"sizes\":[]},\"min_height_mobile\":{\"unit\":\"px\",\"size\":327,\"sizes\":[