INSERT INTO `wp_options` VALUES (94740,'_site_transient_community-events-6af6a4654023239f0e2ffb0f8e779bcc','a:4:{s:9:\"sandboxed\";b:0;s:5:\"error\";N;s:8:\"location\";a:3:{s:11:\"description\";s:5:\"Salem\";s:8:\"latitude\";s:8:\"42.51977\";s:9:\"longitude\";s:9:\"-70.89552\";}s:6:\"events\";a:5:{i:0;a:10:{s:4:\"type\";s:6:\"meetup\";s:5:\"title\";s:23:\"Boston WordPress Meetup\";s:3:\"url\";s:63:\"https://www.meetup.com/boston-wordpress-meetup/events/306172070\";s:6:\"meetup\";s:16:\"Boston WordPress\";s:10:\"meetup_url\";s:47:\"https://www.meetup.com/boston-wordpress-meetup/\";s:4:\"date\";s:19:\"2025-04-28 18:30:00\";s:8:\"end_date\";s:19:\"2025-04-28 21:30:00\";s:20:\"start_unix_timestamp\";i:1745879400;s:18:\"end_unix_timestamp\";i:1745890200;s:8:\"location\";a:4:{s:8:\"location\";s:18:\"Cambridge, MA, USA\";s:7:\"country\";s:2:\"us\";s:8:\"latitude\";d:42.361426999999999;s:9:\"longitude\";d:-71.081209999999999;}}i:1;a:10:{s:4:\"type\";s:6:\"meetup\";s:5:\"title\";s:23:\"Boston WordPress Meetup\";s:3:\"url\";s:63:\"https://www.meetup.com/boston-wordpress-meetup/events/306172148\";s:6:\"meetup\";s:16:\"Boston WordPress\";s:10:\"meetup_url\";s:47:\"https://www.meetup.com/boston-wordpress-meetup/\";s:4:\"date\";s:19:\"2025-05-19 18:30:00\";s:8:\"end_date\";s:19:\"2025-05-19 21:30:00\";s:20:\"start_unix_timestamp\";i:1747693800;s:18:\"end_unix_timestamp\";i:1747704600;s:8:\"location\";a:4:{s:8:\"location\";s:18:\"Cambridge, MA, USA\";s:7:\"country\";s:2:\"us\";s:8:\"latitude\";d:42.361426999999999;s:9:\"longitude\";d:-71.081209999999999;}}i:2;a:10:{s:4:\"type\";s:6:\"meetup\";s:5:\"title\";s:26:\"Marlborough WordPress: May\";s:3:\"url\";s:68:\"https://www.meetup.com/marlborough-wordpress-meetup/events/307325645\";s:6:\"meetup\";s:28:\"Marlborough WordPress Meetup\";s:10:\"meetup_url\";s:52:\"https://www.meetup.com/marlborough-wordpress-meetup/\";s:4:\"date\";s:19:\"2025-05-20 18:00:00\";s:8:\"end_date\";s:19:\"2025-05-20 19:30:00\";s:20:\"start_unix_timestamp\";i: