\":\"16\",\"sizes\":[]},\"typography_font_size_tablet\":{\"unit\":\"px\",\"size\":\"14\",\"sizes\":[]},\"typography_font_weight\":\"400\",\"typography_text_transform\":\"capitalize\",\"typography_font_style\":\"normal\",\"typography_text_decoration\":\"none\",\"typography_line_height\":{\"unit\":\"em\",\"size\":\"1\",\"sizes\":[]},\"typography_letter_spacing\":{\"unit\":\"px\",\"size\":\"0\",\"sizes\":[]},\"background_color\":\"#467FF7\",\"hover_color\":\"#467FF7\",\"button_background_hover_color\":\"#02010100\",\"typography_word_spacing\":{\"unit\":\"em\",\"size\":0,\"sizes\":[]},\"text_padding_mobile\":{\"unit\":\"px\",\"top\":\"15\",\"right\":\"35\",\"bottom\":\"15\",\"left\":\"35\",\"isLinked\":false},\"align_mobile\":\"center\",\"link\":{\"url\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/\",\"is_external\":\"\",\"nofollow\":\"\",\"custom_attributes\":\"\"},\"align\":\"center\"},\"elements\":[],\"widgetType\":\"button\"}],\"isInner\":false}]');
