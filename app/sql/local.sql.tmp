INSERT INTO `wp_options` VALUES (96230,'_transient_timeout_em_ab7b9f80a0419c117fa64ecc51e169021744956471','1745103434','off');
INSERT INTO `wp_options` VALUES (96231,'_transient_em_ab7b9f80a0419c117fa64ecc51e169021744956471','{\"posts\":[{\"ID\":603,\"post_author\":\"1\",\"post_date\":\"2025-02-28 02:58:08\",\"post_date_gmt\":\"2025-02-28 02:58:08\",\"post_content\":\"<p>test event 1 for wp event manager<\\/p>\",\"post_title\":\"test event 1 wp event manager\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"test-event-1-wp-event-manager\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-08 03:30:49\",\"post_modified_gmt\":\"2025-04-08 03:30:49\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=603\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":664,\"post_author\":\"1\",\"post_date\":\"2025-03-10 05:27:54\",\"post_date_gmt\":\"2025-03-10 05:27:54\",\"post_content\":\"<p>Salem State returns to the Sunshine State! Please plan to join us for these wonderful events if you live or vacation in Florida.<\\/p>\\r\\n<p>Be sure to keep us updated with your seasonal and home address in Florida so you can receive future mailings and emails regarding these exciting events.<\\/p>\\r\\n<p>To update your address, visit salemstate.edu\\/alumni\\/update or call 978.542.7530.<\\/p>\\r\\n<p>We have an incredible slate of programs planned for this year, don\\u2019t delay, register today.<\\/p>\\r\\n<p>Alumni Relations<br \\/>alumni@salemstate.edu<br \\/>978.542.7530<br \\/>Get tickets<br \\/>For access and accommodation information, visit our page on access or email access@salemstate.edu.<\\/p>\",\"post_title\":\"Salem State Returns to the Sunshine State\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"salem-state-returns-to-the-sunshine-state\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 23:16:18\",\"post_modified_gmt\":\"2025-03-27 23:16:18\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/salem-state-returns-to-the-sunshine-state\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":702,\"post_author\":\"6\",\"post_date\":\"2025-03-15 04:24:00\",\"post_date_gmt\":\"2025-03-15 04:24:00\",\"post_content\":\"<p>free throw contest and more! lol<\\/p>\",\"post_title\":\"Ethans Basketball Fun Time\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"ethans-basketball-fun-time\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-02 04:11:32\",\"post_modified_gmt\":\"2025-04-02 04:11:32\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/ethans-basketball-fun-time\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":705,\"post_author\":\"1\",\"post_date\":\"2025-03-15 19:03:28\",\"post_date_gmt\":\"2025-03-15 19:03:28\",\"post_content\":\"<!-- wp:paragraph -->\\r\\n<p><em>This is a multiday event\\u00a0from Jan 15, 2025 - May 01, 2025.<\\/em><\\/p>\\r\\n<p>The Gassett Fitness Center offers weekly group exercise classes as a benefit of your membership which is covered by student fees for registered students and as a benefit of employment for university employees. Our nationally certified instructors are here to welcome you to class and to motivate, encourage, and challenge you \\u2013 helping you achieve much more than on your own. Spring classes run January 21 - May 1. No classes: 2\\/17, 3\\/17-3\\/20, 4\\/21.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Alejandro Rubero<br \\/><a href=\\\"mailto:arubero@salemstate.edu\\\">arubero@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.5181\\\">978.542.5181<\\/a><br \\/><a href=\\\"https:\\/\\/www.salemstate.edu\\/campus-life\\/campus-life-and-recreation\\/group-exercise\\\">More information<\\/a><\\/p>\\r\\n<p><br \\/>For access and accommodation information, visit our\\u00a0<a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a>\\u00a0or email\\u00a0<a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\r\\n<!-- \\/wp:paragraph -->\",\"post_title\":\"Group Exercise Classes Jan 15 - May 01\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"group-exercise-classes\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-10 05:27:52\",\"post_modified_gmt\":\"2025-04-10 05:27:52\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=705\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":711,\"post_author\":\"1\",\"post_date\":\"2025-03-15 19:49:49\",\"post_date_gmt\":\"2025-03-15 19:49:49\",\"post_content\":\"<p><em>This is a multiday event from Jan 27, 2025 - Apr 24, 2025.<\\/em><\\/p>\\r\\n<p>Discover the Art of Traditional Karate: Join our class to learn self-defense techniques, enhance self-discipline, and build unshakable self-confidence. This traditional art form will not only strengthen your body but also nourish your mind and soul. Don\\u2019t miss this incredible opportunity for personal growth and empowerment.<\\/p>\\r\\n<p><strong>Contact<\\/strong><\\/p>\\r\\n<p>Alejandro Rubero<br \\/><a href=\\\"mailto:arubero@salemstate.edu\\\">arubero@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.5181\\\">978.542.5181<\\/a><br \\/><a href=\\\"https:\\/\\/gassettfitnesscenter.salemstate.edu\\/program\\/GetProgramDetails?courseId=e9b613cc-2ec4-4eb5-8d8e-f3b7f73422d5\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a><\\/p>\",\"post_title\":\"Karate with the Dean Jan 27 - Apr 24\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"karate-with-the-dean\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-31 04:11:48\",\"post_modified_gmt\":\"2025-03-31 04:11:48\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/karate-with-the-dean\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":713,\"post_author\":\"1\",\"post_date\":\"2025-03-18 03:27:39\",\"post_date_gmt\":\"2025-03-18 03:27:39\",\"post_content\":\"<p><em>This is a multiday event from Feb 28, 2025 - Mar 27, 2025.<\\/em><\\/p>\\r\\n<p>Both TIAA and the State Board of Retirement are offering a variety of webinars for active employees this month. Take a peak and be sure to register now! <a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">Retirement Seminars - Polaris.<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Joanna Nandi<br \\/><a href=\\\"mailto:jnandi@salemstate.edu\\\">jnandi@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.6030\\\">978.542.6030<\\/a><br \\/><a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"post_title\":\"March Retirement Webinars\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"march-retirement-webinars\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:29:21\",\"post_modified_gmt\":\"2025-04-15 06:29:21\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/march-retirement-webinars\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":715,\"post_author\":\"1\",\"post_date\":\"2025-03-18 03:45:18\",\"post_date_gmt\":\"2025-03-18 03:45:18\",\"post_content\":\"<p><em>This is a multiday event from Mar 01, 2025 - Mar 31, 2025.<\\/em><\\/p>\\r\\n<p><strong>Women and Well-being<\\/strong><\\/p>\\r\\n<p>March is International Women\'s Month as well as Nutrition Month!<\\/p>\\r\\n<p>Check out these on-demand videos on Bright Breaks focusing on women\'s well-being:<\\/p>\\r\\n<p>\\u00a0<a href=\\\"https:\\/\\/brightbreaks.com\\/on-demand\\/974\\\">Women\'s Health<\\/a>\\u00a0- 7 mins<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/brightbreaks.com\\/on-demand\\/1693\\\">Nutrition Tips for Menopause<\\/a>\\u00a0- 7 mins<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/brightbreaks.com\\/on-demand\\/978\\\">Gratitude for Women in History<\\/a>\\u00a0 - 7 mins<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/brightbreaks.com\\/on-demand\\/979\\\">Self Care for Black Business Women<\\/a>\\u00a0- 7 mins<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/brightbreaks.com\\/on-demand\\/977\\\">Rising in the Workplace<\\/a>\\u00a0- 30 mins<\\/p>\\r\\n<p>Did you know you can now filter the on-demand library by length? There\'s videos as short as 1 minute!\\u00a0<a href=\\\"http:\\/\\/brightbreaks.com\\/on-demand\\\">Check out the library with over 1,000 videos<\\/a>.<\\/p>\\r\\n<p>You can also access live and\\u00a0<strong>on-demand<\\/strong>\\u00a0Bright Breaks on the go with their mobile app!<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/apps.apple.com\\/us\\/app\\/bright-breaks\\/id1526308584\\\">iOS\\u00a0<\\/a>|\\u00a0<a href=\\\"https:\\/\\/play.google.com\\/store\\/apps\\/details?id=co.choosebright.client\\\">Android\\u00a0<\\/a><\\/p>\\r\\n<p>You can win a gift card prize every week just for taking live or on-demand breaks!\\u00a0<a href=\\\"http:\\/\\/brightbreaks.com\\/challenges\\\">Get started.\\u00a0<\\/a><\\/p>\\r\\n<p><strong>Moving is great for our digestion!<\\/strong><\\/p>\\r\\n<p>March is\\u00a0<a href=\\\"https:\\/\\/brightbreaks.com\\/search-breaks?q=category%3A%22Eat%20Well%22\\\">Nutrition\\u00a0<\\/a>Month! Did you know that there\'s more to healthy digestion than the food we eat? Stretching, light movement and breathing exercises has been\\u00a0<a href=\\\"https:\\/\\/www.medicalnewstoday.com\\/articles\\/exercises-to-help-digestion#breathing-exercises\\\">linked<\\/a>\\u00a0with improved gut biome.\\u00a0<\\/p>\\r\\n<p>There\'s live 7-minute breaks coming up to help us use our bodies to enhance our digestion:\\u00a0<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/brightbreaks.com\\/search-breaks?q=title%3ANourish%20Your%20Nervous%20System\\\">Nourish Your Nervous System<\\/a>\\u00a0-\\u00a0Monday-Friday, various times, breathe category<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/brightbreaks.com\\/search-breaks?q=title%3AGut%20Stretches\\\">Happy Gut Stretches<\\/a>\\u00a0- Wednesdays at\\u00a06:05 pm ET \\/ 3:05 pm PT, stretch category<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/brightbreaks.com\\/search-breaks?q=title%3AMetabolism%20Boost\\\">Metabolism Boost<\\/a>\\u00a0- Monday,\\u00a0Wednesday, Thursday and Friday at\\u00a09:05 am ET \\/ 6:05 am PT, move category<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/brightbreaks.com\\/search-breaks?q=march\\\">See more special March content<\\/a>\\u00a0and check out all\\u00a0<a href=\\\"http:\\/\\/brightbreaks.com\\/book\\\">250 live breaks<\\/a>\\u00a0a week and over\\u00a0<a href=\\\"http:\\/\\/brightbreaks.com\\/on-demand\\\">1000 on-demand videos<\\/a>\\u00a0on Bright Breaks to take time for your well-being!\\u00a0<\\/p>\\r\\n<p>Each live and on-demand break, up to 3 breaks a day, is an entry to win a digital gift card!\\u00a0<a href=\\\"http:\\/\\/brightbreaks.com\\/challenges\\\">Learn more.<\\/a><\\/p>\\r\\n<p><strong>Food choices are forever!<\\/strong><\\/p>\\r\\n<p>When it comes to nourishing our body, the decisions we make around what foods to eat seem small but they are important in the long run and never stop coming!<\\/p>\\r\\n<p>Learning new things about food helps us make informed choices around food.\\u00a0<\\/p>\\r\\n<p>As Nutrition Month continues, here are 7-minute Eat Well breaks coming up to help with choosing what to eat!<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/choosebrightapp.page.link\\/4dwaLHcwbMwrg5D16\\\">Foods to Eat Before Exercise<\\/a>\\u00a0- Wednesday, March 19, 11:05 am ET \\/ 8:05 am PT<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/choosebrightapp.page.link\\/npUatHUPoVsNftwf8\\\">Foods to Eat After Exercise<\\/a>\\u00a0- Wednesday, March 19, 3:05 pm ET \\/ 12:05 pm\\u00a0<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/choosebrightapp.page.link\\/xVjtXBTPHV5N5Q2C6\\\">Nutrition on a Budget<\\/a>\\u00a0- Friday, March 21, 9:35 am ET \\/ 6:35 am PT<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/brightbreaks.com\\/search-breaks?q=category%3A%22Eat%20Well%22\\\">Check out more live and on-demand breaks all about eating habits and nutrition.\\u00a0<\\/a><\\/p>\\r\\n<p><strong>Have a sweet tooth?\\u00a0<\\/strong><\\/p>\\r\\n<p>Eating what\'s best for us doesn\'t have to mean breaking up with all sweet treats, but it\'s important for us to have all the facts when we\'re making choices around treats.\\u00a0<\\/p>\\r\\n<p>Here\'s breaks on Bright Breaks to those of us with a sweet tooth:<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/choosebrightapp.page.link\\/XqbkeCYwyCBuUvCm6\\\">Nutrient-Dense Sweets<\\/a>\\u00a0- Wednesday, March 26,11:05 am ET \\/ 8:05 am PT<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/brightbreaks.com\\/on-demand\\/154\\\">Air Fryer Desserts<\\/a>\\u00a0- On-demand<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/brightbreaks.com\\/on-demand\\/153\\\">All About Sugar<\\/a>\\u00a0- On-demand<\\/p>\\r\\n<p><strong>More Help with Nutrition Habits<\\/strong><\\/p>\\r\\n<p>There are\\u00a0<a href=\\\"https:\\/\\/brightbreaks.com\\/search-breaks?q=category%3A%22Eat%20Well%22\\\">plenty of live and on-demand breaks led by Bright Breaks\' dietitian Grace<\\/a>\\u00a0happening year-round.\\u00a0<\\/p>\\r\\n<p>Lasting positive impacts on our health depend on our daily habits. Check out these 7-minute on-demand breaks to enhance your day-to-day nutrition:\\u00a0<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/brightbreaks.com\\/on-demand\\/584\\\">Tips for Drinking More Water<\\/a><\\/p>\\r\\n<p><a href=\\\"https:\\/\\/brightbreaks.com\\/on-demand\\/642\\\">Food Prep Hacks<\\/a><\\/p>\\r\\n<p><a href=\\\"https:\\/\\/brightbreaks.com\\/on-demand\\/597\\\">High Fiber Snacks For Your Workday<\\/a><\\/p>\\r\\n<p><strong>Want to join in on a live nutrition break?<\\/strong>\\u00a0<a href=\\\"https:\\/\\/brightbreaks.com\\/search-breaks?q=category%3A%22Eat%20Well%22\\\">Check out all of the upcoming Eat Well live breaks.<\\/a><\\/p>\\r\\n<p>Contact us on how to get started and for more information!<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Alejandro Rubero<br \\/><a href=\\\"mailto:arubero@salemstate.edu\\\">arubero@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.5181\\\">978.542.5181<\\/a><br \\/><a href=\\\"https:\\/\\/brightbreaks.com\\/salemstate\\/\\\">More information<\\/a><br \\/>For access and accommodation information, visit our\\u00a0<a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a>\\u00a0or email\\u00a0<a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Bright Breaks March is Nutrition Month\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"bright-breaks-march-is-nutrition-month\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-31 04:17:09\",\"post_modified_gmt\":\"2025-03-31 04:17:09\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/bright-breaks-march-is-nutrition-month\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":729,\"post_author\":\"1\",\"post_date\":\"2025-03-20 04:33:30\",\"post_date_gmt\":\"2025-03-20 04:33:30\",\"post_content\":\"<p><em>This is a multiday event from Mar 13, 2025 - Apr 07, 2025.<\\/em><\\/p>\\r\\n<p>Is there someone who had an impact on you this year? Is there an individual who has been supportive and encouraging during your first year? Is there someone, you feel, has positively contributed to your first-year experience?<\\/p>\\r\\n<p>If you answered YES to any of those questions, nominate them for the Outstanding First Year Advocate Award! The Outstanding First Year Advocate Award recognizes faculty (professors), staff (administrators who work in offices), and student leaders (resident assistant, orientation leader, first year mentor, peer advisor, tutor, peer leader, upper-class student mentor, etc.) who positively impacted the academic and\\/or personal lives of first year students.<\\/p>\\r\\n<p>First-year students (or anyone else who has seen amazing individuals) are encouraged to nominate someone they feel has made a significant contribution to the first year experience for students at Salem State for this special honor. It only takes a couple minutes to submit your nomination form!<\\/p>\\r\\n<p>Celebrate those individuals who have made an impact by nominating them for the Outstanding First Year Advocate Award.<\\/p>\\r\\n<p><strong><a href=\\\"https:\\/\\/www.surveymonkey.com\\/r\\/FYAdvocate2025\\\">Nominate someone. <\\/a><\\/strong><br \\/>The deadline to submit your nomination(s) is Monday, April 7. If you have any questions, please email <a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Mathew R Chetnik<br \\/><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/><a href=\\\"https:\\/\\/www.surveymonkey.com\\/r\\/FYAdvocate2025\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a><\\/p>\",\"post_title\":\"Nominate someone for the Outstanding First Year Advocate Award\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"nominate-someone-for-the-outstanding-first-year-advocate-award\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:23:04\",\"post_modified_gmt\":\"2025-04-11 05:23:04\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/nominate-someone-for-the-outstanding-first-year-advocate-award\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":731,\"post_author\":\"1\",\"post_date\":\"2025-03-21 03:31:42\",\"post_date_gmt\":\"2025-03-21 03:31:42\",\"post_content\":\"<p>Vice President for Finance and Facilities Karen House invites faculty\\/staff to visit with her during open office hours. Meetings held via Zoom or MS Teams and available on a first-come, first-serve basis. Please contact Becky Fiore at <a href=\\\"mailto:bfiore@salemstate.edu\\\">bfiore@salemstate.edu<\\/a> to schedule a confidential meeting.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Becky A Fiore<br \\/><a href=\\\"mailto:bfiore@salemstate.edu\\\">bfiore@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4881\\\">978.542.4881<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Vice President House Virtual Open Office Hours\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"vice-president-house-virtual-open-office-hours\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-21 03:31:42\",\"post_modified_gmt\":\"2025-03-21 03:31:42\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/vice-president-house-virtual-open-office-hours\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":733,\"post_author\":\"1\",\"post_date\":\"2025-03-21 03:36:29\",\"post_date_gmt\":\"2025-03-21 03:36:29\",\"post_content\":\"<p>Are you first in your family to go to college (first-generation)? Come learn how you can stay on track between now and summer orientation with a range of tips and strategies to make your college journey easier. This presentation is geared towards first-generation students but the information is helpful for all.<\\/p>\\r\\n<p><a href=\\\"http:\\/\\/salemstate.zoom.us\\/meeting\\/register\\/dJzEM4wKRTKmXr7UBn9Swg\\\">Register<\\/a>.<\\/p>\\r\\n<p>Registration will close 24 hours before the start of the session.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>First Year Experience<br \\/><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"First to Know: First Generation\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"first-to-know-first-generation\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-21 03:36:29\",\"post_modified_gmt\":\"2025-03-21 03:36:29\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/first-to-know-first-generation\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":735,\"post_author\":\"1\",\"post_date\":\"2025-03-21 03:53:59\",\"post_date_gmt\":\"2025-03-21 03:53:59\",\"post_content\":\"<p><strong>Salem State University New York City Alumni and Friends Reception<\\/strong><\\/p>\\r\\n<p>On behalf of the Salem State University Alumni Association and Foundation, Inc., you are cordially invited to a Salem State celebration, as we make our way to New York City!<\\/p>\\r\\n<p>Earlier in the day, current students in the Bertolon School of Business and other members of the campus community will be taking a tour of the financial district and are excited to close our day with this complimentary reception.<\\/p>\\r\\n<p>Join us at The Penny Farthing for heavy hors d\\u2019oeuvres and open bar, and network.<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/nycalumni.eventbrite.com\\/\\\">Register today!<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Alumni Relations<br \\/><a href=\\\"mailto:alumni@salemstate.edu\\\">alumni@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.7530\\\">978.542.7530<\\/a><br \\/><a href=\\\"https:\\/\\/nycalumni.eventbrite.com\\/\\\">Get tickets<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Salem State University New York City Alumni and Friends Reception\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"salem-state-university-new-york-city-alumni-and-friends-reception\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-21 03:53:59\",\"post_modified_gmt\":\"2025-03-21 03:53:59\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/salem-state-university-new-york-city-alumni-and-friends-reception\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":737,\"post_author\":\"1\",\"post_date\":\"2025-03-21 04:04:05\",\"post_date_gmt\":\"2025-03-21 04:04:05\",\"post_content\":\"<p>Dodgeball is back on the intramural calendar! This is a 6v6 co-ed league. Don\'t forget the five Ds: dodge, duck, dip, dive and dodge!<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Sean Conners<br \\/><a href=\\\"mailto:sconners@salemstate.edu\\\">sconners@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4965\\\">978.542.4965<\\/a><br \\/><a href=\\\"https:\\/\\/www.imleagues.com\\/spa\\/league\\/6098ca53c7a14a8ab61ff859fe60838e\\/home#leaguename\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Intramural Dodgeball Registration Ends\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"intramural-dodgeball-registration-ends\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:54:31\",\"post_modified_gmt\":\"2025-04-07 02:54:31\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/intramural-dodgeball-registration-ends\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":739,\"post_author\":\"1\",\"post_date\":\"2025-03-21 04:11:00\",\"post_date_gmt\":\"2025-03-21 04:11:00\",\"post_content\":\"<em>This is a multiday event from Mar 24, 2025 - Mar 28, 2025.<\\/em>\\n\\nAre you a student interested in building skills and enhancing strategies related to academic success? Do you need a little bit of guidance and support around a particular academic success topic? Attend a <em><strong>Student Success Series Workshop<\\/strong><\\/em> (via Zoom) happening all this week at a variety of times.\\n\\n<strong>Monday March 24:<\\/strong>\\n\\n11-11:30 am: Mid-Semester Re-Motivation\\n\\n2:30-3 pm: Developing an Effective Online Class Presentation\\n\\n<strong>Tuesday March 25:<\\/strong>\\n\\n12-12:30 pm: Tricks to Improve Your Memory\\n\\n3-3:30 pm: Managing Stress and Anxiety\\n\\n<strong>Wednesday March 26:<\\/strong>\\n\\n12:30-1 pm: Common Mistakes in Online Classes\\n\\n4-4:30 pm: Study Skills\\n\\n<strong>Thursday March 27:<\\/strong>\\n\\n11:30am-12 pm: Making a Plan for the Rest of the Semester\\n\\n3:30-4 pm: Mid-Semester Re-Motivation\\n\\n<strong>Friday March 28:<\\/strong>\\n\\n9:30-10 am: Staying Focused in an Online Class\\n\\n3:30-4 pm: Effective College Reading Strategies\\n\\nCan\'t attend a specific session? There are a number of additional academic resources available for students to take advantage of on the main <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\\">Student Success Canvas<\\/a> page.\\n\\n<strong>The full series schedule<\\/strong> and <strong>Zoom access information<\\/strong> are available on the individual Student Success Series section of the Student Success Canvas page.\\n\\n<strong>Contact<\\/strong>\\nFirst Year Experience\\n<a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a>\\n<a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a>\\nFor access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.\",\"post_title\":\"Student Success Series Workshops:\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"student-success-series-workshops\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:08:37\",\"post_modified_gmt\":\"2025-04-15 06:08:37\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/student-success-series-workshops\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":748,\"post_author\":\"1\",\"post_date\":\"2025-03-22 03:13:15\",\"post_date_gmt\":\"2025-03-22 03:13:15\",\"post_content\":\"<p>Join Campus Life and Recreation, Salem State MAICEI, SOAR and Embark programs as we come together for a Unified Recreation basketball game and food truck! This game will take place in the recreation courts at the Gassett Fitness Center.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Sean Conners<br \\/><a href=\\\"mailto:sconners@salemstate.edu\\\">sconners@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4965\\\">978.542.4965<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Unified Recreation Basketball\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"unified-recreation-basketball\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:54:12\",\"post_modified_gmt\":\"2025-04-07 02:54:12\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/unified-recreation-basketball\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":750,\"post_author\":\"1\",\"post_date\":\"2025-03-22 03:23:15\",\"post_date_gmt\":\"2025-03-22 03:23:15\",\"post_content\":\"<p>Looking for a place to connect, practice Spanish, and build community?<\\/p>\\r\\n<p>Faculty, staff, and students of all proficiency levels are invited to join us for <strong>Caf\\u00e9 y Tertulia<\\/strong>, a twice-monthly gathering for anyone seeking to improve their Spanish or help others learn the language.<\\/p>\\r\\n<p>Together, we\\u2019ll practice, share ideas, and learn from one another in a fun and supportive environment. Come relax after class or work\\u2014we\\u2019ll provide discussion topics, coffee and treats. \\u00a1V\\u00e1monos!<\\/p>\\r\\n<p>Every other Monday during spring semester:<\\/p>\\r\\n<p>February 10<br \\/>February 24 <br \\/>March 10<br \\/>March 24<br \\/>April 7<br \\/>April 28<br \\/>May 12<\\/p>\\r\\n<p>When: 5:30 pm - 6:30 pm<br \\/><br \\/>This recurring event is sponsored by HSI-MSI Initiatives, part of Inclusive Excellence.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Jess Cook<br \\/><a href=\\\"mailto:jcook2@salemstate.edu\\\">jcook2@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4954\\\">978.542.4954<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Caf\\u00e9 y Tertulia | Coffee and Spanish Conversation February 10\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"cafe-y-tertulia-coffee-and-spanish-conversation\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-31 03:59:15\",\"post_modified_gmt\":\"2025-03-31 03:59:15\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/cafe-y-tertulia-coffee-and-spanish-conversation\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":752,\"post_author\":\"1\",\"post_date\":\"2025-03-22 03:33:08\",\"post_date_gmt\":\"2025-03-22 03:33:08\",\"post_content\":\"<p>Discover practical, compassionate strategies for providing exceptional care to patients with disabilities. From disability etiquette and sensory needs, to building rapport with families and optimizing appointments, this session offers essential tools to create more inclusive and effective patient experiences.<\\/p>\\r\\n<p>Speakers:<\\/p>\\r\\n<p><strong>Dr. Amy Moy<\\/strong>, Senior Director of Community Health Initiatives and Associate Professor of Clinical Optometry<br \\/><strong>Dr. Jem Martin<\\/strong>, Assistant Professor of Specialty and Advanced Care, Low Vision Rehabilitation Optometrist, New England College of Optometry<br \\/>This is an online event with <a href=\\\"https:\\/\\/salemstateuniversity.wufoo.com\\/forms\\/salem-state-chhs-interprofessional-events\\/\\\">registration<\\/a> required.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Jeramie Silveira<br \\/><a href=\\\"mailto:jsilveira@salemstate.edu\\\">jsilveira@salemstate.edu<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Strategies for Compassionate Care for Patients with Disabilities\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"strategies-for-compassionate-care-for-patients-with-disabilities\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:54:07\",\"post_modified_gmt\":\"2025-04-07 02:54:07\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/strategies-for-compassionate-care-for-patients-with-disabilities\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":754,\"post_author\":\"1\",\"post_date\":\"2025-03-22 03:44:08\",\"post_date_gmt\":\"2025-03-22 03:44:08\",\"post_content\":\"<p><strong>Featured Guest Speaker Lauren Jones MA Secretary of Labor and Workforce Development<\\/strong><\\/p>\\r\\n<p>When: Tuesday, March 25, 11:00 am - 11:45 pm | Marsh Hall, Petrowski Room<\\/p>\\r\\n<p>Lauren Jones, Massachusetts Secretary of Labor and Workforce Development will be coming to campus to speak to students. Secretary Jones will be interviewed by Bertolon School of Business Dean, Raminder Luther and will be sharing information about growth industries, employment and career opportunities for graduates.<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/www.eventbrite.com\\/e\\/bertolon-school-of-business-speaker-series-tickets-1253101844349\\\">Reserve a spot.<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Don White<br \\/><a href=\\\"mailto:dwhite@salemstate.edu\\\">dwhite@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.6634\\\">978.542.6634<\\/a><br \\/><a href=\\\"https:\\/\\/www.eventbrite.com\\/e\\/bertolon-school-of-business-speaker-series-tickets-1253101844349\\\">More information<\\/a><br \\/><a href=\\\"https:\\/\\/www.eventbrite.com\\/e\\/bertolon-school-of-business-speaker-series-tickets-1253101844349\\\">Get tickets<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Bertolon School of Business Spring Speaker Series\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"bertolon-school-of-business-spring-speaker-series\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:54:00\",\"post_modified_gmt\":\"2025-04-07 02:54:00\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/bertolon-school-of-business-spring-speaker-series\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":756,\"post_author\":\"1\",\"post_date\":\"2025-03-22 03:53:41\",\"post_date_gmt\":\"2025-03-22 03:53:41\",\"post_content\":\"<p><em>In person at the Starbucks Cafe and simulcast live on Zoom<\\/em><\\/p>\\r\\n<p>Markus Haala is an interdisciplinary artist whose practice combines diverse artistic processes to examine the complex - and often difficult - relationship between humans and the natural world. Explored through the prism of materiality and drawing from a broad spectrum of (art) historical, philosophical, and eco-political references, Haala explores the complexities of how we define nature, questioning what is perceived as organic and synthetic. His work, anchored in sculptural objects and multimedia elements, investigates conventional views and reflects how belief systems and aesthetic decisions influence our perception of nature, ultimately authorizing us to reshape the world through augmented technologies.<\\/p>\\r\\n<p>Recently, Haala\'s fascination with advanced technologies has led him to investigate rapid prototyping methods, such as 3D scanning and printing, to create objects that expand on the concepts of both sculpture and printmaking.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Brian Alves<br \\/><a href=\\\"mailto:balves@salemstate.edu\\\">balves@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2788\\\">978.542.2788<\\/a><br \\/><a href=\\\"https:\\/\\/salemstate.zoom.us\\/webinar\\/register\\/WN_aYwgzDZUTB2YrLOxdGslMg?fbclid=IwY2xjawI_9oBleHRuA2FlbQIxMAABHTgGUu_Uqv-lE2NqOaxd--6i3ObON7KaQOsGV2bgRBFanKIbQjANxu53Rw_aem_vz3JLm6OBvL3J_qWiPaUoQ#\\/registration\\\">Get tickets<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Art + Design Live: A conversation with Markus Haala, multidisciplinary artist\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"art-design-live-a-conversation-with-markus-haala-multidisciplinary-artist\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:53:53\",\"post_modified_gmt\":\"2025-04-07 02:53:53\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/art-design-live-a-conversation-with-markus-haala-multidisciplinary-artist\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":758,\"post_author\":\"1\",\"post_date\":\"2025-03-22 04:01:57\",\"post_date_gmt\":\"2025-03-22 04:01:57\",\"post_content\":\"<p><em>Tuesday, March 25, 2025, in Meier Hall 238<\\/em><br \\/><em>When: 3:30 pm - 4:30 pm<\\/em><br \\/><br \\/>It is undeniable that the media we consume and how we consume it has an impact on our mental and emotional wellbeing. But why? Join SSU\\u2019s own <strong>MC Campbell, LICSW<\\/strong>, a therapist with over a decade of media organizing and advocacy experience, to learn how the basic structures of our media ecosystem \\u2013 from ownership structure to profit motive to manipulative design and algorithmic content delivery \\u2013 contribute to mental health issues for young people, and what we can do about it.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Katelyn Adams<br \\/><a href=\\\"mailto:kadams2@salemstate.edu\\\">kadams2@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.452.2545\\\">978.452.2545<\\/a><br \\/><a href=\\\"https:\\/\\/www.salemstate.edu\\/civicengagement\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"CRITICAL MEDIA LITERACY FOR MENTAL HEALTH\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"critical-media-literacy-for-mental-health\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:53:44\",\"post_modified_gmt\":\"2025-04-07 02:53:44\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/critical-media-literacy-for-mental-health\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":760,\"post_author\":\"1\",\"post_date\":\"2025-03-22 04:08:08\",\"post_date_gmt\":\"2025-03-22 04:08:08\",\"post_content\":\"<p>Students will engage in a conversation with a representative from MIRA (Massachusetts Immigrant &amp; Refugee Advocacy Coalition) to discuss current legislative priorities that aim to serve and protect our local immigrant communities, highlighting the connection between advocacy that starts within our communities and change within higher places of power. Pizza, snacks, and beverages will be provided.<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/www.surveymonkey.com\\/r\\/JMVWKFP\\\">Registration<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Katelyn Adams<br \\/><a href=\\\"mailto:kadams2@salemstate.edu\\\">kadams2@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.452.2545\\\">978.452.2545<\\/a><br \\/><a href=\\\"https:\\/\\/www.salemstate.edu\\/civicengagement\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"From the Streets to the Statehouse: Immigration Advocacy\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"from-the-streets-to-the-statehouse-immigration-advocacy\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:53:37\",\"post_modified_gmt\":\"2025-04-07 02:53:37\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/from-the-streets-to-the-statehouse-immigration-advocacy\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":762,\"post_author\":\"1\",\"post_date\":\"2025-03-22 04:17:13\",\"post_date_gmt\":\"2025-03-22 04:17:13\",\"post_content\":\"<p><em>Far from the Tree @108 Jackson Street Salem, MA 01970 5:30 pm - 8:30 pm<\\/em><\\/p>\\r\\n<p>Join your colleagues at Far from the Tree tasting room for a fun evening of ciders and candle-making. Participants will receive step-by-step instruction to blend and pour their own signature soy candle. Candles will take at least an hour to cure so all are invited to enjoy cider, games, and food while you wait. Please contact Kelly Janos with any questions you may have.<\\/p>\\r\\n<p>This program is sponsored by Wellness U and made possible through the generous philanthropy of Kim Gassett-Schiller \\u201983, \\u201818H and Philip Schiller.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Kelly Janos<br \\/><a href=\\\"mailto:kjanos@salemstate.edu\\\">kjanos@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4445\\\">978.542.4445<\\/a><br \\/><a href=\\\"https:\\/\\/fs26.formsite.com\\/FE7P0H\\/7ixzeiqo4d\\/index\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Candle Pouring - Wellness U\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"candle-pouring-wellness-u\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:53:31\",\"post_modified_gmt\":\"2025-04-07 02:53:31\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/candle-pouring-wellness-u\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":764,\"post_author\":\"1\",\"post_date\":\"2025-03-22 04:21:41\",\"post_date_gmt\":\"2025-03-22 04:21:41\",\"post_content\":\"<strong>Hosted by the Black Student Union!<\\/strong>\\n\\nCelebrate Women\\u2019s History Month with <em>Her Story in Color<\\/em>, a creative and relaxing paint night honoring the beauty, strength, and resilience of women! This guided experience features pre-drawn silhouettes of women and floral designs, allowing you to bring them to life with your own unique colors and creativity.\\n\\nNo painting experience needed\\u2014just bring your creativity and appreciation for the incredible women who shape history every day. Supplies and light refreshments will be provided. Come connect, create, and celebrate her story\\u2014in color!\\n\\nSupplies limited!\\n\\n<strong>Contact<\\/strong>\\nTimara James\\n<a href=\\\"mailto:S0392658@salemstate.edu\\\">S0392658@salemstate.edu<\\/a>\\nFor access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.\",\"post_title\":\"Her Story In Color Paint Night\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"her-story-in-color-paint-night\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:53:24\",\"post_modified_gmt\":\"2025-04-07 02:53:24\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/her-story-in-color-paint-night\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":766,\"post_author\":\"1\",\"post_date\":\"2025-03-22 04:34:10\",\"post_date_gmt\":\"2025-03-22 04:34:10\",\"post_content\":\"<p><strong><em>**This session is open to both residential and commuter students\\u2019 families\\/supporters.<\\/em><\\/strong><\\/p>\\r\\n<p>Find out how and when current students select rooms to live on campus for next Fall. Residence Life staff will describe the process and key steps involved. <a href=\\\"https:\\/\\/salemstate.zoom.us\\/meeting\\/register\\/vWJDhXeqQF2yvPBA-8z71A\\\">Register<\\/a> to attend via Zoom. <em>**This session is open to both residential and commuter students\\u2019 families\\/supporters.<\\/em><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Bruce Perry<br \\/><a href=\\\"mailto:family@salemstate.edu\\\">family@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2823\\\">978.542.2823<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Living on Campus: 25-26 Returning Student Housing Selection\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"living-on-campus-25-26-returning-student-housing-selection\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 23:17:14\",\"post_modified_gmt\":\"2025-03-27 23:17:14\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/living-on-campus-25-26-returning-student-housing-selection\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":769,\"post_author\":\"1\",\"post_date\":\"2025-03-22 04:43:41\",\"post_date_gmt\":\"2025-03-22 04:43:41\",\"post_content\":\"<p><em><strong>Various volunteer shifts available, 8 am-1:45 pm<\\/strong><\\/em><\\/p>\\r\\n<p>We will be going to Girls Inc. of Lynn to volunteer at their Smart Girls Summit! Students can volunteer in 1-3 shifts, which you can select when you <a href=\\\"https:\\/\\/www.surveymonkey.com\\/r\\/GrlsIncSGS\\\">RSVP<\\/a>. We will be meeting outside Dunkin\' in Meier Hall prior to departure at 7:50 am (please arrive promptly), and making periodic trips back to the university to bring students back and forth. We will arrive back to campus at 1:50 pm after the last shift. Any further questions or concerns can be directed to Caroline Scott via e-mail at <a href=\\\"mailto:stu_cscott@salemstate.edu\\\">stu_cscott@salemstate.edu<\\/a>.<\\/p>\\r\\n<p><strong>Location:<\\/strong> Meet outside of Dunkin\' to catch shuttle to Girls Inc.<\\/p>\\r\\n<p><strong>Partners:<\\/strong> Intersectional Feminist Collective<\\/p>\\r\\n<p><a href=\\\"http:\\/\\/www.surveymonkey.com\\/r\\/GrlsIncSGS\\\">RSVP to this event<\\/a>.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Katelyn Adams<br \\/><a href=\\\"mailto:kadams2@salemstate.edu\\\">kadams2@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.452.2545\\\">978.452.2545<\\/a><br \\/><a href=\\\"https:\\/\\/www.salemstate.edu\\/civicengagement\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"SMART Girls Summit Volunteer Opportunity\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"smart-girls-summit-volunteer-opportunity\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:53:20\",\"post_modified_gmt\":\"2025-04-07 02:53:20\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/smart-girls-summit-volunteer-opportunity\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":771,\"post_author\":\"1\",\"post_date\":\"2025-03-22 04:49:08\",\"post_date_gmt\":\"2025-03-22 04:49:08\",\"post_content\":\"<p><strong>Introduction to Odissi Classical Indian Dance<\\/strong><br \\/>Where: O\'Keefe Complex, O\'Keefe Campus 225 Canal Street, Salem, MA 01970 Dance Studio 303<br \\/>When: 3:05 pm - 4:20 pm<br \\/><br \\/><strong>Priya Bangal<\\/strong> is a dancer of Odissi, a classical dance from the Eastern Indian state of Odisha. She has performed Odissi at various venues across Massachusetts such as the Boston Center for the Arts, Jose Mateo Ballet Theater, Provincetown Dance Festival, Somerville Theater, Arts at the Armory and the Dance Complex. Her recent work at NACHMO Boston 2022 was described by the Dance Informa magazine as having \\u201can easeful quality\\u201d and \\u201cbeautiful intricacy.\\u201d In 2018, Priya was awarded the Traditional Arts Apprenticeship by the Massachusetts Cultural Council, to study Odissi under Master Artist Shipra Mehrotra under whom she continues to train on a regular basis. In January 2023, Priya received support from the Public Art Learning Fund at NEFA for an intensive study of Odissi Dance in Odisha, India. In addition to performance, Priya also conducts introductory Odissi classes, workshops and lecture-demonstrations to share her love for Odissi with a wide audience. With an aim to encourage a holistic cultural environment for Indian arts in Boston, Priya has co-founded Samv?d and Rasik, two organizations that work to nurture our region\'s growing interest in Indian arts by building informed audiences and trellising relationships between artists of Indian art forms and the larger arts community.<\\/p>\\r\\n<p>All are welcome!<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Karen A Gahagan<br \\/><a href=\\\"mailto:kgahagan@salemstate.edu\\\">kgahagan@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.7890\\\">978.542.7890<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Priya Bangal\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"priya-bangal\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:53:15\",\"post_modified_gmt\":\"2025-04-07 02:53:15\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/priya-bangal\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":777,\"post_author\":\"1\",\"post_date\":\"2025-03-26 01:04:53\",\"post_date_gmt\":\"2025-03-26 01:04:53\",\"post_content\":\"<p>Where: Marsh Hall, Central Campus 71B Loring Avenue, Salem, MA 01970<br \\/>When: 5:30 pm - 8:00 pm<\\/p>\\r\\n<p><br \\/>Please join us Wednesday, March 26, from 5:30-8:00 pm for an evening of food, networking, and learning from local advocates invested in advocating for awareness about substance use and mental health. Leaders will share with us information about their organization, provide insight on resources and legislation about mental health and substance use, and share their current advocacy efforts. They will also provide feedback on how students can be effective advocates for this important social issue.<\\/p>\\r\\n<p><strong>Location<\\/strong>: Marsh Hall 210 (Petrowski Room)<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/www.surveymonkey.com\\/r\\/MarMHSA\\\">RSVP to this event.<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Katelyn Adams<br \\/><a href=\\\"mailto:kadams2@salemstate.edu\\\">kadams2@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.452.2545\\\">978.452.2545<\\/a><br \\/><a href=\\\"https:\\/\\/www.salemstate.edu\\/civicengagement\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Mental Health and Substance Use Civic Dinner\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"mental-health-and-substance-use-civic-dinner\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-26 01:04:53\",\"post_modified_gmt\":\"2025-03-26 01:04:53\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/mental-health-and-substance-use-civic-dinner\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":779,\"post_author\":\"1\",\"post_date\":\"2025-03-26 01:10:08\",\"post_date_gmt\":\"2025-03-26 01:10:08\",\"post_content\":\"<p>Join us for a causal fireside chat with faculty from all over campus on Thursday, March 27, 12:30-1:30 pm in Forten 123! This session\'s topic is Finishing off Strong. Cookies and hot cocoa will be provided at each session and this event is <strong>open to all students!<\\/strong><\\/p>\\r\\n<p>Sponsored by the <a href=\\\"https:\\/\\/ask.salemstate.edu\\/kb\\/how-do-discover-my-interests-exploratory-undeclared-student\\\">exploratory program<\\/a>.<\\/p>\\r\\n<p>Questions can be emailed to <a href=\\\"mailto:exploratory@salemstate.edu\\\">exploratory@salemstate.edu<\\/a>.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Carolyn Tracy<br \\/><a href=\\\"mailto:ctracy@salemstate.edu\\\">ctracy@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4719\\\">978.542.4719<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Exploratory Fireside Chats: Finishing off Strong\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"exploratory-fireside-chats-finishing-off-strong\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:53:09\",\"post_modified_gmt\":\"2025-04-07 02:53:09\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/exploratory-fireside-chats-finishing-off-strong\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":781,\"post_author\":\"1\",\"post_date\":\"2025-03-26 01:17:21\",\"post_date_gmt\":\"2025-03-26 01:17:21\",\"post_content\":\"<p><strong>Open Dialogue Hour for Faculty and Staff<\\/strong><\\/p>\\r\\n<p>In order to support open and direct dialogue between campus leadership, faculty and staff, our VP of Diversity and Inclusion, Christopher Macdonald-Dennis, is hosting weekly \\u201cHolding Space\\u201d sessions across campus.<\\/p>\\r\\n<p>These low-stakes, hour-long drop-in sessions are open to all faculty and staff who wish to stop by and engage in conversation with VP Macdonald-Dennis and other members of the President\\u2019s Executive Council (PEC) and campus leadership. To encourage meaningful connection, each session is scheduled in one of campus\\u2019s smaller conference rooms and open to in-person attendance only.<\\/p>\\r\\n<p>Additional Holding Space opportunities this semester:<\\/p>\\r\\n<p><strong>Wednesday, April 2 | 9-10 am<\\/strong><\\/p>\\r\\n<p>Meier Hall 316B - Charlotte Forten Room<\\/p>\\r\\n<p><strong>Tuesday, April 8 | 10:30-11:30 am<\\/strong><\\/p>\\r\\n<p>Marsh Hall 204<\\/p>\\r\\n<p><strong>Friday, April 18 | 11 am-12 pm<\\/strong><\\/p>\\r\\n<p>Harrington Building 104<\\/p>\\r\\n<p><strong>Thursday, April 24 | 3:30-4:30 pm<\\/strong><\\/p>\\r\\n<p>Meier Hall 316B - Charlotte Forten Legacy Room<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Jess Cook<br \\/><a href=\\\"mailto:jcook2@salemstate.edu\\\">jcook2@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4954\\\">978.542.4954<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Holding Space March 27 2025\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"holding-space\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 22:34:11\",\"post_modified_gmt\":\"2025-03-27 22:34:11\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/holding-space\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":783,\"post_author\":\"1\",\"post_date\":\"2025-03-26 02:54:03\",\"post_date_gmt\":\"2025-03-26 02:54:03\",\"post_content\":\"<p>Choose your fighter and battle against the SSU community! Tournament will take place on Nintendo Switch, no pre-registration required.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Sean Conners<br \\/><a href=\\\"mailto:sconners@salemstate.edu\\\">sconners@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4965\\\">978.542.4965<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Super Smash Tournament\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"super-smash-tournament\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:53:03\",\"post_modified_gmt\":\"2025-04-07 02:53:03\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/super-smash-tournament\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":785,\"post_author\":\"1\",\"post_date\":\"2025-03-26 02:58:32\",\"post_date_gmt\":\"2025-03-26 02:58:32\",\"post_content\":\"<p>Join us for the <strong>Haitian Edition of Family Feud<\\/strong> - an exciting event where you can test your knowledge, learn about Haitian culture, and have a blast with friends! Compete in fun and spicy rounds featuring questions about Haitian history, music, food, and traditions. Whether you\'re familiar with Haitian culture or new to it, this is a perfect opportunity to learn while enjoying great company!<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Valerie Desir<br \\/><a href=\\\"mailto:s0387295@gmail.com\\\">s0387295@gmail.com<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Family Feud\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"family-feud\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:51:22\",\"post_modified_gmt\":\"2025-04-07 02:51:22\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/family-feud\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":787,\"post_author\":\"1\",\"post_date\":\"2025-03-26 03:02:36\",\"post_date_gmt\":\"2025-03-26 03:02:36\",\"post_content\":\"<p><strong>Julie Marie Muskat<\\/strong> has moved 16 times, but is originally from San Antonio, TX. She is a summa cum laude graduate of the inaugural class of Alonzo King\'s LINES Ballet BFA Program in San Francisco, CA, and of Interlochen Arts Academy in MI. She has taught dance across the US, Israel, and Italy, and her choreography has been set and performed internationally. She is currently based in Minnesota as a freelance choreographer and performer, having danced with Threads Dance Project (2013-2020), Vox Medusa, Dance and Other Behaviors, faux pas (a collaborative duo with Betsy Schaefer Roob), and as a guest artist for several companies.<\\/p>\\r\\n<p>Beyond Minnesota, she has danced with Kibbutz Contemporary Dance Company (Israel), Compagnia AiEP (Italy), Revolution Dance Theatre (OH), and Central California Ballet. She has performed her work and been on faculty at the Cathedral Dance Festival (MN) and the Southern Vermont Dance Festival. She is the founder of Deeper Water Arts &amp; Mind\\/Body Center, which provides dance, cross training, and health and wellness opportunities for young people and adults.<\\/p>\\r\\n<p>Julie will also present an Artist Talk on April 1 at 9:25 pm -10:40 am in O\'Keefe 303.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Karen A Gahagan<br \\/><a href=\\\"mailto:kgahagan@salemstate.edu\\\">kgahagan@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.7890\\\">978.542.7890<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Intermediate\\/Advanced Modern Technique with Julie Marie Muskat\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"intermediate-advanced-modern-technique-with-julie-marie-muskat\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:51:15\",\"post_modified_gmt\":\"2025-04-07 02:51:15\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/intermediate-advanced-modern-technique-with-julie-marie-muskat\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":789,\"post_author\":\"1\",\"post_date\":\"2025-03-26 03:07:08\",\"post_date_gmt\":\"2025-03-26 03:07:08\",\"post_content\":\"<p>Salem State\'s <a href=\\\"https:\\/\\/www.instagram.com\\/studentnursesassociation_ssu\\/\\\">Student Nurses Association<\\/a> is offering non nursing students the opportunity to participate in a first aid and CPR certification course. Sign-ups are first come, first serve. The cost will be $65 (cash or check), and we will be holding three certification courses. The certification is good for two years.<\\/p>\\r\\n<p><strong><a href=\\\"https:\\/\\/www.signupgenius.com\\/go\\/10C0944AFAD2EAAFFCF8-55570127-first#\\/\\\">Sign up.<\\/a><\\/strong><\\/p>\\r\\n<p>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"First Aid and CPR Certification Course\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"first-aid-and-cpr-certification-course\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:51:08\",\"post_modified_gmt\":\"2025-04-07 02:51:08\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/first-aid-and-cpr-certification-course\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":791,\"post_author\":\"1\",\"post_date\":\"2025-03-26 03:13:37\",\"post_date_gmt\":\"2025-03-26 03:13:37\",\"post_content\":\"<p>We continue our 20th anniversary celebration of the music major with \\\"The Ballad of Tam Lin\\\", a folk-rock opera by Molly Pinto Madigan \'13.<\\/p>\\r\\n<p>In addition to Madigan, this performance will feature SSU music alumni PJ Holaday, Zach Bridges, Madeleine Downs, Briana Paquin, Elizabeth Anderson, TJ Gansneberg, and Chris Bodek. They will be joined by Chaz Smith, Alec Hutson, Sam Margolis, and Jay DiBiasio.<\\/p>\\r\\n<p>The opera loosely retells the ballad of the same name - a traditional Scottish song with drama, mystery, romance, suspense, and supernatural elements. The story is told in 25 individual songs with each character voiced by a different singer. While each number has its own story arc, the pieces come together in an epic tale.<\\/p>\\r\\n<p><strong>Performance Dates<\\/strong><\\/p>\\r\\n<p>Saturday, March 29 at 7:30 pm<\\/p>\\r\\n<p>Sunday, March 30 at 3 pm<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>Admission is free. Donations at the door are welcome to support the work of the music department.<\\/p>\\r\\n<p><strong>MOLLY PINTO MADIGAN<\\/strong><\\/p>\\r\\n<p>Hailed for her angelic voice and haunting compositions, Molly Pinto Madigan graduated with a Bachelor of Arts in music from Salem State University, where she was named \\u201cArtist of the Year,\\u201d as well as receiving the university\'s first dual Creativity Award in both music and creative writing. Since her debut as the lead singer for the teen bluegrass band Jaded Mandolin, Madigan has submerged herself in the dark, luscious world of ballads, and her original songs echo with the whisperings of the American and European traditional music, combined with a fresh and modern lyricism. A three-time recipient of Club Passim\'s prestigious Iguana Music Fund, Molly just released her sixth studio album, \\\"Romeo and Juliet in the City.\\\" In her free time, Molly enjoys writing novels and competing as a ballroom and Latin dancer.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Karen A Gahagan<br \\/><a href=\\\"mailto:kgahagan@salemstate.edu\\\">kgahagan@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.7890\\\">978.542.7890<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"The Ballad of Tam Lin by Molly Pinto Madigan\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"the-ballad-of-tam-lin-by-molly-pinto-madigan\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:51:03\",\"post_modified_gmt\":\"2025-04-07 02:51:03\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/the-ballad-of-tam-lin-by-molly-pinto-madigan\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":793,\"post_author\":\"1\",\"post_date\":\"2025-03-26 03:44:51\",\"post_date_gmt\":\"2025-03-26 03:44:51\",\"post_content\":\"<p><em>This is a multiday event from Mar 30, 2025 - Apr 05, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>Are you a student interested in building skills and enhancing strategies related to academic success? Do you need a little bit of guidance and support around a particular academic success topic? Attend a <em><strong>Student Success Series Workshop<\\/strong><\\/em> (via Zoom) happening all this week at a variety of times.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Monday March 31:<\\/strong><\\/p>\\r\\n<p>10:30-11 am: Earning Participation Points in Online Classes<\\/p>\\r\\n<p>3-3:30 pm: Secrets of Successful Students<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Tuesday April 1:<\\/strong><\\/p>\\r\\n<p>11:30 am-12 pm: Online Tools for Success<\\/p>\\r\\n<p>2-2:30 pm: Avoiding Zoom Fatigue<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Wednesday April 2:<\\/strong><\\/p>\\r\\n<p>9:30-10 am: Goal Setting<\\/p>\\r\\n<p>1-1:30 pm: Writing Emails for Success<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Thursday April 3:<\\/strong><\\/p>\\r\\n<p>9-9:30 am: Common Mistakes in Online Classes<\\/p>\\r\\n<p>4-4:30 pm: Apps Which UP Your GPA<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Friday April 4:<\\/strong><\\/p>\\r\\n<p>10:30-11 am: Talking with Professors in Office Hours<\\/p>\\r\\n<p>4-4:30 pm: Conquering Procrastination<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>Can\'t attend a specific session? There are a number of additional academic resources available for students to take advantage of on the main Student Success Canvas page.<\\/p>\\r\\n<p>The full series schedule and Zoom access information are available on the individual Student Success Series section of the <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\\">Student Success Canvas<\\/a> page.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>First Year Experience<br \\/><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Student Success Series Workshops:\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"student-success-series-workshops-2\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:16:58\",\"post_modified_gmt\":\"2025-04-15 06:16:58\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/student-success-series-workshops-2\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":795,\"post_author\":\"1\",\"post_date\":\"2025-03-26 03:55:54\",\"post_date_gmt\":\"2025-03-26 03:55:54\",\"post_content\":\"<p><em>This is a multiday event from Mar 31, 2025 - Apr 18, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>The \\\"Trash to Art\\\" initiative, a Collaborative Online International Learning (COIL) project between Salem State University in the United States and Tecnol\\u00f3gico de Monterrey in Mexico, exemplifies the transformative power of global shared learning. Guided by Professors Tereza Swanda and Francisco Gonz\\u00e1lez Romo de Vivar, this project engages students from diverse cultural backgrounds in repurposing discarded materials into meaningful artworks, promoting a profound understanding of environmental sustainability and cross-cultural collaboration. By aligning with the United Nations Sustainable Development Goals #12 (Sustainable Consumption and Production) and #13 (Climate Action), \\\"Trash to Art\\\" challenges participants to critically examine their consumption patterns and the environmental impact of human activities.<\\/p>\\r\\n<h1>Additional Exhibition Events on Thursday, April 10<\\/h1>\\r\\n<p>Artist Talk-12:30-1:30 pm<\\/p>\\r\\n<p>Reception-1:30-3 pm<\\/p>\\r\\n<p>The Winfisky Gallery is open from 10 am-4 pm, Monday through Friday.<\\/p>\\r\\n<h1>Bios<\\/h1>\\r\\n<p><strong>Dr. Francisco Gonz\\u00e1lez Romo de Vivar<\\/strong> is an Assistant Professor at Tecnol\\u00f3gico de Monterrey, Campus Hidalgo, specializing in Art History, Visual Culture, and Semiotics. He holds a PhD in Art History from Centro de Cultura Casa Lamm, where his dissertation focused on cinematic themes using Gilles Deleuze\\u2019s filmic philosophy. His research interests include transdisciplinary practices in cinema, minor cinemas, and the aesthetic implications of technological advancements.<\\/p>\\r\\n<p>In his academic work, Dr. Gonz\\u00e1lez integrates these themes into his teaching, focusing on fostering global collaboration through technology-driven educational projects, including Collaborative Online International Learning (COIL). His courses cover topics such as Film Analysis, Posthumanism, and Audiovisual Narrative, encouraging students to engage critically with both historical and contemporary media.<\\/p>\\r\\n<p>Dr. Gonz\\u00e1lez is committed to creating learning environments that enhance student engagement and develop critical thinking. His current research explores intersections of cinema, media studies, and technology, continuously seeking new ways to enrich the educational experience in a global context.<\\/p>\\r\\n<p><strong>Tereza Swanda\\u2019s<\\/strong> interdisciplinary work centers on integrating with the \\u2018other,\\u2019 a term she uses to refer to diverse cultures, perspectives, and experiences. She resides in CZ and the States, teaching Studio Art and Art History at Salem State University and Roxbury Community College. Swanda holds an MFA from Vermont College of Fine Arts and a BFA in Painting and Sculpture from Massachusetts College of Art and Design.<\\/p>\\r\\n<p>She is currently working on a collaborative online international learning project, Trash2Art, which connects US students across the border to learners in Mexico. During the pandemic, her community engagement project, Touchstone, was included in The Immigrant Artist Biennial\\/ Mother Tongue. The artist asked those affected by COVID-19 to email her photos of loved ones, which she painted on stone. Her curatorial project, Unredacted, brought ten artists together who acknowledged the political post-truth world as artists and activists. Swanda received the A.R.T. Fund award to pursue her project, Capital Cleanse, in a rogue installation at the Metropolitan Museum of Art. She has exhibited her work at the Whitney Center for the Arts (Pittsfield, MA), University of Oregon (Eugene, OR), Berliner Kunstprojekt (Berlin), 450 Broadway Gallery (NY), Bakalar and Paine Galleries (Boston, MA), Chemeketa Community College Art Gallery (Salem, OR), Center on Contemporary Art (Seattle, WA) online in Storyscape Journal and Waves joining over 20,000 women who have contributed over the years. She has been awarded residencies at VSC (Johnson, VT) and the Millay Colony (Austerlitz, NY). She has been attending workshops with Rose Shakinovsky and Claire Gavronsky in Italy and South Africa since 2000.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Trash Transformed: A Binational Perspective on Art and Sustainability\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"trash-transformed-a-binational-perspective-on-art-and-sustainability\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-14 23:42:01\",\"post_modified_gmt\":\"2025-04-14 23:42:01\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/trash-transformed-a-binational-perspective-on-art-and-sustainability\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":798,\"post_author\":\"1\",\"post_date\":\"2025-03-26 03:59:20\",\"post_date_gmt\":\"2025-03-26 03:59:20\",\"post_content\":\"<p>Doomscrolling is a phenomenon that has become increasingly more relevant in our digital age. Doomscrolling refers to the act of continuously scrolling through negative news or social media feeds, often leading to feelings of anxiety and distress. It is a behaviour many of us have fallen into, especially during times of crisis or uncertainty. During this session participants will learn the definition of doomscrolling and explore how it manifests in their daily lives. The session will also delve into the psychological and social factors that drive people to engage in this behaviour. The session continues by examining the mental and physical health consequences associated with prolonged exposure to negative content. The session concludes by providing practical strategies and tips to help break the cycle of doomscrolling and promote healthier habits. By the end of the session participants will have a deeper understanding of doomscrolling and be equipped with tools to manage online consumption more mindfully.<\\/p>\\r\\n<p>Please note, our EAP cannot engage in political discourse.<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/eapworklife.my.site.com\\/USTrainingForm\\/s\\/newregistrationpage?c__recordId=a25UI000000gcX7YAI\\\">Register here!<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Joanna Nandi<br \\/><a href=\\\"mailto:jnandi@salemstate.edu\\\">jnandi@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.6030\\\">978.542.6030<\\/a><br \\/><a href=\\\"https:\\/\\/eapworklife.my.site.com\\/USTrainingForm\\/s\\/newregistrationpage?c__recordId=a25UI000000gcX7YAI\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"EAP Webinar: Doomscrolling\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"eap-webinar-doomscrolling\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:50:46\",\"post_modified_gmt\":\"2025-04-07 02:50:46\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/eap-webinar-doomscrolling\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":800,\"post_author\":\"1\",\"post_date\":\"2025-03-26 04:05:20\",\"post_date_gmt\":\"2025-03-26 04:05:20\",\"post_content\":\"<p>Where: Ellison Campus Center, North Campus Martin Luther King, Jr. Room<br \\/>When: 11:00 am - 12:00 pm<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>The Salem State writing faculty share their work in this annual event.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Karen A Gahagan<br \\/><a href=\\\"mailto:kgahagan@salemstate.edu\\\">kgahagan@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.7890\\\">978.542.7890<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Faculty Reading\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"faculty-reading\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:50:38\",\"post_modified_gmt\":\"2025-04-07 02:50:38\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/faculty-reading\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":802,\"post_author\":\"1\",\"post_date\":\"2025-03-26 04:12:21\",\"post_date_gmt\":\"2025-03-26 04:12:21\",\"post_content\":\"<p><strong>Congratulations to the Class of 2025 and their guests<\\/strong><br \\/>When: 6:00 pm - 7:00 pm<\\/p>\\r\\n<p><br \\/>Graduation cap decorated with flowers that reads \'She believed she could so she did\' BSN<br \\/>Find out about commencement tickets, graduation portraits, and everything that graduates and guests need to know as the countdown to cap and gown nears! President Keenan, Academic Affairs, and Alumni Affairs invite you to a Zoom presentation about celebrating the Class of 2025! <a href=\\\"https:\\/\\/salemstate.zoom.us\\/meeting\\/register\\/l8TvBs_aRtqerDh-HhH8ig\\\">Register<\\/a> to attend on Monday, March 31 at 6 pm.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Bruce Perry<br \\/><a href=\\\"mailto:commencement@salemstate.edu\\\">commencement@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4723\\\">978.542.4723<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Commencement 101: Countdown to Cap and Gown!\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"commencement-101-countdown-to-cap-and-gown\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:50:31\",\"post_modified_gmt\":\"2025-04-07 02:50:31\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/commencement-101-countdown-to-cap-and-gown\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":804,\"post_author\":\"1\",\"post_date\":\"2025-03-26 04:18:14\",\"post_date_gmt\":\"2025-03-26 04:18:14\",\"post_content\":\"<p>What do you do when you learn that the version of history passed down in your family might not be entirely true and the foundation that held up the grand deeds of your childhood hero abruptly crumbles? How does one disentangle half-truths and relate them to the historical record? These questions form the framework of Matthias Rudolf\\u2019s book project \\u2014 \\\"based on a true story\\\" \\u2014 whose protagonist sets out to make sense of his dying grandfather\\u2019s cryptic last words: \\u201cDer Kaiser hat uns verraten\\u201d (\\u201cThe Emperor has betrayed us\\u201d). The phrase casts a spell of doubt on the grandfather\\u2019s legacy of WWII heroics as a spy and his escape from the Nazis during the German invasion of the Balkan Peninsula in April 1941. Drawing on his research, Professor Rudolf will discuss the challenges of researching memories, making sense of sources in and across geographically dispersed and linguistically diverse archives, and of (not) getting lost in translation.<\\/p>\\r\\n<p>Matthias Rudolf graduated from the University of Basel, Switzerland and received his Ph.D. from the University of Wisconsin, Madison. He has published on romantic poetry, biopolitics, and postcolonial theory and taught at the Universit\\u00e9 de Fribourg, the University of Nevada, Reno, and the University of Oklahoma. Currently he is a visiting professor in the English Department at Salem State.<\\/p>\\r\\n<p>This event is free and open to the public. It will take place in person and will also be livestreamed on Zoom. Registration is required.<\\/p>\\r\\n<p><a href=\\\"http:\\/\\/lp.constantcontactpages.com\\/ev\\/reg\\/7s6zk6w\\\">Register to attend this talk in person.<\\/a><\\/p>\\r\\n<p><a href=\\\"http:\\/\\/salemstate.zoom.us\\/meeting\\/register\\/ygCZnonFQ7Sc5vn2U2wsmQ\\\">Register to view this talk on zoom.<\\/a><\\/p>\\r\\n<p>This event is cosponsored by the Center for Research and Creative Activities, the English department, and the Public History Speakers Series.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Lynn T Blayer<br \\/><a href=\\\"mailto:ctr_lblayer@salemstate.edu\\\">ctr_lblayer@salemstate.edu<\\/a><br \\/><a href=\\\"tel:781.576.9184\\\">781.576.9184<\\/a><br \\/><a href=\\\"https:\\/\\/lp.constantcontactpages.com\\/ev\\/reg\\/7s6zk6w\\\">Get tickets<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"On Researching Fictions\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"on-researching-fictions\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:50:24\",\"post_modified_gmt\":\"2025-04-07 02:50:24\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/on-researching-fictions\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":806,\"post_author\":\"1\",\"post_date\":\"2025-03-26 05:07:43\",\"post_date_gmt\":\"2025-03-26 05:07:43\",\"post_content\":\"<p>Incoming first-year (freshmen) are invited to join First Year Experience for a session to learn about the first year seminar (fall semester course) at Salem State and the process for selecting one. Students choose their seminar after reviewing the various topics. Seats are limited in each seminar so selecting early is important. Seminar selection opens on Monday March 3.<\\/p>\\r\\n<p>Registration for each session closes 48 hours before the session (or on Friday if the session occurs on a Monday).<\\/p>\\r\\n<p><strong>Tuesday April 1, 5pm<\\/strong> <a href=\\\"https:\\/\\/salemstate.zoom.us\\/meeting\\/register\\/_1bquIDXR56ufxTzawgDTAhttps:\\/\\/salemstate.zoom.us\\/meeting\\/register\\/_1bquIDXR56ufxTzawgDTA\\\">REGISTER<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Mathew Chetnik<br \\/><a href=\\\"mailto:firstyearseminar@salemstate.edu\\\">firstyearseminar@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"First Year Seminar Info Session (incoming students)\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"first-year-seminar-info-session-incoming-students\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:50:16\",\"post_modified_gmt\":\"2025-04-07 02:50:16\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/first-year-seminar-info-session-incoming-students\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":809,\"post_author\":\"1\",\"post_date\":\"2025-03-26 05:14:45\",\"post_date_gmt\":\"2025-03-26 05:14:45\",\"post_content\":\"<strong>Open Dialogue Hour for Faculty and Staff<\\/strong>\\n\\nIn order to support open and direct dialogue between campus leadership, faculty and staff, our VP of Diversity and Inclusion, Christopher Macdonald-Dennis, is hosting weekly \\u201cHolding Space\\u201d sessions across campus.\\n\\nThese low-stakes, hour-long drop-in sessions are open to all faculty and staff who wish to stop by and engage in conversation with VP Macdonald-Dennis and other members of the President\\u2019s Executive Council (PEC) and campus leadership. To encourage meaningful connection, each session is scheduled in one of campus\\u2019s smaller conference rooms and open to in-person attendance only<span style=\\\"font-size: revert; color: initial;\\\">.<\\/span>\\n\\nAdditional Holding Space opportunities this semester:\\n\\n<strong>Tuesday, April 8 | 10:30-11:30 am<\\/strong>\\n\\nMarsh Hall 204\\n\\n<strong>Friday, April 18 | 11 am-12 pm<\\/strong>\\n\\nHarrington Building 104\\n\\n<strong>Thursday, April 24 | 3:30-4:30 pm<\\/strong>\\n\\nMeier Hall 316B - Charlotte Forten Legacy Room\\n\\n<strong>Contact<\\/strong>\\nJess Cook\\n<a href=\\\"mailto:jcook2@salemstate.edu\\\">jcook2@salemstate.edu<\\/a>\\n<a href=\\\"tel:978.542.4954\\\">978.542.4954<\\/a>\\nFor access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.\",\"post_title\":\"Holding Space April 2 2025\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"holding-space-april-2-2025\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-04 04:21:28\",\"post_modified_gmt\":\"2025-04-04 04:21:28\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=809\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":810,\"post_author\":\"1\",\"post_date\":\"2025-03-26 05:18:52\",\"post_date_gmt\":\"2025-03-26 05:18:52\",\"post_content\":\"<p><strong>A Panel Discussion on Building and Managing Generational Wealth<\\/strong><\\/p>\\r\\n<p>Join us for an insightful panel discussion featuring Raminder Luther, Dean of the Bertolon School of Business, Investment Advisor Santo Dimino \\u201918, and Founder and President at Nationwide REO Brokers, Inc., Nick Petrocelli \\u201921. The panel will be moderated by Don White, Assistant Dean of Student Success of the Bertolon School of Business, on building and managing generational wealth. Refreshments will be provided!<\\/p>\\r\\n<p>This event is sponsored by The Brotherhood, HSI-MSI Initiatives, and The Bertolon School of Business.<\\/p>\\r\\n<p>All students are welcome and encouraged to attend.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Carlie Pierre<br \\/><a href=\\\"mailto:cpierre@salemstate.edu\\\">cpierre@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4852\\\">978.542.4852<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Generational Wealth Workshop\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"generational-wealth-workshop\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:50:09\",\"post_modified_gmt\":\"2025-04-07 02:50:09\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/generational-wealth-workshop\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":812,\"post_author\":\"1\",\"post_date\":\"2025-03-26 23:51:41\",\"post_date_gmt\":\"2025-03-26 23:51:41\",\"post_content\":\"<p><strong>Jane McManus: The Fast Track: Inside the Surging Business of Women\'s Sports<\\/strong><\\/p>\\r\\n<p>Jane McManus is a New York Times writer who has written a book on the explosion of women\'s sports. Women\'s sports is an expanding industry. We are seeing an expansion in the number of teams and a large increase in terms of support at the university level.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Annmarie T Bedard<br \\/><a href=\\\"mailto:abedard@salemstate.edu\\\">abedard@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.880.8619\\\">978.880.8619<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"SMS Department Speaker Series\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"sms-department-speaker-series\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:50:02\",\"post_modified_gmt\":\"2025-04-07 02:50:02\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/sms-department-speaker-series\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":814,\"post_author\":\"1\",\"post_date\":\"2025-03-26 23:58:21\",\"post_date_gmt\":\"2025-03-26 23:58:21\",\"post_content\":\"<p>As a young boy, Werner Salinger witnessed the violence of Kristallnacht in Berlin, Germany. His family escaped to America, but as a young man in the 1950s, he enlisted in the US Air Force and returned to Germany working in intelligence. It was there that he met his wife Martha, the daughter of a German soldier.<\\/p>\\r\\n<p>Join us as he reflects on how they made their lives together and their long process of familial reconciliation in the shadow of history.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>This event is free and open to the public.<\\/p>\\r\\n<p>Cosponsored by the Jewish Employee Resource Group (JERG), Hillel and by the president\\u2019s office.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Peter Urkowitz<br \\/><a href=\\\"mailto:purkowitz@salemstate.edu\\\">purkowitz@salemstate.edu<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"A Talk with Holocaust Survivor Werner Salinger\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"a-talk-with-holocaust-survivor-werner-salinger\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:49:40\",\"post_modified_gmt\":\"2025-04-07 02:49:40\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/a-talk-with-holocaust-survivor-werner-salinger\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":816,\"post_author\":\"1\",\"post_date\":\"2025-03-27 00:05:16\",\"post_date_gmt\":\"2025-03-27 00:05:16\",\"post_content\":\"<p>Eight teams from business, social work, fire science, healthcare studies, psychology, English, and communication majors presenting on the stage for $5,000 grand prize.<\\/p>\\r\\n<p>See Salem State students shining with their innovative business ideas, and get free food!<\\/p>\\r\\n<p>This free event takes place in the recital hall of academic building on Central Campus at 5-7 pm on Thursday, April 3.<\\/p>\\r\\n<p>The seats in the recital hall are limited, so <a href=\\\"https:\\/\\/www.eventbrite.com\\/e\\/5th-annual-viking-business-pitch-competition-tickets-1274231463609?aff=oddtdtcreator\\\"><strong>please register here to reserve a seat<\\/strong><\\/a>.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/><a href=\\\"https:\\/\\/www.salemstate.edu\\/businesspitch\\\">More about the Viking Business Pitch<\\/a><br \\/><a href=\\\"https:\\/\\/www.eventbrite.com\\/e\\/5th-annual-viking-business-pitch-competition-tickets-1274231463609?aff=oddtdtcreator\\\">Register to attend the final presentations<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Viking Business Pitch Final Presentations\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"viking-business-pitch-final-presentations\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:49:21\",\"post_modified_gmt\":\"2025-04-07 02:49:21\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/viking-business-pitch-final-presentations\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":818,\"post_author\":\"1\",\"post_date\":\"2025-03-27 00:14:24\",\"post_date_gmt\":\"2025-03-27 00:14:24\",\"post_content\":\"<p>Join us for the Haitian Cultural Club\'s Bake Sale! From March 26-28, you can pre-order delicious baked goods that celebrate Haitian culture. Be sure to stop by our tabling locations to place your order:<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<ul>\\r\\n<li><strong>Wednesday, March 26:<\\/strong> 12-2 pm | Dunkin\' Lobby, 3-5 pm | North Dining<\\/li>\\r\\n<li><strong>Thursday, March 27:<\\/strong> 11 am-1 pm | Dunkin\' Lobby, 2-3 pm | North Dining<\\/li>\\r\\n<li><strong>Friday, March 28:<\\/strong> 3-5 pm | Marsh Dining Lobby<\\/li>\\r\\n<\\/ul>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>Pre-sale items will be available for <strong>pickup on Friday, April 4 from 11 am-5 pm in Alumni Plaza (rain location: ECC Lobby).<\\/strong> Stay updated through our Instagram page @hcc_ssu. Don\'t miss out on these tasty treats!<\\/p>\",\"post_title\":\"Bake Sale\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"bake-sale\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 23:19:02\",\"post_modified_gmt\":\"2025-03-27 23:19:02\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/bake-sale\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":820,\"post_author\":\"1\",\"post_date\":\"2025-03-27 00:21:01\",\"post_date_gmt\":\"2025-03-27 00:21:01\",\"post_content\":\"<p>Are you a student interested in building skills and enhancing strategies related to academic success? Do you need a little bit of guidance and support around a particular academic success topic? Attend a <em><strong>Student Success Series Workshop<\\/strong><\\/em> (via Zoom) happening all this week at a variety of times.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Monday April 6:<\\/strong><\\/p>\\r\\n<p>11-11:30 am: Developing an Effective Online Presentation<\\/p>\\r\\n<p>3:30-4 pm: Tricks to Improve Your Memory<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Tuesday April 7:<\\/strong><\\/p>\\r\\n<p>12-12:30 pm: Setting Up A Successful Study Group<\\/p>\\r\\n<p>2:30-3 pm: Making a Plan for the Rest of the Semester<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Wednesday April 8:<\\/strong><\\/p>\\r\\n<p>9:30-10 am: Budgeting and Finance for College Students<\\/p>\\r\\n<p>3-3:30 pm: Tips for online Learning Success<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Thursday April 9:<\\/strong><\\/p>\\r\\n<p>9:30-10 am: Time Management<\\/p>\\r\\n<p>2-2:30pm: Study Skills<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Friday April 10:<\\/strong><\\/p>\\r\\n<p>11-11:30 am: Tips for Taking Notes in Online Classes<\\/p>\\r\\n<p>1:30-2 pm: Earning Participation Points in Online Classes<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>Can\'t attend a specific session? There are a number of additional academic resources available for students to take advantage of on the main <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\\">Student Success Canvas<\\/a> page.<\\/p>\\r\\n<p>The <strong>full series schedule <\\/strong>and <strong>Zoom access information<\\/strong> are available on the individual <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\/pages\\/student-success-workshops\\\">Student Success Series<\\/a> section of the Student Success Canvas page.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>First Year Experience<br \\/><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Student Success Series Workshops:\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"student-success-series-workshops-3\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:23:51\",\"post_modified_gmt\":\"2025-04-15 06:23:51\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/student-success-series-workshops-3\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":822,\"post_author\":\"1\",\"post_date\":\"2025-03-27 00:30:06\",\"post_date_gmt\":\"2025-03-27 00:30:06\",\"post_content\":\"<p><em>This is a multiday event from Apr 07, 2025 - Apr 12, 2025.<\\/em><\\/p>\\r\\n<p><br \\/>This year\'s Earth Days theme, Climate Change and Biodiversity, touches on many areas of study across campus. Please save the dates April 7 - 11, 2025 and be on the lookout for more information about lectures, panels, films and other activities during this week.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Tara Gallagher<br \\/><a href=\\\"mailto:Tgallagher@salemstate.edu\\\">Tgallagher@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.793.3913\\\">978.793.3913<\\/a><br \\/><a href=\\\"https:\\/\\/www.salemstate.edu\\/offices-and-services\\/sustainability\\/earth-days\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Earth Days 2025: Climate Change and Biodiversity\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"earth-days-2025-climate-change-and-biodiversity\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:22:57\",\"post_modified_gmt\":\"2025-04-11 05:22:57\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/earth-days-2025-climate-change-and-biodiversity\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":824,\"post_author\":\"1\",\"post_date\":\"2025-03-27 00:46:05\",\"post_date_gmt\":\"2025-03-27 00:46:05\",\"post_content\":\"<p><strong>Open to All SSU Students<\\/strong><\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>What<\\/strong>: We seem to have a titanic love affair with plastics. Their creation began as a means of making our lives easier. The use of plastics and their immense proliferation has become a detriment to both us and our environment.<\\/p>\\r\\n<p>After gathering information about plastic, its impact on our lives and effect upon the environment, students in Professor Ken Reker\\u2019s Form and Design classes are fabricating sculptural works using found objects, plastic and petroleum-based products, and consumer refuse.<\\/p>\\r\\n<p><strong>When<\\/strong>: These artworks will be displayed during the poster session on opening day of the 2025 Earth Day Celebration on Monday, April 7 from 11 am-12 pm in Vets Hall, ECC. Cash prizes are offered for winning pieces.<\\/p>\\r\\n<p><strong>You can participate too!<\\/strong> This project is open to any student in the SSU community who would like to participate with a sculpture. Please contact Ken Reker at <a href=\\\"mailto:k_reker@salemstate.edu\\\">k_reker@salemstate.edu<\\/a> for additional information.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Karen A Gahagan<br \\/><a href=\\\"mailto:kgahagan@salemstate.edu\\\">kgahagan@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.7890\\\">978.542.7890<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Message in a Bottle: Earth Days Art Competition\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"message-in-a-bottle-earth-days-art-competition\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:22:52\",\"post_modified_gmt\":\"2025-04-11 05:22:52\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/message-in-a-bottle-earth-days-art-competition\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":826,\"post_author\":\"1\",\"post_date\":\"2025-03-27 00:58:37\",\"post_date_gmt\":\"2025-03-27 00:58:37\",\"post_content\":\"<p>Discuss comprehensive, holistic, trauma-informed care to trafficking victims and to partner with local and regional social service providers to assist survivors in rebuilding their lives.<\\/p>\\r\\n<p>Speakers:<\\/p>\\r\\n<ul>\\r\\n<li><strong>Andrea Reilly MD,<\\/strong> Medical Director, MGH Freedom Clinic<\\/li>\\r\\n<li><strong>Zo\\u00eb Kessler, PhD,<\\/strong> Professor at the School of Social Work at Salem State University<\\/li>\\r\\n<\\/ul>\\r\\n<p>This is an online event and <a href=\\\"https:\\/\\/salemstateuniversity.wufoo.com\\/forms\\/salem-state-chhs-interprofessional-events\\/\\\"><strong>registration<\\/strong> <\\/a>is required.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Jeramie Silveira<br \\/><a href=\\\"mailto:jsilveira@salemstate.edu\\\">jsilveira@salemstate.edu<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Human Trafficking and Trauma Informed Care\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"human-trafficking-and-trauma-informed-care\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:22:46\",\"post_modified_gmt\":\"2025-04-11 05:22:46\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/human-trafficking-and-trauma-informed-care\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":828,\"post_author\":\"1\",\"post_date\":\"2025-03-27 01:03:31\",\"post_date_gmt\":\"2025-03-27 01:03:31\",\"post_content\":\"<p>Campus Life and Recreation\\/Gassett Fitness Center partner with a local Physical Therapist every month to offer you free advice! Stop by at the time most convenient for you between 5-7 pm. No need to pre-register.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Alejandro Rubero<br \\/><a href=\\\"mailto:arubero@salemstate.edu\\\">arubero@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.5181\\\">978.542.5181<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Ask a PT\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"ask-a-pt\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:22:38\",\"post_modified_gmt\":\"2025-04-11 05:22:38\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/ask-a-pt\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":831,\"post_author\":\"1\",\"post_date\":\"2025-03-27 01:13:00\",\"post_date_gmt\":\"2025-03-27 01:13:00\",\"post_content\":\"<strong>Open Dialogue Hour for Faculty and Staff<\\/strong>\\n\\nIn order to support open and direct dialogue between campus leadership, faculty and staff, our VP of Diversity and Inclusion, Christopher Macdonald-Dennis, is hosting weekly \\u201cHolding Space\\u201d sessions across campus.\\n\\nThese low-stakes, hour-long drop-in sessions are open to all faculty and staff who wish to stop by and engage in conversation with VP Macdonald-Dennis and other members of the President\\u2019s Executive Council (PEC) and campus leadership. To encourage meaningful connection, each session is scheduled in one of campus\\u2019s smaller conference rooms and open to in-person attendance only<span style=\\\"font-size: revert; color: initial;\\\">.<\\/span>\\n\\nAdditional Holding Space opportunities this semester:\\n\\n<strong>Friday, April 18 | 11 am-12 pm<\\/strong>\\n\\nHarrington Building 104\\n\\n<strong>Thursday, April 24 | 3:30-4:30 pm<\\/strong>\\n\\nMeier Hall 316B - Charlotte Forten Legacy Room\\n\\n<strong>Monday, April 28 | 1:30-2:30 pm<\\/strong>\\n\\nMarsh Hall 204\\n\\n<strong>Contact<\\/strong>\\nJess Cook\\n<a href=\\\"mailto:jcook2@salemstate.edu\\\">jcook2@salemstate.edu<\\/a>\\n<a href=\\\"tel:978.542.4954\\\">978.542.4954<\\/a>\\nFor access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.\",\"post_title\":\"Holding Space April 8 2025\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"holding-space-april-8-2025\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 01:13:00\",\"post_modified_gmt\":\"2025-03-27 01:13:00\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=831\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":832,\"post_author\":\"1\",\"post_date\":\"2025-03-27 01:25:12\",\"post_date_gmt\":\"2025-03-27 01:25:12\",\"post_content\":\"<p>Looking for a place to connect, practice Spanish, and build community?<\\/p>\\n<p>Faculty, staff, and students of all proficiency levels are invited to join us for <strong>Caf\\u00e9 y Tertulia<\\/strong>, a twice-monthly gathering for anyone seeking to improve their Spanish or help others learn the language.<\\/p>\\n<p>Together, we\\u2019ll practice, share ideas, and learn from one another in a fun and supportive environment. Come relax after class or work\\u2014we\\u2019ll provide discussion topics, coffee and treats. \\u00a1V\\u00e1monos!<\\/p>\\n<p>Every other Monday during spring semester:<\\/p>\\n<p>February 10<br \\/>February 24 <br \\/>March 10<br \\/>March 24<br \\/>April 7<br \\/>April 28<br \\/>May 12<\\/p>\\n<p>When: 5:30 pm - 6:30 pm<\\/p>\\n<p>This recurring event is sponsored by HSI-MSI Initiatives, part of Inclusive Excellence.<\\/p>\\n<p><strong>Contact<\\/strong><br \\/>Jess Cook<br \\/><a href=\\\"mailto:jcook2@salemstate.edu\\\">jcook2@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4954\\\">978.542.4954<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\n\\n<!-- wp:paragraph -->\\n<p><\\/p>\\n<!-- \\/wp:paragraph -->\",\"post_title\":\"Caf\\u00e9 y Tertulia | Coffee and Spanish Conversation April 7\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"cafe-y-tertulia-coffee-and-spanish-conversation-2\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-31 03:59:18\",\"post_modified_gmt\":\"2025-03-31 03:59:18\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=832\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":833,\"post_author\":\"1\",\"post_date\":\"2025-03-27 01:29:36\",\"post_date_gmt\":\"2025-03-27 01:29:36\",\"post_content\":\"<p><strong>Graduate School Panel Discussion and Information Session<\\/strong><br \\/><br \\/>Join us for a panel discussion and information session over light bites on why you should consider graduate school at Salem State University, and how to set yourself up for success, regardless of where you are in the process!<\\/p>\\r\\n<p>This event is free and open to the Salem State University community and guests.<\\/p>\\r\\n<p>Coordinated by: Inclusive Excellence, School of Graduate Studies, Graduate Admissions, and Career Services<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Carlie Pierre<br \\/><a href=\\\"mailto:cpierre@salemstate.edu\\\">cpierre@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4852\\\">978.542.4852<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Navigating Your Future: A Guide to Graduate School\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"navigating-your-future-a-guide-to-graduate-school\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:22:32\",\"post_modified_gmt\":\"2025-04-11 05:22:32\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/navigating-your-future-a-guide-to-graduate-school\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":835,\"post_author\":\"1\",\"post_date\":\"2025-03-27 01:37:20\",\"post_date_gmt\":\"2025-03-27 01:37:20\",\"post_content\":\"<p>Join us for a student panel on successfully transitioning from your first to second year of college!<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Megan Wigton<br \\/><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Transitioning to Sophomore Year\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"transitioning-to-sophomore-year\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:22:27\",\"post_modified_gmt\":\"2025-04-11 05:22:27\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/transitioning-to-sophomore-year\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":837,\"post_author\":\"1\",\"post_date\":\"2025-03-27 01:46:07\",\"post_date_gmt\":\"2025-03-27 01:46:07\",\"post_content\":\"<h1><strong>Save a Life! Donate!<\\/strong><\\/h1>\\r\\n<p>Join Community Service Initiative at the next Red Cross Blood Drive! <a href=\\\"https:\\/\\/nam10.safelinks.protection.outlook.com\\/?url=https%3A%2F%2Fwww.redcrossblood.org%2Fgive.html%2Fdrive-results%3FzipSponsor%3DSalem%2520State&amp;data=05%7C02%7Cbperry%40salemstate.edu%7C35b7b61e4a8a46c139ef08dd097404b7%7C70d32b73b45749d1950c4f78aeffc21b%7C0%7C0%7C638677116461295597%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=xKzObPsDrAtqWx6LYJwzf9dm6qlJ4gOyOgGOGqx1dHU%3D&amp;reserved=0\\\">Schedule an appointment<\\/a> or <a href=\\\"https:\\/\\/nam10.safelinks.protection.outlook.com\\/?url=https%3A%2F%2Fwww.redcrossblood.org%2F&amp;data=05%7C02%7Cbperry%40salemstate.edu%7C35b7b61e4a8a46c139ef08dd097404b7%7C70d32b73b45749d1950c4f78aeffc21b%7C0%7C0%7C638677116461313131%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=%2FJDJU5jQDaUYRYaPj%2B8SkZ1NiW8nSe1YxijioqPnEiQ%3D&amp;reserved=0\\\">visit the Red Cross website<\\/a> and search \\\"Salem State\\\" to sign up to donate at the drive.<\\/p>\\r\\n<p>Volunteers are also needed to check in donors and to assist donors by providing snacks and drinks after they have donated. Anyone interested in volunteering, please email <a href=\\\"mailto:service@salemstate.edu\\\">service@salemstate.edu<\\/a> to indicate when you may be available to volunteer.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Bruce Perry<br \\/><a href=\\\"mailto:service@salemstate.edu\\\">service@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2823\\\">978.542.2823<\\/a><br \\/><a href=\\\"https:\\/\\/www.redcrossblood.org\\/\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Red Cross Blood Drive\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"red-cross-blood-drive\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:22:21\",\"post_modified_gmt\":\"2025-04-11 05:22:21\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/red-cross-blood-drive\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":839,\"post_author\":\"1\",\"post_date\":\"2025-03-27 02:01:22\",\"post_date_gmt\":\"2025-03-27 02:01:22\",\"post_content\":\"<p>It\'s time once again to determine the fastest racer on campus! Challenge yourself against our returning winners or come watch the action. Don\'t slip on a banana!<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Sean Conners<br \\/><a href=\\\"mailto:sconners@salemstate.edu\\\">sconners@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4965\\\">978.542.4965<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Mario Kart Tournament\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"mario-kart-tournament\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:22:16\",\"post_modified_gmt\":\"2025-04-11 05:22:16\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/mario-kart-tournament\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":841,\"post_author\":\"1\",\"post_date\":\"2025-03-27 02:11:26\",\"post_date_gmt\":\"2025-03-27 02:11:26\",\"post_content\":\"<p>Join us as we Meet the Moment\\u00ae by celebrating all those who completed the 2025 educator license program.<\\/p>\\r\\n<p>The Educators Pinning Ceremony will include appetizers and refreshments, networking, and words of inspiration for our graduating students!<\\/p>\\r\\n<p>This event is proudly hosted by the Salem State University Friends of the McKeown School of Education and the Salem State University Alumni Association and Foundation, Inc.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Alumni Engagement<br \\/><a href=\\\"mailto:alumni@salemstate.edu\\\">alumni@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.7530\\\">978.542.7530<\\/a><br \\/><a href=\\\"https:\\/\\/participate.salemstate.edu\\/pinningceremony\\\">Get tickets<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"The 11th Annual Sheila P. Kearney \\u201954, \\u201867G Educators Pinning Ceremony\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"the-11th-annual-sheila-p-kearney-54-67g-educators-pinning-ceremony\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:22:12\",\"post_modified_gmt\":\"2025-04-11 05:22:12\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/the-11th-annual-sheila-p-kearney-54-67g-educators-pinning-ceremony\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":843,\"post_author\":\"1\",\"post_date\":\"2025-03-27 02:14:44\",\"post_date_gmt\":\"2025-03-27 02:14:44\",\"post_content\":\"<p>Calling all SSU Student Creatives! Sign up for the Spring Arts Coffeehouse.<\\/p>\\r\\n<p>Interested in art, creative writing, dance, music, or theatre? Join us for a night of performing, mingling with creatives on campus, and snacks!<\\/p>\\r\\n<p>This event is co-sponsored by Center for Creative and Performing Arts, Student Involvement and Activities, and Salem State Audio Engineer Society.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Karen A Gahagan<br \\/><a href=\\\"mailto:kgahagan@salemstate.edu\\\">kgahagan@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.7890\\\">978.542.7890<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Spring Arts Coffeehouse\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"spring-arts-coffeehouse\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:22:08\",\"post_modified_gmt\":\"2025-04-11 05:22:08\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/spring-arts-coffeehouse\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":845,\"post_author\":\"1\",\"post_date\":\"2025-03-27 02:20:53\",\"post_date_gmt\":\"2025-03-27 02:20:53\",\"post_content\":\"<p><strong>Friday, April 11, 7 am-3 pm | Virtual<\\/strong><\\/p>\\r\\n<p>Learn more about innovative trends in education that are being used around the globe at the SSU Center for Childhood &amp; Youth Studies annual conference. Presenters from China, England, Nigeria, Pakistan, Vienna, India, Turkey, and the USA will present their cutting-edge suggestions for how to make education more relevant for students.<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/www.theworldasitcouldbe.org\\/5260-2\\/\\\"><strong>Learn more.<\\/strong><\\/a><\\/p>\\r\\n<p>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Innovative Strategies for Enhancing Youth Education\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"innovative-strategies-for-enhancing-youth-education\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:50:45\",\"post_modified_gmt\":\"2025-04-17 04:50:45\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/innovative-strategies-for-enhancing-youth-education\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":847,\"post_author\":\"1\",\"post_date\":\"2025-03-27 02:26:28\",\"post_date_gmt\":\"2025-03-27 02:26:28\",\"post_content\":\"<p>Salem State Athletics and the Alumni Association and Foundation invite members of the campus community to the 2025 Athletic Hall of Fame induction celebration.<\\/p>\\r\\n<p>This year\\u2019s celebration highlights the best and most significant contributions to Salem State athletics by four individuals and one team.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/ssuathletichof.eventbrite.com\\/\\\"><strong>Register today!<\\/strong><\\/a><\\/p>\\r\\n<p><br \\/><strong>Contact<\\/strong><br \\/>Alumni Relations<br \\/><a href=\\\"mailto:alumni@salemstate.edu\\\">alumni@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.7530\\\">978.542.7530<\\/a><br \\/><a href=\\\"https:\\/\\/ssuathletichof.eventbrite.com\\/\\\">Get tickets<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Salem State University Athletic Hall of Fame Class of 2025 Induction Celebration\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"salem-state-university-athletic-hall-of-fame-class-of-2025-induction-celebration\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:50:51\",\"post_modified_gmt\":\"2025-04-17 04:50:51\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/salem-state-university-athletic-hall-of-fame-class-of-2025-induction-celebration\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":849,\"post_author\":\"1\",\"post_date\":\"2025-03-27 02:28:47\",\"post_date_gmt\":\"2025-03-27 02:28:47\",\"post_content\":\"<p>Hosted by the Muslim Student Association!<\\/p>\\r\\n<p>Join the MSA for a cozy bonfire night as we enjoy the warmer weather and welcome the arrival of spring!<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Alaa Atoui<br \\/><a href=\\\"mailto:a_atoui@salemstate.edu\\\">a_atoui@salemstate.edu<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Smores Bonfire\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"smores-bonfire\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 03:38:19\",\"post_modified_gmt\":\"2025-04-07 03:38:19\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/smores-bonfire\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":851,\"post_author\":\"1\",\"post_date\":\"2025-03-27 02:48:24\",\"post_date_gmt\":\"2025-03-27 02:48:24\",\"post_content\":\"<p>Iaorana ASA Fam!<\\/p>\\r\\n<p>Ready to immerse yourself in the vibrant and rich culture of the Pacific Islands? Join us for an unforgettable Polynesian Dance Workshop with Yumi Matsumoto!<\\/p>\\r\\n<p>There will be a lei greeting to welcome you with love and aloha, as well as a breathtaking Polynesian dance performance featuring the beauty of Hula and Ori Tahiti. This will follow with an interactive workshop where YOU get to learn the graceful and powerful moves of these traditional dances. We will accommodate spam musubis from Manoa Poke to grab after the event to enjoy the taste of the islands! See you there with an open heart and dancing feet.<\\/p>\\r\\n<p>Mauruuru,<\\/p>\\r\\n<p>The ASA Executive Board<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Vivica Vu-Le<br \\/><a href=\\\"mailto:v_vule@salemstate.edu\\\">v_vule@salemstate.edu<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"APIDAHM Polynesian Dance Workshop\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"apidahm-polynesian-dance-workshop\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:50:57\",\"post_modified_gmt\":\"2025-04-17 04:50:57\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/apidahm-polynesian-dance-workshop\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":853,\"post_author\":\"1\",\"post_date\":\"2025-03-27 02:52:11\",\"post_date_gmt\":\"2025-03-27 02:52:11\",\"post_content\":\"<p>Are you a student interested in building skills and enhancing strategies related to academic success? Do you need a little bit of guidance and support around a particular academic success topic? Attend a <em><strong>Student Success Series Workshop<\\/strong><\\/em> (via Zoom) happening all this week at a variety of times.<\\/p>\\r\\n<p><strong>M<\\/strong><strong>onday April 14:<\\/strong><\\/p>\\r\\n<p>11:30am-12 pm: Managing Stress and Anxiety<\\/p>\\r\\n<p>4-4:30 pm: Common Mistakes in Online Classes<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Tuesday April 15:<\\/strong><\\/p>\\r\\n<p>11:30am-12 pm: Writing Emails for Success<\\/p>\\r\\n<p>3-3:30 pm: Talking with Professors in Office Hours<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Wednesday April 16:<\\/strong><\\/p>\\r\\n<p>12:30-1 pm: Tips for Online Learning Success<\\/p>\\r\\n<p>3:30-4 pm: Tricks to Improve Your Memory<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Thursday April 17:<\\/strong><\\/p>\\r\\n<p>10-10:30 am: Secrets of Successful Students<\\/p>\\r\\n<p>2:30-3 pm: Staying Focused in an Online Class<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Friday April 18:<\\/strong><\\/p>\\r\\n<p>10:30-11 am: Online Tools for Success<\\/p>\\r\\n<p>2-2:30 pm: Goal Setting<\\/p>\\r\\n<p>Can\'t attend a specific session? There are a number of additional academic resources available for students to take advantage of on the main <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\\">Student Success Canvas<\\/a> page. The <strong>full series schedule <\\/strong>and <strong>Zoom access information<\\/strong> are available on the individual <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\/pages\\/student-success-workshops\\\">Student Success Series<\\/a> section of the Student Success Canvas page.<\\/p>\\r\\n<p><strong>Contact<\\/strong><\\/p>\\r\\n<p>First Year Experience<\\/p>\\r\\n<p><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><\\/p>\\r\\n<p><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><\\/p>\\r\\n<p>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Student Success Series Workshops:\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"student-success-series-workshops-4\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:12:32\",\"post_modified_gmt\":\"2025-04-15 06:12:32\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=853\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":855,\"post_author\":\"1\",\"post_date\":\"2025-03-27 03:02:17\",\"post_date_gmt\":\"2025-03-27 03:02:17\",\"post_content\":\"<p>Get your steps in for well-being for a chance to win! Create a team or you can be placed on a team to compete against other university employees! Team with the most steps during the time period, will win a Campus Life and Recreation prize. Challenge will run from 4\\/14-4\\/27. Contact <a href=\\\"mailto:arubero@salemstate.edu\\\">arubero@salemstate.edu<\\/a> to build your team and for more information.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Alejandro Rubero<br \\/><a href=\\\"mailto:arubero@salemstate.edu\\\">arubero@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.5181\\\">978.542.5181<\\/a><br \\/><a href=\\\"https:\\/\\/brightbreaks.com\\/salemstate\\/\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Bright Breaks Step Challenge\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"bright-breaks-step-challenge\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:51:03\",\"post_modified_gmt\":\"2025-04-17 04:51:03\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/bright-breaks-step-challenge\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":857,\"post_author\":\"1\",\"post_date\":\"2025-03-27 03:12:46\",\"post_date_gmt\":\"2025-03-27 03:12:46\",\"post_content\":\"<p><strong>Explore your next chapter at Salem State<\\/strong><br \\/><em>This is a multiday event from Apr 14, 2025 - Apr 17, 2025.<\\/em><\\/p>\\r\\n<p>Thinking about graduate school? Join us online for a series of workshops covering all things graduate school at Salem State! Meet with program coordinators, ask questions, learn about financial support, and so much more.<\\/p>\\r\\n<h2>Virtual Graduate Open House Schedule<\\/h2>\\r\\n<p>Click a session name to register.<\\/p>\\r\\n<p><strong>Monday, April 14<\\/strong><\\/p>\\r\\n<p><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZQc5MAG\\\">Graduate Financial Aid and Admissions Q&amp;A<\\/a>, 12 pm<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZRGPMA4\\\">MS Direct Entry Occupational Therapy<\\/a>, 5 pm<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZRLFMA4\\\">Business Administration (MBA)\\/MS Accounting<\\/a>, 6 pm<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZS4QMAW\\\">MS Athletic Training\\/ MS Criminal Justice<\\/a>, 7 pm<\\/p>\\r\\n<p><strong>Tuesday, April 15<\\/strong><br \\/><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZXAXMA4\\\">Graduate International Information Session<\\/a>, 12 pm<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZXKDMA4\\\">MS Nursing\\/ MS Adult-Gerontology NP<\\/a>, 5 pm<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZRMrMAO\\\">MA English\\/History and MS Mathematics<\\/a>, 6 pm<\\/p>\\r\\n<p><strong>Wednesday, April 16<\\/strong><br \\/><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZQk9MAG\\\">Graduate Student Panel,<\\/a> 12 pm<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZXP3MAO\\\">MS Psychology Programs<\\/a>, 5 pm<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZRWXMA4\\\">McKeown School of Education<\\/a>, 6 pm<\\/p>\\r\\n<p><strong>Thursday, April 17<\\/strong><br \\/><a href=\\\"http:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZXFNMA4\\\">Informacion sobre finanzas y admisiones para estudios graduados<\\/a>, 12 pm<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/salemstate.secure.force.com\\/events\\/targetX_eventsb__events#\\/esr?eid=a0RRm000006ZXSHMA4\\\">MS Geo-Information Science<\\/a>, 5 pm<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/nam10.safelinks.protection.outlook.com\\/?url=https%3A%2F%2Fsalemstate.my.salesforce-sites.com%2Fevents%2FtargetX_eventsb__events%23%2Fesr%3Feid%3Da0RRm000006WDptMAG&amp;data=05%7C02%7Cacollins%40salemstate.edu%7Ca09a43d914ea45ec3eab08dd52b864e5%7C70d32b73b45749d1950c4f78aeffc21b%7C0%7C0%7C638757674098596683%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=O%2FaInZYlKM9IMkJi8QQYv2n6RKw41VcUigIylVGu%2Bn0%3D&amp;reserved=0\\\">Master of Social Work (MSW)<\\/a>, 6 pm<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Graduate Admissions<br \\/><a href=\\\"mailto:gradadmissions@salemstate.edu\\\">gradadmissions@salemstate.edu<\\/a><br \\/><a href=\\\"https:\\/\\/www.salemstate.edu\\/graduate\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Virtual Graduate Open House\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"virtual-graduate-open-house\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-18 00:21:27\",\"post_modified_gmt\":\"2025-04-18 00:21:27\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/virtual-graduate-open-house\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":859,\"post_author\":\"1\",\"post_date\":\"2025-03-27 03:23:04\",\"post_date_gmt\":\"2025-03-27 03:23:04\",\"post_content\":\"<p>Inclusive Excellence invites you to mark your calendars and join us on Monday, April 14, 2025, from 11:15 am to 1 pm in ECC Veterans Hall for the Inaugural Inclusive Excellence Showcase and Recognition Luncheon.<\\/p>\\r\\n<p><strong>Doors will open for lunch at 11:15 am and the event will start promptly at 11:30 am.<\\/strong><\\/p>\\r\\n<p>This event is free and open to the Salem State University community and invited guests. Come celebrate our 24-25 academic year successes and connect with our community members over a delicious lunch!<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/forms.office.com\\/r\\/2uPp8b1YbP\\\"><strong>Inclusive Excellence Awards Nominations<\\/strong><\\/a><br \\/>As the hub for institutional transformation for equity here at Salem State University, Inclusive Excellence is excited to introduce this opportunity to elevate and celebrate members of our community for exemplary contributions toward inclusive excellence in best practices, research, leadership, or service.<\\/p>\\r\\n<p>Our goal is to encourage departments, faculty, staff, and students to implement comprehensive policies, practices, and initiatives designed to increase innovative, inclusive practices within our respective areas. We look forward to receiving many nominations of individuals and departments doing incredible work!<\\/p>\\r\\n<p>Award recipients will be recognized at the Inaugural Inclusive Excellence Showcase.<\\/p>\\r\\n<p><strong>Award categories for 2025 are as follows:<\\/strong><\\/p>\\r\\n<ul>\\r\\n<li>The Catalyst Award<\\/li>\\r\\n<li>Outstanding Service Award<\\/li>\\r\\n<li>Departmental Excellence Award<\\/li>\\r\\n<li>Outstanding Contribution to Education Award<\\/li>\\r\\n<\\/ul>\\r\\n<p><br \\/>The deadline to <a href=\\\"http:\\/\\/forms.office.com\\/r\\/2uPp8b1YbP\\\">submit a nomination<\\/a> is Sunday, March 30, 2025, at 11:59 pm.<\\/p>\\r\\n<p>Submission requirements for the Catalyst, Outstanding Service, and Departmental Excellence awards include a statement (250 words maximum) detailing why the nominee deserves recognition for the designated award, including the specific criteria associated with the award, as outlined in the award description.<\\/p>\\r\\n<p>Submissions for the Outstanding Contribute to Education Award will entail a statement (250 words maximum) on how the proposed contribution fits the award criteria and a completed copy of the deliverable attached. Supporting materials can be attached but are not required.<\\/p>\\r\\n<p><strong>Overview of Awards<\\/strong><br \\/><strong>The Catalyst Award<\\/strong> will be presented to a Salem State University undergraduate or graduate student for their exemplified commitment to inclusive excellence through exercising innovative and courageous leadership practices within their student organization, in a classroom, university program, and\\/or the development and implementation of campus programs and initiatives.<\\/p>\\r\\n<p><strong>The Outstanding Service Award<\\/strong> will be awarded to a Salem State University faculty, staff, or administrator, who, through a record of consistent service, has contributed substantially to advancing inclusive excellence at Salem State University.<\\/p>\\r\\n<p><strong>The Departmental Excellence Award<\\/strong> recognizes and honors a department, academic or administrative, that has demonstrated an outstanding commitment to championing diversity, equity, and inclusion. This award celebrates the collective commitment of the department to foster a more inclusive and equitable departmental community through transformative policies, best practices, and a profound contribution to the betterment of the departmental environment and the larger campus community.<\\/p>\\r\\n<p><strong>The Outstanding Contribution to Education Award<\\/strong> will recognize a faculty, staff member, or graduate student who has contributed substantially to furthering diversity and inclusion in higher education. Outstanding contributions to education may include research and creative inquiry, workshop development, campus diversity initiatives, curricular transformation, culturally affirming practices, capacity building, the influence of technology on diversity\\/equity, funding, and policies and inclusive practices.<\\/p>\\r\\n<p>The Inclusive Excellence team will review all nominations and select recipients after the submission deadline. Any Salem State community members can submit a nomination on their behalf or nominate a peer or colleague. Nominees will be notified by Friday, April 4.<\\/p>\\r\\n<p>Please address all questions or concerns to <a href=\\\"cpierre@salemstate.edu\\\">Carlie Pierre<\\/a>, Director of Education and Training.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Carlie Pierre<br \\/><a href=\\\"mailto:cpierre@salemstate.edu\\\">cpierre@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4852\\\">978.542.4852<\\/a><br \\/><a href=\\\"https:\\/\\/www.salemstate.edu\\/news\\/call-nominations-inaugural-inclusive-excellence-awards-mar-06-2025\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Inaugural Inclusive Excellence Showcase\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"inaugural-inclusive-excellence-showcase\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:51:09\",\"post_modified_gmt\":\"2025-04-17 04:51:09\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/inaugural-inclusive-excellence-showcase\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":861,\"post_author\":\"1\",\"post_date\":\"2025-03-27 03:26:36\",\"post_date_gmt\":\"2025-03-27 03:26:36\",\"post_content\":\"<p><strong>Undergraduate, graduate, and faculty history research showcase<\\/strong><\\/p>\\r\\n<p>History majors, graduate students, and faculty will showcase their current research in several sessions at the first annual History Research Showcase on April 14 from 1-4:30 pm on the first floor of the Sullivan Building and the MLK Room. We welcome back Professor Emeritus Dane Morrison for the keynote on \\\"The Revolution Comes to Essex County\\\" at 1 pm in the MLK room followed by concurrent sessions.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Michele Louro<br \\/><a href=\\\"mailto:mlouro@salemstate.edu\\\">mlouro@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2419\\\">978.542.2419<\\/a><br \\/><a href=\\\"https:\\/\\/www.salemstate.edu\\/academics\\/college-arts-and-sciences\\/history\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"History Research Showcase\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"history-research-showcase\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:51:16\",\"post_modified_gmt\":\"2025-04-17 04:51:16\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/history-research-showcase\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":863,\"post_author\":\"1\",\"post_date\":\"2025-03-27 03:38:22\",\"post_date_gmt\":\"2025-03-27 03:38:22\",\"post_content\":\"<p>Sudan is suffering famine for the fourth time\\u2014at least\\u2014in forty years. Darfur region is the location of genocide for the second time in twenty years. Why are these calamities unfolding yet again? Why has the world failed to prevent them? What might be done differently today? As we mark two years since the eruption of Sudan\\u2019s latest civil war, join us for a talk with Dr. Alex de Waal, a world-renowned expert on Sudan, who will speak about the region\\u2019s history, its people, and the origins of this new round of violence and mass starvation.<\\/p>\\r\\n<p>Alex de Waal is the executive director of the World Peace Foundation and Research Professor at the Fletcher School, Tufts University. He has worked on the Horn of Africa, and on famine, conflict, and related issues since the 1980s as a researcher and practitioner. He served as a senior advisor to the African Union on Sudan and South Sudan in various capacities. He is the author of numerous studies including, <em>Mass Starvation: The history and future of famine <\\/em>(Polity, 2018) and<em> Sudan\\u2019s Unfinished Democracy: The promise and betrayal of a people\\u2019s revolution <\\/em>(Hurst, 2022). His next book is <em>Negotiating the Sudans: The African Union High Level Panels 2009-2014<\\/em> (Cornell University Press, 2025).<\\/p>\\r\\n<p>This event is free and open to the public. It will take place in person and will also be livestreamed on zoom. Registration is required.<\\/p>\\r\\n<p>Please <a href=\\\"https:\\/\\/lp.constantcontactpages.com\\/ev\\/reg\\/3w9288n\\\">register<\\/a> here to attend this talk in person.<\\/p>\\r\\n<p>Please <a href=\\\"https:\\/\\/nam10.safelinks.protection.outlook.com\\/?url=https%3A%2F%2Fsalemstate.zoom.us%2Fwebinar%2Fregister%2FWN_l_fjMq0_SdSxPpA2gEBdrg%23%2Fregistration&amp;data=05%7C02%7Cctr_lblayer%40salemstate.edu%7Cde81f258c668420e730608dd3fb2f4f4%7C70d32b73b45749d1950c4f78aeffc21b%7C0%7C0%7C638736760016993703%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&amp;sdata=ApADVJxgXW0%2BdsTteX93sZgt%2FDyucNtce1juS1rU%2BrQ%3D&amp;reserved=0\\\">register<\\/a> here to view this talk on zoom.<\\/p>\\r\\n<p>This talk is cosponsored by the Center for Civic Engagement, the Politics, Policy and International Relations Department at Salem State University.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Lynn T Blayer<br \\/><a href=\\\"mailto:ctr_lblayer@salemstate.edu\\\">ctr_lblayer@salemstate.edu<\\/a><br \\/><a href=\\\"https:\\/\\/lp.constantcontactpages.com\\/ev\\/reg\\/3w9288n\\\">Get tickets<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Genocide and Famine in Sudan: What\\u2019s New? What\\u2019s to be Done?\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"genocide-and-famine-in-sudan-whats-new-whats-to-be-done\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:51:22\",\"post_modified_gmt\":\"2025-04-17 04:51:22\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/genocide-and-famine-in-sudan-whats-new-whats-to-be-done\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":865,\"post_author\":\"1\",\"post_date\":\"2025-03-27 03:41:25\",\"post_date_gmt\":\"2025-03-27 03:41:25\",\"post_content\":\"<p><strong>Step into the future of concert going with professors Sanae Kanda and Mike Testa<\\/strong><\\/p>\\r\\n<p>Step into the future of music at a groundbreaking concert where tradition meets innovation! Experience an interesting fusion of traditional acoustic music and cutting-edge AI-driven images, how we interpret AI-driven notations, and more. This unique performance explores the possibilities of traditional music with the precision and creativity of artificial intelligence, creating an ever-evolving musical journey. Be a part of this one-of-a-kind event that pushes the boundaries of sound and visual images, offering a fresh twist on timeless acoustic music. Join us for a night where the past and future collide in perfect harmony!<\\/p>\\r\\n<p>Studio Electronica<\\/p>\\r\\n<p>Admission is free. Donations at the door are welcome to support scholarships for music majors.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Karen A Gahagan<br \\/><a href=\\\"mailto:kgahagan@salemstate.edu\\\">kgahagan@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.7890\\\">978.542.7890<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"post_title\":\"Proof of Concept: Studio E\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"proof-of-concept-studio-e\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:51:28\",\"post_modified_gmt\":\"2025-04-17 04:51:28\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/proof-of-concept-studio-e\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":867,\"post_author\":\"1\",\"post_date\":\"2025-03-27 03:43:29\",\"post_date_gmt\":\"2025-03-27 03:43:29\",\"post_content\":\"<p>Campus Life and Recreation\\/Gassett Fitness Center is partnering with your campus dietitian to offer nutritional advice! Stop by at the time most convenient for you between 3:30-5:30pm to learn about \\\"macros made easy\\\", try free samples, and spin the wheel for a prize! No need to pre-register.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Alejandro Rubero<br \\/><a href=\\\"mailto:arubero@salemstate.edu\\\">arubero@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.5181\\\">978.542.5181<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Ask a Dietitian\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"ask-a-dietitian\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:51:34\",\"post_modified_gmt\":\"2025-04-17 04:51:34\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/ask-a-dietitian\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":869,\"post_author\":\"1\",\"post_date\":\"2025-03-27 03:49:25\",\"post_date_gmt\":\"2025-03-27 03:49:25\",\"post_content\":\"<p><strong>Celebrating the Class of 2025 and their guests<\\/strong><\\/p>\\r\\n<p>Find out about commencement tickets, graduation portraits, and everything that graduates and guests need to know as the countdown to cap and gown nears! President Keenan, Academic Affairs, and Alumni Affairs invite you to a Zoom presentation about celebrating the Class of 2025! <a href=\\\"https:\\/\\/salemstate.zoom.us\\/meeting\\/register\\/W0tX7bBST3238IyndVyoNg\\\"><strong>Register<\\/strong> <\\/a>to attend on Tuesday, April 15 at 6 pm.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Bruce Perry<br \\/><a href=\\\"mailto:commencement@salemstate.edu\\\">commencement@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4723\\\">978.542.4723<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Commencement 101: Countdown to Cap and Gown!\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"commencement-101-countdown-to-cap-and-gown-2\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:51:39\",\"post_modified_gmt\":\"2025-04-17 04:51:39\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/commencement-101-countdown-to-cap-and-gown-2\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":872,\"post_author\":\"1\",\"post_date\":\"2025-03-27 03:56:27\",\"post_date_gmt\":\"2025-03-27 03:56:27\",\"post_content\":\"<p><strong>A Student Panel on Addressing Bias and Creating Welcoming Spaces<\\/strong><br \\/><br \\/>In these complicated times, effective communication is critical across our communities. Join us for an evening of cross-campus dialogue. We\\u2019ll begin with a panel of SSU students who will share their experiences on campus, what a \\u201cwelcoming environment\\u201d means to them, and their insights on best practices for effectively handling moments of campus bias and conflict.<\\/p>\\r\\n<p>Afterwards, faculty and staff will engage in small group discussions on the feedback and stories shared, and what it might mean for our work. Faculty and staff are encouraged to attend this interactive, student-centered event.<\\/p>\\r\\n<p><strong>Faculty and staff are encouraged to attend this interactive, student-centered event!<\\/strong><\\/p>\\r\\n<p>Coordinated by: Abigail Machson-Carter, Instructional Designer, Center for Teaching Innovation, and Carlie Pierre, Director of Education and Training, Inclusive Excellence<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Carlie Pierre<br \\/><a href=\\\"mailto:cpierre@salemstate.edu\\\">cpierre@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4852\\\">978.542.4852<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Amplifying Student Voices: Addressing Bias at SSU\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"amplifying-student-voices-addressing-bias-at-ssu\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:51:46\",\"post_modified_gmt\":\"2025-04-17 04:51:46\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/amplifying-student-voices-addressing-bias-at-ssu\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":874,\"post_author\":\"1\",\"post_date\":\"2025-03-27 04:00:03\",\"post_date_gmt\":\"2025-03-27 04:00:03\",\"post_content\":\"<p>Did you know that April is Financial Literacy month? To help students build their financial foundation, we are offering assistance filing the 2025-26 FAFSA! Come join the Student Navigation Center on April 15 for our in-person event where we\'ll have experts on hand to guide you through the process.<\\/p>\\r\\n<p>Whether you\'re a first-time applicant or just need a refresher, we\'re here to help! Don\'t miss out on this opportunity to get the financial aid you need for college.<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/www.eventbrite.com\\/e\\/fafsa-assistance-tickets-1291300948899?aff=oddtdtcreator\\\"><strong>Register today!<\\/strong><\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Student Navigation Center<br \\/><a href=\\\"mailto:navcenter@salemstate.edu\\\">navcenter@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.8000\\\">978.542.8000<\\/a><br \\/><a href=\\\"https:\\/\\/www.eventbrite.com\\/e\\/fafsa-assistance-tickets-1291300948899?aff=oddtdtcreator\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"FAFSA Assistance\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"fafsa-assistance\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:51:52\",\"post_modified_gmt\":\"2025-04-17 04:51:52\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/fafsa-assistance\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":876,\"post_author\":\"1\",\"post_date\":\"2025-03-27 04:02:16\",\"post_date_gmt\":\"2025-03-27 04:02:16\",\"post_content\":\"<p>The Viking Video Chat Series is a live webinar series for incoming students. It is a great way to hang out with currently enrolled Salem State upper-class students and ask any questions you may have about life at the University. Any and all questions are welcomed!<\\/p>\\r\\n<p><a href=\\\"http:\\/\\/salemstate.zoom.us\\/meeting\\/register\\/D4j3E5pKSBKrVG-RK23CBA\\\"><strong>Register!<\\/strong><\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>First Year Experience<br \\/><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Viking Video Chat\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"viking-video-chat\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:51:59\",\"post_modified_gmt\":\"2025-04-17 04:51:59\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/viking-video-chat\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":878,\"post_author\":\"1\",\"post_date\":\"2025-03-27 04:18:55\",\"post_date_gmt\":\"2025-03-27 04:18:55\",\"post_content\":\"<p>Operation House Call (OHC) teaches students in medical, nursing, and allied health professional schools the essential skills and mindsets to enhance the health care of persons with autism and other intellectual and developmental disabilities (IDD). OHC turns to families, parents and individual self-advocates as educators in a health care field that seldom focuses on more than making a diagnosis.<\\/p>\\r\\n<p>Speaker:<\\/p>\\r\\n<ul>\\r\\n<li>Maura Sullivan, Chief Executive Officer, The Arc of Massachusetts, Director of Operation House Call<\\/li>\\r\\n<\\/ul>\\r\\n<p>This is an online event and <a href=\\\"https:\\/\\/salemstateuniversity.wufoo.com\\/forms\\/salem-state-chhs-interprofessional-events\\/\\\">registration<\\/a> is required.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Jeramie Silveira<br \\/><a href=\\\"mailto:jsilveira@salemstate.edu\\\">jsilveira@salemstate.edu<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Operation House Call\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"operation-house-call\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:52:06\",\"post_modified_gmt\":\"2025-04-17 04:52:06\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/operation-house-call\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":880,\"post_author\":\"1\",\"post_date\":\"2025-03-27 04:21:03\",\"post_date_gmt\":\"2025-03-27 04:21:03\",\"post_content\":\"<p>First-generation graduating seniors who have been approved for graduation (as part of the Class of 2025) are invited to the annual cording ceremony, to receive their honor cords.<\\/p>\\r\\n<p>Join university representatives to recognize your achievements as a first-generation college graduate.<\\/p>\\r\\n<p>First-generation students are defined as \\\"neither parent\\/guardian has received a bachelor\'s degree (four year college degree) in the United States\\\". Eligible students will receive an email invitation in early April.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Mathew R Chetnik<br \\/><a href=\\\"mailto:firstgen@salemstate.edu\\\">firstgen@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"First-Generation Graduating Senior Cording Ceremony\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"first-generation-graduating-senior-cording-ceremony\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:52:13\",\"post_modified_gmt\":\"2025-04-17 04:52:13\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/first-generation-graduating-senior-cording-ceremony\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":882,\"post_author\":\"1\",\"post_date\":\"2025-03-27 04:23:30\",\"post_date_gmt\":\"2025-03-27 04:23:30\",\"post_content\":\"<p><strong>For students who are in the undeclared major<\\/strong><\\/p>\\r\\n<p>Exploratory (undeclared) students - join peer leaders Nate and Elios to prepare to declare your major! Review some different majors and plan for the end of your semester so you finish strong.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Carolyn Tracy<br \\/><a href=\\\"mailto:ctracy@salemstate.edu\\\">ctracy@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4719\\\">978.542.4719<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Exploratory Major Review and Planning Time!\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"exploratory-major-review-and-planning-time\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-18 00:21:27\",\"post_modified_gmt\":\"2025-04-18 00:21:27\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/exploratory-major-review-and-planning-time\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":884,\"post_author\":\"1\",\"post_date\":\"2025-03-27 04:32:22\",\"post_date_gmt\":\"2025-03-27 04:32:22\",\"post_content\":\"<p><strong>Hosted by the International Student Association!<\\/strong><br \\/><br \\/>Culture Night has always been an important platform for our community to showcase multiculturalism and promote cross-cultural exchange. This year, ISA will present our rich and colorful cultural heritage through art, music, dance, food, etc. In 2025, we hope to continue this tradition and create an even more exciting, inclusive, and creative cultural feast.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Jier Qiu<br \\/><a href=\\\"mailto:j_qiu@salemstate.edu\\\">j_qiu@salemstate.edu<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"2025 Culture Night\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"2025-culture-night\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-18 00:21:27\",\"post_modified_gmt\":\"2025-04-18 00:21:27\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/2025-culture-night\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":886,\"post_author\":\"1\",\"post_date\":\"2025-03-27 04:34:58\",\"post_date_gmt\":\"2025-03-27 04:34:58\",\"post_content\":\"<p>Salem State University President John D. Keenan invites you and a guest to join him with host Kim D. Gassett-Schiller \'83, \'18H for a complimentary reception in San Francisco!<\\/p>\\r\\n<p>Join fellow alumni and friends for drinks, hors d\'oeuvres and camaraderie and hear an update about MEET THE MOMENT\\u00ae, the campaign for Salem State University.<\\/p>\\r\\n<p>For questions, please email: <a href=\\\"mailto:RSVP@salemstate.edu\\\">RSVP@salemstate.edu<\\/a>.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Engagement Events<br \\/><a href=\\\"mailto:RSVP@salemstate.edu\\\">RSVP@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2293\\\">978.542.2293<\\/a><br \\/><a href=\\\"https:\\/\\/participate.salemstate.edu\\/California\\\">Get tickets<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"San Francisco Alumni and Friends Reception\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"san-francisco-alumni-and-friends-reception\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-18 00:21:27\",\"post_modified_gmt\":\"2025-04-18 00:21:27\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/san-francisco-alumni-and-friends-reception\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":888,\"post_author\":\"1\",\"post_date\":\"2025-03-27 04:39:46\",\"post_date_gmt\":\"2025-03-27 04:39:46\",\"post_content\":\"<p><em><strong>This is a multiday event<\\/strong> from Apr 18, 2025 - Apr 26, 2025.<\\/em><\\/p>\\r\\n<p>Join the Center for Holocaust and Genocide Studies and the History Department for a study and travel course to Poland in April 2025. \\u201cHST991\\/EDG845: Teaching the Holocaust in Poland\\u201d is specifically designed for graduate students and current and future educators administrators interested in learning more deeply about the Holocaust in Poland. The course includes three evening seminars during the spring semester followed by group travel to Poland during MA school vacation from April 18-26, 2025.<\\/p>\\r\\n<p>With special attention to learning and teaching methods and strategies, we will visit:<\\/p>\\r\\n<ul>\\r\\n<li>Locally guided tour of Krakow, Poland with a visit to Jagiellonian University<\\/li>\\r\\n<li>Guided tour of the former Jewish Quarter, the Krakow Ghetto, the Memorial Site of the Plaszow Concentration Camp, and free time to visit Oscar Schindler\'s Factory (Krakow)<\\/li>\\r\\n<li>Specially designed educational tour of Auschwitz-Birkenau Concentration Camp and class meeting with the museum\\u2019s social media director<\\/li>\\r\\n<li>Tour of the former Kielce Ghetto and Kielce Pogrom Memorial Site<\\/li>\\r\\n<li>Visit to the Jewish Historical Institute with an educational tour of the Warsaw Ghetto and free time to visit the POLIN Museum of the History of Polish Jews<\\/li>\\r\\n<li>Visit to the Pawiak Prison Museum and the Warsaw Rising Museum<\\/li>\\r\\n<li>There will be free time in Krakow and Warsaw to develop your own itinerary and visit separate museums, sites, restaurants, and\\/or cultural events.<\\/li>\\r\\n<\\/ul>\\r\\n<p>Registered students are eligible for $500 scholarships to help cover the separate cost of 3 graduate credits at SSU. Students can register for HST 991 or EDG 845 depending on their program (MA, MAT, HGS Certificate, 4+1 program). 3 graduate credits can be converted to 67.5 PDPs for re-licensing of professional teachers.<\\/p>\\r\\n<p>For more information about the course and study and travel, please email Professor Christopher Mauriello at <a href=\\\"mailto:cmauriello@salemstate.edu\\\">cmauriello@salemstate.edu<\\/a>.<\\/p>\\r\\n<p>To register, please visit <a href=\\\"https:\\/\\/abroad.salemstate.edu\\/index.cfm?FuseAction=Programs.ViewProgramAngular&amp;id=30385\\\">Salem State Study Abroad<\\/a> or email Lauren Prema at <a href=\\\"mailto:lprema@salemstate.edu\\\">lprema@salemstate.edu<\\/a> for more information about the registration process.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Christopher Mauriello<br \\/><a href=\\\"mailto:cmauriello@salemstate.edu\\\">cmauriello@salemstate.edu<\\/a><br \\/><a href=\\\"https:\\/\\/abroad.salemstate.edu\\/index.cfm?FuseAction=Programs.ViewProgramAngular&amp;id=30385\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Study and Travel Course: Poland and the Holocaust\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"study-and-travel-course-poland-and-the-holocaust\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 04:39:46\",\"post_modified_gmt\":\"2025-03-27 04:39:46\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/study-and-travel-course-poland-and-the-holocaust\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":890,\"post_author\":\"1\",\"post_date\":\"2025-03-27 04:45:18\",\"post_date_gmt\":\"2025-03-27 04:45:18\",\"post_content\":\"<p>Join this discussion of fascia, our body\'s largest organ and what an important role it plays in our health and mobility<\\/p>\\r\\n<p>Speaker:<\\/p>\\r\\n<ul>\\r\\n<li><strong>Jessica Eddy-Storey OT<\\/strong>, LMT, Reiki Master, Transform Myofascial Release<\\/li>\\r\\n<\\/ul>\\r\\n<p>This is an online event and <a href=\\\"https:\\/\\/salemstateuniversity.wufoo.com\\/forms\\/salem-state-chhs-interprofessional-events\\/\\\">registration<\\/a> is required. Presented by the Center for Inter-professional Education and Collaboration.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Jeramie Silveira<br \\/><a href=\\\"mailto:jsilveira@salemstate.edu\\\">jsilveira@salemstate.edu<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Transforming Functional Performance through Myofascial Release\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"transforming-functional-performance-through-myofascial-release\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 04:45:18\",\"post_modified_gmt\":\"2025-03-27 04:45:18\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/transforming-functional-performance-through-myofascial-release\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":892,\"post_author\":\"1\",\"post_date\":\"2025-03-27 04:48:33\",\"post_date_gmt\":\"2025-03-27 04:48:33\",\"post_content\":\"<p><strong>A shuttle to and from the event will be provided free of charge.<\\/strong><br \\/>Where: Punto Urban Arts Museum<br \\/>When: 1:30 pm - 3:00 pm<\\/p>\\r\\n<p><br \\/>Join students and faculty on short trip to the Point neighborhood in Salem where we will visit the Local Artist Wall and \\u201cA Dream Called Home\\u201d murals. Punto Urban Art Museum representatives and the artists themselves will discuss the significance of their works and their meaning for the Salem community. Interested? RSVP by emailing Scott Nowka (<a href=\\\"mailto:snowka@salemstate.edu\\\">snowka@salemstate.edu<\\/a>) for more details.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Scott Nowka<br \\/><a href=\\\"mailto:snowka@salemstate.edu\\\">snowka@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.7183\\\">978.542.7183<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Trip to Explore the Punto Urban Art Museum in Downtown Salem\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"trip-to-explore-the-punto-urban-art-museum-in-downtown-salem\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 23:19:00\",\"post_modified_gmt\":\"2025-03-27 23:19:00\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/trip-to-explore-the-punto-urban-art-museum-in-downtown-salem\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":894,\"post_author\":\"1\",\"post_date\":\"2025-03-27 04:49:40\",\"post_date_gmt\":\"2025-03-27 04:49:40\",\"post_content\":\"<p><strong>Open Dialogue Hour for Faculty and Staff<\\/strong><\\/p>\\r\\n<p>In order to support open and direct dialogue between campus leadership, faculty and staff, our VP of Diversity and Inclusion, Christopher Macdonald-Dennis, is hosting weekly \\u201cHolding Space\\u201d sessions across campus.<\\/p>\\r\\n<p>These low-stakes, hour-long drop-in sessions are open to all faculty and staff who wish to stop by and engage in conversation with VP Macdonald-Dennis and other members of the President\\u2019s Executive Council (PEC) and campus leadership. To encourage meaningful connection, each session is scheduled in one of campus\\u2019s smaller conference rooms and open to in-person attendance only<span style=\\\"font-size: revert;color: initial\\\">.<\\/span><\\/p>\\r\\n<p>Additional Holding Space opportunities this semester:<\\/p>\\r\\n<p><strong>Thursday, April 24 | 3:30-4:30 pm<\\/strong> Meier Hall 316B - Charlotte Forten Legacy Room<\\/p>\\r\\n<p><strong>Monday, April 28 | 1:30-2:30 pm<\\/strong> Marsh Hall 204<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Contact<\\/strong><\\/p>\\r\\n<p>Jess Cook<\\/p>\\r\\n<p><a href=\\\"mailto:jcook2@salemstate.edu\\\">jcook2@salemstate.edu<\\/a><\\/p>\\r\\n<p><a href=\\\"tel:978.542.4954\\\">978.542.4954<\\/a><\\/p>\\r\\n<p>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Holding Space April 18 2025\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"holding-space-april-18-2025\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 22:34:03\",\"post_modified_gmt\":\"2025-03-27 22:34:03\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=894\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":895,\"post_author\":\"1\",\"post_date\":\"2025-03-27 04:50:56\",\"post_date_gmt\":\"2025-03-27 04:50:56\",\"post_content\":\"<p><em><strong>This is a multiday event<\\/strong> from Apr 20, 2025 - Apr 26, 2025.<\\/em><\\/p>\\r\\n<p>Are you a student interested in building skills and enhancing strategies related to academic success? Do you need a little bit of guidance and support around a particular academic success topic? Attend a <em><strong>Student Success Series Workshop<\\/strong><\\/em> (via Zoom) happening all this week at a variety of times.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Monday April 21:<\\/strong><\\/p>\\r\\n<p>PATRIOTS DAY \\u2013 NO PRESENTATIONS<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Tuesday April 22:<\\/strong><\\/p>\\r\\n<p>10-10:30 am: Time Management<\\/p>\\r\\n<p>1-1:30 pm: Effective College Reading Strategies<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Wednesday April 23:<\\/strong><\\/p>\\r\\n<p>1-1:30 pm: Apps Which Up your GPA<\\/p>\\r\\n<p>4-4:30 pm: Setting Up a Successful Study Group<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Thursday April 24:<\\/strong><\\/p>\\r\\n<p>10:30-11 am: Conquering Procrastination<\\/p>\\r\\n<p>3 -3:30 pm: Final Exam Study Tips<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Friday April 25:<\\/strong><\\/p>\\r\\n<p>11-11:30 pm: Developing an Effective Online Class Presentation<\\/p>\\r\\n<p>2:30-3 pm: Budgeting and Finance for College Students<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>Can\'t attend a specific session? There are a number of additional academic resources available for students to take advantage of on the main <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\\">Student Success Canvas<\\/a> page. The <strong>full series schedule <\\/strong>and <strong>Zoom access information<\\/strong> are available on the individual <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\/pages\\/student-success-workshops\\\">Student Success Series<\\/a> section of the Student Success Canvas page.<\\/p>\\r\\n<p><strong>Contact<\\/strong><\\/p>\\r\\n<p>First Year Experience<\\/p>\\r\\n<p><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><\\/p>\\r\\n<p><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><\\/p>\\r\\n<p>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Student Success Series Workshops:\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"student-success-series-workshops-5\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:21:33\",\"post_modified_gmt\":\"2025-04-15 06:21:33\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=895\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":898,\"post_author\":\"1\",\"post_date\":\"2025-03-27 21:52:52\",\"post_date_gmt\":\"2025-03-27 21:52:52\",\"post_content\":\"<p><strong>For incoming students entering without a major (undeclared)<\\/strong><br \\/><br \\/><em>Tuesday, April 22, 5-5:30 pm<\\/em><\\/p>\\r\\n<p>Students who choose to enter the university without a major (undeclared) are automatically a part of the Exploratory Program. To learn more information about the program and the various resources to support your exploration of majors, <a href=\\\"http:\\/\\/salemstate.zoom.us\\/meeting\\/register\\/C6c7ZnPORLio_3FN9W5m0Q\\\">register<\\/a> for an information session over Zoom.<\\/p>\\r\\n<p>Registration will close 24 hours before the start of the session.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Carolyn Tracy<br \\/><a href=\\\"mailto:exploratory@salemstate.edu\\\">exploratory@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4719\\\">978.542.4719<\\/a><br \\/><a href=\\\"https:\\/\\/salemstate.zoom.us\\/meeting\\/register\\/C6c7ZnPORLio_3FN9W5m0Q\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"First to Know: Exploratory Program\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"first-to-know-exploratory-program\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 23:13:17\",\"post_modified_gmt\":\"2025-03-27 23:13:17\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/first-to-know-exploratory-program\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":900,\"post_author\":\"1\",\"post_date\":\"2025-03-27 21:55:40\",\"post_date_gmt\":\"2025-03-27 21:55:40\",\"post_content\":\"<p><strong>Come learn how the Punto Urban Art Museum uses technology to share its messages<\\/strong><\\/p>\\r\\n<p><br \\/>Join students and faculty for a presentation by Saniego Sanchez, Yinette Guzman, Shantel Alix, and Wendy Turbides of the Punto Urban Arts Museum. They will be discussing the importance of the murals in Salem\\u2019s Point neighborhood and how they have incorporated digital technology.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Scott A Nowka<br \\/><a href=\\\"mailto:snowka@salemstate.edu\\\">snowka@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.7183\\\">978.542.7183<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Salem\\u2019s Punto Urban Art Museum\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"salems-punto-urban-art-museum\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 23:13:23\",\"post_modified_gmt\":\"2025-03-27 23:13:23\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/salems-punto-urban-art-museum\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":902,\"post_author\":\"1\",\"post_date\":\"2025-03-27 21:58:11\",\"post_date_gmt\":\"2025-03-27 21:58:11\",\"post_content\":\"<p>Choose your fighter and battle against the SSU community! Tournament will take place on Nintendo Switch, no pre-registration required.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Sean Conners<br \\/><a href=\\\"mailto:sconners@salemstate.edu\\\">sconners@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4965\\\">978.542.4965<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Super Smash Tournament\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"super-smash-tournament-2\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 23:13:45\",\"post_modified_gmt\":\"2025-03-27 23:13:45\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/super-smash-tournament-2\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":904,\"post_author\":\"1\",\"post_date\":\"2025-03-27 22:02:25\",\"post_date_gmt\":\"2025-03-27 22:02:25\",\"post_content\":\"<p><strong>Hosted by the Asian Student Association!<\\/strong><\\/p>\\r\\n<p>The Asian Student Association\\u2019s annual Dynasty Dinner is nearly upon us. It\\u2019s so crazy to think that the spring semester passed us by so fast! This will be a celebration of the senior ASA members of our E-Board, and announcing the passing of the torch to the E-Board of the next academic year. This recognition of the dynasty that has brought ASA this far, and ushering in the future of the organization, is a joyous yet melancholy moment.<\\/p>\\r\\n<p>The Dynasty Dinner is a perfect way to wrap up the spring semester, as it commemorates our best memories, while looking towards what the future may hold. Be prepared to laugh, smile, and maybe shed a tear or two.<\\/p>\\r\\n<p>Have a seat at the table on <strong>April 25 in ECC Vets Hall from 6-9 pm.<\\/strong><\\/p>\\r\\n<p><em>P.S Some advice, bring tissues!<\\/em><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Vivica Vu-Le<br \\/><a href=\\\"mailto:v_vule@salemstate.edu\\\">v_vule@salemstate.edu<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"APIDAHM Asian Dynasty Dinner\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"apidahm-asian-dynasty-dinner\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 23:13:31\",\"post_modified_gmt\":\"2025-03-27 23:13:31\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/apidahm-asian-dynasty-dinner\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":906,\"post_author\":\"1\",\"post_date\":\"2025-03-27 22:06:31\",\"post_date_gmt\":\"2025-03-27 22:06:31\",\"post_content\":\"<p><strong>Occupational Justice: A Path to a Brighter Future<\\/strong><\\/p>\\r\\n<p>The 2025 Occupational Therapy Graduate Research Conference will feature a Keynote presentation by Dr. Michael Iwama, \\u201cDecolonizing Occupational Therapy Theory\\u201d. Dr. Iwama is widely recognized for having developed the \\u201cKawa Model\\u201d (\\u2018Kawa\\u2019 is Japanese for \\u2018River\\u2019), the first substantial model of practice in the rehabilitation sciences developed outside the English-speaking world. He has emerged as a very important and progressive thinker in the fields of occupational therapy and rehabilitation sciences worldwide. Dr. Iwama draws on his rich experience of acculturating into Eastern and Western social spheres of experience to drive his profound and critical perspectives on culture and its intersections with theory and practice in the rehabilitation sciences.<\\/p>\\r\\n<p><strong><a href=\\\"https:\\/\\/salemstatetickets.universitytickets.com\\/w\\/packages\\/Packages.aspx\\\">Registration<\\/a> <\\/strong>is required.<\\/p>\\r\\n<p>Attendees can earn up to four professional development contact hours on completion of the conference survey.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Kathleen Schlenz<br \\/><a href=\\\"mailto:kschlenz@salemstate.edu\\\">kschlenz@salemstate.edu<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"22nd Annual OT Graduate Student Research Conference\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"22nd-annual-ot-graduate-student-research-conference\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 23:13:34\",\"post_modified_gmt\":\"2025-03-27 23:13:34\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/22nd-annual-ot-graduate-student-research-conference\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":908,\"post_author\":\"1\",\"post_date\":\"2025-03-27 22:09:47\",\"post_date_gmt\":\"2025-03-27 22:09:47\",\"post_content\":\"The Viking Video Chat Series is a live webinar series for incoming students. It is a great way to hang out with currently enrolled Salem State upper-class students and ask any questions you may have about life at the University. Any and all questions are welcomed!\\n\\n<a href=\\\"http:\\/\\/salemstate.zoom.us\\/meeting\\/register\\/tZYqdOmppjkjH9XkPomIiwKg4RYuj0E7Nn8D\\\"><strong>Register!<\\/strong><\\/a>\\n\\n<strong>Contact<\\/strong>\\nFirst Year Experience\\n<a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a>\\n<a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a>\\nFor access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.\",\"post_title\":\"Viking Video Chat\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"viking-video-chat-2\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 22:10:17\",\"post_modified_gmt\":\"2025-03-27 22:10:17\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=908\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":909,\"post_author\":\"1\",\"post_date\":\"2025-03-27 22:13:19\",\"post_date_gmt\":\"2025-03-27 22:13:19\",\"post_content\":\"<p>Students who have accepted membership in the Phi Kappa Phi honor society will be formally initiated into the organization. Details regarding the ceremony will be sent via email to the students in advance.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Mathew R Chetnik<br \\/><a href=\\\"mailto:pkp@salemstate.edu\\\">pkp@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.7572\\\">978.542.7572<\\/a><br \\/><a href=\\\"https:\\/\\/ask.salemstate.edu\\/kb\\/what-phi-kappa-phi\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Phi Kappa Phi Initiation Ceremony\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"phi-kappa-phi-initiation-ceremony\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 23:13:38\",\"post_modified_gmt\":\"2025-03-27 23:13:38\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/phi-kappa-phi-initiation-ceremony\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":911,\"post_author\":\"1\",\"post_date\":\"2025-03-27 22:19:07\",\"post_date_gmt\":\"2025-03-27 22:19:07\",\"post_content\":\"<strong>Open Dialogue Hour for Faculty and Staff<\\/strong>\\n\\nIn order to support open and direct dialogue between campus leadership, faculty and staff, our VP of Diversity and Inclusion, Christopher Macdonald-Dennis, is hosting weekly \\u201cHolding Space\\u201d sessions across campus.\\n\\nThese low-stakes, hour-long drop-in sessions are open to all faculty and staff who wish to stop by and engage in conversation with VP Macdonald-Dennis and other members of the President\\u2019s Executive Council (PEC) and campus leadership. To encourage meaningful connection, each session is scheduled in one of campus\\u2019s smaller conference rooms and open to in-person attendance only<span style=\\\"font-size: revert; color: initial;\\\">.<\\/span>\\n\\nAdditional Holding Space opportunities this semester:\\n\\n<strong>M<\\/strong><strong>onday, April 28 | 1:30-2:30 pm<\\/strong> Marsh Hall 204\\n\\n<strong>Contact<\\/strong>\\n\\nJess Cook\\n\\n<a href=\\\"mailto:jcook2@salemstate.edu\\\">jcook2@salemstate.edu<\\/a>\\n\\n<a href=\\\"tel:978.542.4954\\\">978.542.4954<\\/a>\\n\\nFor access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.\",\"post_title\":\"Holding Space April 24 2025\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"holding-space-april-25-2025\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 22:19:51\",\"post_modified_gmt\":\"2025-03-27 22:19:51\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=911\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":912,\"post_author\":\"1\",\"post_date\":\"2025-03-27 22:22:56\",\"post_date_gmt\":\"2025-03-27 22:22:56\",\"post_content\":\"<em><strong>This is a multiday event<\\/strong> from Apr 27, 2025 - May 03, 2025.<\\/em>\\n\\nAre you a student interested in building skills and enhancing strategies related to academic success? Do you need a little bit of guidance and support around a particular academic success topic? Attend a <em><strong>Student Success Series Workshop<\\/strong><\\/em> (via Zoom) happening all this week at a variety of times.\\n\\n<strong>Monday April 28:<\\/strong>\\n\\n12-12:30 pm: Time Management\\n\\n2:30-3 pm: Final Exam Study Tips\\n\\n<strong>Tuesday April 29:<\\/strong>\\n\\n10:30-11 am: Final Exam Study Tips\\n\\n1:30-2 pm: Earning Participation Points in Online Classes\\n\\n<strong>Wednesday April 30:<\\/strong>\\n\\n10:30-11 am: Tricks to Improve Your Memory\\n\\n3:30-4 pm: Managing Stress and Anxiety\\n\\n<strong>Thursday May 1:<\\/strong>\\n\\n12-12:30 pm: Final Exam Study Tips\\n\\n4-4:30 pm: Talking with Professors in Office Hours\\n\\n<strong>Friday May 2:<\\/strong>\\n\\nNO PRESENTATIONS\\n\\nCan\'t attend a specific session? There are a number of additional academic resources available for students to take advantage of on the main <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\\">Student Success Canvas<\\/a> page. The <strong>full series schedule <\\/strong>and <strong>Zoom access information<\\/strong> are available on the individual <a href=\\\"https:\\/\\/elearning.salemstate.edu\\/courses\\/1327122\\/pages\\/student-success-workshops\\\">Student Success Series<\\/a> section of the Student Success Canvas page.\\n\\n<strong>Contact<\\/strong>\\n\\nFirst Year Experience\\n\\n<a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a>\\n\\n<a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a>\\n\\nFor access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.\",\"post_title\":\"Student Success Series Workshops:\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"student-success-series-workshops-6\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:19:06\",\"post_modified_gmt\":\"2025-04-15 06:19:06\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=912\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":914,\"post_author\":\"1\",\"post_date\":\"2025-03-27 22:26:44\",\"post_date_gmt\":\"2025-03-27 22:26:44\",\"post_content\":\"<p>Looking for a place to connect, practice Spanish, and build community?<\\/p>\\n<p>Faculty, staff, and students of all proficiency levels are invited to join us for <strong>Caf\\u00e9 y Tertulia<\\/strong>, a twice-monthly gathering for anyone seeking to improve their Spanish or help others learn the language.<\\/p>\\n<p>Together, we\\u2019ll practice, share ideas, and learn from one another in a fun and supportive environment. Come relax after class or work\\u2014we\\u2019ll provide discussion topics, coffee and treats. \\u00a1V\\u00e1monos!<\\/p>\\n<p>Every other Monday during spring semester:<\\/p>\\n<p>February 10<br \\/>February 24 <br \\/>March 10<br \\/>March 24<br \\/>April 7<br \\/>April 28<br \\/>May 12<\\/p>\\n<p>When: 5:30 pm - 6:30 pm<\\/p>\\n<p>This recurring event is sponsored by HSI-MSI Initiatives, part of Inclusive Excellence.<\\/p>\\n<p><strong>Contact<\\/strong><br \\/>Jess Cook<br \\/><a href=\\\"mailto:jcook2@salemstate.edu\\\">jcook2@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4954\\\">978.542.4954<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\n\\n<!-- wp:paragraph -->\\n<p><\\/p>\\n<!-- \\/wp:paragraph -->\",\"post_title\":\"Caf\\u00e9 y Tertulia | Coffee and Spanish Conversation April 28\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"cafe-y-tertulia-coffee-and-spanish-conversation-3\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-31 03:59:19\",\"post_modified_gmt\":\"2025-03-31 03:59:19\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=914\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":915,\"post_author\":\"1\",\"post_date\":\"2025-03-27 22:29:16\",\"post_date_gmt\":\"2025-03-27 22:29:16\",\"post_content\":\"<p>Looking for a place to connect, practice Spanish, and build community?<\\/p>\\r\\n<p>Faculty, staff, and students of all proficiency levels are invited to join us for <strong>Caf\\u00e9 y Tertulia<\\/strong>, a twice-monthly gathering for anyone seeking to improve their Spanish or help others learn the language.<\\/p>\\r\\n<p>Together, we\\u2019ll practice, share ideas, and learn from one another in a fun and supportive environment. Come relax after class or work\\u2014we\\u2019ll provide discussion topics, coffee and treats. \\u00a1V\\u00e1monos!<\\/p>\\r\\n<p>Every other Monday during spring semester:<\\/p>\\r\\n<p>February 10<br \\/>February 24 <br \\/>March 10<br \\/>March 24<br \\/>April 7<br \\/>April 28<br \\/>May 12<\\/p>\\r\\n<p>When: 5:30 pm - 6:30 pm<br \\/><br \\/>This recurring event is sponsored by HSI-MSI Initiatives, part of Inclusive Excellence.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Jess Cook<br \\/><a href=\\\"mailto:jcook2@salemstate.edu\\\">jcook2@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4954\\\">978.542.4954<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Caf\\u00e9 y Tertulia | Coffee and Spanish Conversation February 24\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"cafe-y-tertulia-coffee-and-spanish-conversation-5\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-31 04:00:58\",\"post_modified_gmt\":\"2025-03-31 04:00:58\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=915\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":916,\"post_author\":\"1\",\"post_date\":\"2025-03-27 22:29:52\",\"post_date_gmt\":\"2025-03-27 22:29:52\",\"post_content\":\"<p>Looking for a place to connect, practice Spanish, and build community?<\\/p>\\r\\n<p>Faculty, staff, and students of all proficiency levels are invited to join us for <strong>Caf\\u00e9 y Tertulia<\\/strong>, a twice-monthly gathering for anyone seeking to improve their Spanish or help others learn the language.<\\/p>\\r\\n<p>Together, we\\u2019ll practice, share ideas, and learn from one another in a fun and supportive environment. Come relax after class or work\\u2014we\\u2019ll provide discussion topics, coffee and treats. \\u00a1V\\u00e1monos!<\\/p>\\r\\n<p>Every other Monday during spring semester:<\\/p>\\r\\n<p>February 10<br \\/>February 24 <br \\/>March 10<br \\/>March 24<br \\/>April 7<br \\/>April 28<br \\/>May 12<\\/p>\\r\\n<p>When: 5:30 pm - 6:30 pm<br \\/><br \\/>This recurring event is sponsored by HSI-MSI Initiatives, part of Inclusive Excellence.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Jess Cook<br \\/><a href=\\\"mailto:jcook2@salemstate.edu\\\">jcook2@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4954\\\">978.542.4954<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Caf\\u00e9 y Tertulia | Coffee and Spanish Conversation March 24\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"cafe-y-tertulia-coffee-and-spanish-conversation-6\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-31 04:00:28\",\"post_modified_gmt\":\"2025-03-31 04:00:28\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=916\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":917,\"post_author\":\"1\",\"post_date\":\"2025-03-27 22:30:01\",\"post_date_gmt\":\"2025-03-27 22:30:01\",\"post_content\":\"<p>Looking for a place to connect, practice Spanish, and build community?<\\/p>\\r\\n<p>Faculty, staff, and students of all proficiency levels are invited to join us for <strong>Caf\\u00e9 y Tertulia<\\/strong>, a twice-monthly gathering for anyone seeking to improve their Spanish or help others learn the language.<\\/p>\\r\\n<p>Together, we\\u2019ll practice, share ideas, and learn from one another in a fun and supportive environment. Come relax after class or work\\u2014we\\u2019ll provide discussion topics, coffee and treats. \\u00a1V\\u00e1monos!<\\/p>\\r\\n<p>Every other Monday during spring semester:<\\/p>\\r\\n<p>February 10<br \\/>February 24 <br \\/>March 10<br \\/>March 24<br \\/>April 7<br \\/>April 28<br \\/>May 12<\\/p>\\r\\n<p>When: 5:30 pm - 6:30 pm<br \\/><br \\/>This recurring event is sponsored by HSI-MSI Initiatives, part of Inclusive Excellence.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Jess Cook<br \\/><a href=\\\"mailto:jcook2@salemstate.edu\\\">jcook2@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4954\\\">978.542.4954<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Caf\\u00e9 y Tertulia | Coffee and Spanish Conversation March 10\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"cafe-y-tertulia-coffee-and-spanish-conversation-7\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-31 04:00:31\",\"post_modified_gmt\":\"2025-03-31 04:00:31\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=917\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":918,\"post_author\":\"1\",\"post_date\":\"2025-03-27 22:36:00\",\"post_date_gmt\":\"2025-03-27 22:36:00\",\"post_content\":\"<strong>Open Dialogue Hour for Faculty and Staff<\\/strong>\\n\\nIn order to support open and direct dialogue between campus leadership, faculty and staff, our VP of Diversity and Inclusion, Christopher Macdonald-Dennis, is hosting weekly \\u201cHolding Space\\u201d sessions across campus.\\n\\nThese low-stakes, hour-long drop-in sessions are open to all faculty and staff who wish to stop by and engage in conversation with VP Macdonald-Dennis and other members of the President\\u2019s Executive Council (PEC) and campus leadership. To encourage meaningful connection, each session is scheduled in one of campus\\u2019s smaller conference rooms and open to in-person attendance only<span style=\\\"font-size: revert; color: initial;\\\">.<\\/span>\\n\\n<strong>Contact<\\/strong>\\n\\nJess Cook\\n\\n<a href=\\\"mailto:jcook2@salemstate.edu\\\">jcook2@salemstate.edu<\\/a>\\n\\n<a href=\\\"tel:978.542.4954\\\">978.542.4954<\\/a>\\n\\nFor access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.\",\"post_title\":\"Holding Space April 28 2025\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"holding-space-april-28-2025\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 22:36:01\",\"post_modified_gmt\":\"2025-03-27 22:36:01\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=918\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":919,\"post_author\":\"1\",\"post_date\":\"2025-03-27 22:53:42\",\"post_date_gmt\":\"2025-03-27 22:53:42\",\"post_content\":\"<p>Learn about Clinical Driving Evaluations, Adaptive Driving Training, and Readiness to Drive Assessments &amp; the CarFit program established by AARP and AOTA.<\\/p>\\r\\n<p>Speakers:<\\/p>\\r\\n<ul>\\r\\n<li>Renee D\'Antuono, MSOT, CRDS, PDI Owner DriveRx, LLC<\\/li>\\r\\n<li>Maria Parker, OTD, MSOT-Carfit speakers<\\/li>\\r\\n<li>Twyla Fink, OTD, MSOT-Carfit speakers<\\/li>\\r\\n<\\/ul>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p>This is an online event and <strong><a href=\\\"https:\\/\\/salemstateuniversity.wufoo.com\\/forms\\/salem-state-chhs-interprofessional-events\\/\\\">registration<\\/a><\\/strong> is required. Presented by the Center for Inter-professional Education and Collaboration (CIPEC).<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Jeramie Silveira<br \\/><a href=\\\"mailto:jsilveira@salemstate.edu\\\">jsilveira@salemstate.edu<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Drivers Rehabilitation\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"drivers-rehabilitation\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 03:38:06\",\"post_modified_gmt\":\"2025-04-07 03:38:06\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/drivers-rehabilitation\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"}],\"found_posts\":369,\"max_num_pages\":4}','off');
