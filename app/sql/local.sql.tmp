ings.local\\/?post_type=event_listing&#038;p=1746\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1747,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:36:10\",\"post_date_gmt\":\"2025-04-15 06:36:10\",\"post_content\":\"<p><em>This is a multiday event from Feb 28, 2025 - Mar 27, 2025.<\\/em><\\/p>\\r\\n<p>Both TIAA and the State Board of Retirement are offering a variety of webinars for active employees this month. Take a peak and be sure to register now! <a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">Retirement Seminars - Polaris.<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Joanna Nandi<br \\/><a href=\\\"mailto:jnandi@salemstate.edu\\\">jnandi@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.6030\\\">978.542.6030<\\/a><br \\/><a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"post_title\":\"March Retirement Webinars\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"march-retirement-webinars-7\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:37:23\",\"post_modified_gmt\":\"2025-04-15 06:37:23\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1747\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1748,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:36:20\",\"post_date_gmt\":\"2025-04-15 06:36:20\",\"post_content\":\"<p><em>This is a multiday event from Feb 28, 2025 - Mar 27, 2025.<\\/em><\\/p>\\r\\n<p>Both TIAA and the State Board of Retirement are offering a variety of webinars for active employees this month. Take a peak and be sure to register now! <a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">Retirement Seminars - Polaris.<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Joanna Nandi<br \\/><a href=\\\"mailto:jnandi@salemstate.edu\\\">jnandi@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.6030\\\">978.542.6030<\\/a><br \\/><a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"post_title\":\"March Retirement Webinars\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"march-retirement-webinars-8\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:37:25\",\"post_modified_gmt\":\"2025-04-15 06:37:25\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1748\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1749,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:36:42\",\"post_date_gmt\":\"2025-04-15 06:36:42\",\"post_content\":\"<p><em>This is a multiday event from Feb 28, 2025 - Mar 27, 2025.<\\/em><\\/p>\\r\\n<p>Both TIAA and the State Board of Retirement are offering a variety of webinars for active employees this month. Take a peak and be sure to register now! <a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">Retirement Seminars - Polaris.<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Joanna Nandi<br \\/><a href=\\\"mailto:jnandi@salemstate.edu\\\">jnandi@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.6030\\\">978.542.6030<\\/a><br \\/><a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"post_title\":\"March Retirement Webinars\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"march-retirement-webinars-9\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:37:27\",\"post_modified_gmt\":\"2025-04-15 06:37:27\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1749\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1750,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:36:57\",\"post_date_gmt\":\"2025-04-15 06:36:57\",\"post_content\":\"<p><em>This is a multiday event from Feb 28, 2025 - Mar 27, 2025.<\\/em><\\/p>\\r\\n<p>Both TIAA and the State Board of Retirement are offering a variety of webinars for active employees this month. Take a peak and be sure to register now! <a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">Retirement Seminars - Polaris.<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Joanna Nandi<br \\/><a href=\\\"mailto:jnandi@salemstate.edu\\\">jnandi@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.6030\\\">978.542.6030<\\/a><br \\/><a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"post_title\":\"March Retirement Webinars\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"march-retirement-webinars-10\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:37:29\",\"post_modified_gmt\":\"2025-04-15 06:37:29\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1750\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":917,\"post_author\":\"1\",\"post_date\":\"2025-03-27 22:30:01\",\"post_date_gmt\":\"2025-03-27 22:30:01\",\"post_content\":\"<p>Looking for a place to connect, practice Spanish, and build community?<\\/p>\\r\\n<p>Faculty, staff, and students of all proficiency levels are invited to join us for <strong>Caf\\u00e9 y Tertulia<\\/strong>, a twice-monthly gathering for anyone seeking to improve their Spanish or help others learn the language.<\\/p>\\r\\n<p>Together, we\\u2019ll practice, share ideas, and learn from one another in a fun and supportive environment. Come relax after class or work\\u2014we\\u2019ll provide discussion topics, coffee and treats. \\u00a1V\\u00e1monos!<\\/p>\\r\\n<p>Every other Monday during spring semester:<\\/p>\\r\\n<p>February 10<br \\/>February 24 <br \\/>March 10<br \\/>March 24<br \\/>April 7<br \\/>April 28<br \\/>May 12<\\/p>\\r\\n<p>When: 5:30 pm - 6:30 pm<br \\/><br \\/>This recurring event is sponsored by HSI-MSI Initiatives, part of Inclusive Excellence.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Jess Cook<br \\/><a href=\\\"mailto:jcook2@salemstate.edu\\\">jcook2@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4954\\\">978.542.4954<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Caf\\u00e9 y Tertulia | Coffee and Spanish Conversation March 10\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"cafe-y-tertulia-coffee-and-spanish-conversation-7\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-31 04:00:31\",\"post_modified_gmt\":\"2025-03-31 04:00:31\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=917\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1751,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:37:14\",\"post_date_gmt\":\"2025-04-15 06:37:14\",\"post_content\":\"<p><em>This is a multiday event from Feb 28, 2025 - Mar 27, 2025.<\\/em><\\/p>\\r\\n<p>Both TIAA and the State Board of Retirement are offering a variety of webinars for active employees this month. Take a peak and be sure to register now! <a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">Retirement Seminars - Polaris.<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Joanna Nandi<br \\/><a href=\\\"mailto:jnandi@salemstate.edu\\\">jnandi@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.6030\\\">978.542.6030<\\/a><br \\/><a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"post_title\":\"March Retirement Webinars\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"march-retirement-webinars-11\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:37:32\",\"post_modified_gmt\":\"2025-04-15 06:37:32\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1751\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1752,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:37:51\",\"post_date_gmt\":\"2025-04-15 06:37:51\",\"post_content\":\"<p><em>This is a multiday event from Feb 28, 2025 - Mar 27, 2025.<\\/em><\\/p>\\r\\n<p>Both TIAA and the State Board of Retirement are offering a variety of webinars for active employees this month. Take a peak and be sure to register now! <a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">Retirement Seminars - Polaris.<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Joanna Nandi<br \\/><a href=\\\"mailto:jnandi@salemstate.edu\\\">jnandi@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.6030\\\">978.542.6030<\\/a><br \\/><a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"post_title\":\"March Retirement Webinars\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"march-retirement-webinars-12\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:39:07\",\"post_modified_gmt\":\"2025-04-15 06:39:07\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1752\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":664,\"post_author\":\"1\",\"post_date\":\"2025-03-10 05:27:54\",\"post_date_gmt\":\"2025-03-10 05:27:54\",\"post_content\":\"<p>Salem State returns to the Sunshine State! Please plan to join us for these wonderful events if you live or vacation in Florida.<\\/p>\\r\\n<p>Be sure to keep us updated with your seasonal and home address in Florida so you can receive future mailings and emails regarding these exciting events.<\\/p>\\r\\n<p>To update your address, visit salemstate.edu\\/alumni\\/update or call 978.542.7530.<\\/p>\\r\\n<p>We have an incredible slate of programs planned for this year, don\\u2019t delay, register today.<\\/p>\\r\\n<p>Alumni Relations<br \\/>alumni@salemstate.edu<br \\/>978.542.7530<br \\/>Get tickets<br \\/>For access and accommodation information, visit our page on access or email access@salemstate.edu.<\\/p>\",\"post_title\":\"Salem State Returns to the Sunshine State\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"salem-state-returns-to-the-sunshine-state\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-03-27 23:16:18\",\"post_modified_gmt\":\"2025-03-27 23:16:18\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/salem-state-returns-to-the-sunshine-state\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1753,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:38:02\",\"post_date_gmt\":\"2025-04-15 06:38:02\",\"post_content\":\"<p><em>This is a multiday event from Feb 28, 2025 - Mar 27, 2025.<\\/em><\\/p>\\r\\n<p>Both TIAA and the State Board of Retirement are offering a variety of webinars for active employees this month. Take a peak and be sure to register now! <a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">Retirement Seminars - Polaris.<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Joanna Nandi<br \\/><a href=\\\"mailto:jnandi@salemstate.edu\\\">jnandi@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.6030\\\">978.542.6030<\\/a><br \\/><a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"post_title\":\"March Retirement Webinars\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"march-retirement-webinars-13\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:39:11\",\"post_modified_gmt\":\"2025-04-15 06:39:11\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1753\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":603,\"post_author\":\"1\",\"post_date\":\"2025-02-28 02:58:08\",\"post_date_gmt\":\"2025-02-28 02:58:08\",\"post_content\":\"<p>test event 1 for wp event manager<\\/p>\",\"post_title\":\"test event 1 wp event manager\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"test-event-1-wp-event-manager\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-08 03:30:49\",\"post_modified_gmt\":\"2025-04-08 03:30:49\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=603\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":729,\"post_author\":\"1\",\"post_date\":\"2025-03-20 04:33:30\",\"post_date_gmt\":\"2025-03-20 04:33:30\",\"post_content\":\"<p><em>This is a multiday event from Mar 13, 2025 - Apr 07, 2025.<\\/em><\\/p>\\r\\n<p>Is there someone who had an impact on you this year? Is there an individual who has been supportive and encouraging during your first year? Is there someone, you feel, has positively contributed to your first-year experience?<\\/p>\\r\\n<p>If you answered YES to any of those questions, nominate them for the Outstanding First Year Advocate Award! The Outstanding First Year Advocate Award recognizes faculty (professors), staff (administrators who work in offices), and student leaders (resident assistant, orientation leader, first year mentor, peer advisor, tutor, peer leader, upper-class student mentor, etc.) who positively impacted the academic and\\/or personal lives of first year students.<\\/p>\\r\\n<p>First-year students (or anyone else who has seen amazing individuals) are encouraged to nominate someone they feel has made a significant contribution to the first year experience for students at Salem State for this special honor. It only takes a couple minutes to submit your nomination form!<\\/p>\\r\\n<p>Celebrate those individuals who have made an impact by nominating them for the Outstanding First Year Advocate Award.<\\/p>\\r\\n<p><strong><a href=\\\"https:\\/\\/www.surveymonkey.com\\/r\\/FYAdvocate2025\\\">Nominate someone. <\\/a><\\/strong><br \\/>The deadline to submit your nomination(s) is Monday, April 7. If you have any questions, please email <a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Mathew R Chetnik<br \\/><a href=\\\"mailto:firstyear@salemstate.edu\\\">firstyear@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.2618\\\">978.542.2618<\\/a><br \\/><a href=\\\"https:\\/\\/www.surveymonkey.com\\/r\\/FYAdvocate2025\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a><\\/p>\",\"post_title\":\"Nominate someone for the Outstanding First Year Advocate Award\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"nominate-someone-for-the-outstanding-first-year-advocate-award\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:23:04\",\"post_modified_gmt\":\"2025-04-11 05:23:04\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/nominate-someone-for-the-outstanding-first-year-advocate-award\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1754,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:38:15\",\"post_date_gmt\":\"2025-04-15 06:38:15\",\"post_content\":\"<p><em>This is a multiday event from Feb 28, 2025 - Mar 27, 2025.<\\/em><\\/p>\\r\\n<p>Both TIAA and the State Board of Retirement are offering a variety of webinars for active employees this month. Take a peak and be sure to register now! <a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">Retirement Seminars - Polaris.<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Joanna Nandi<br \\/><a href=\\\"mailto:jnandi@salemstate.edu\\\">jnandi@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.6030\\\">978.542.6030<\\/a><br \\/><a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"post_title\":\"March Retirement Webinars\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"march-retirement-webinars-14\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:39:12\",\"post_modified_gmt\":\"2025-04-15 06:39:12\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1754\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1755,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:38:27\",\"post_date_gmt\":\"2025-04-15 06:38:27\",\"post_content\":\"<p><em>This is a multiday event from Feb 28, 2025 - Mar 27, 2025.<\\/em><\\/p>\\r\\n<p>Both TIAA and the State Board of Retirement are offering a variety of webinars for active employees this month. Take a peak and be sure to register now! <a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">Retirement Seminars - Polaris.<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Joanna Nandi<br \\/><a href=\\\"mailto:jnandi@salemstate.edu\\\">jnandi@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.6030\\\">978.542.6030<\\/a><br \\/><a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:a