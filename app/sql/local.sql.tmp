INSERT INTO `wp_options` VALUES (95651,'_transient_em_5499a9f4b40614360262c7fdb1b44d1c1744956471','{\"posts\":[{\"ID\":603,\"post_author\":\"1\",\"post_date\":\"2025-02-28 02:58:08\",\"post_date_gmt\":\"2025-02-28 02:58:08\",\"post_content\":\"<p>test event 1 for wp event manager<\\/p>\",\"post_title\":\"test event 1 wp event manager\",\"post_excerpt\":\"\",\"post_status\":\"expired\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"test-event-1-wp-event-manager\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-08 03:30:49\",\"post_modified_gmt\":\"2025-04-08 03:30:49\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=603\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":713,\"post_author\":\"1\",\"post_date\":\"2025-03-18 03:27:39\",\"post_date_gmt\":\"2025-03-18 03:27:39\",\"post_content\":\"<p><em>This is a multiday event from Feb 28, 2025 - Mar 27, 2025.<\\/em><\\/p>\\r\\n<p>Both TIAA and the State Board of Retirement are offering a variety of webinars for active employees this month. Take a peak and be sure to register now! <a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">Retirement Seminars - Polaris.<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Joanna Nandi<br \\/><a href=\\\"mailto:jnandi@salemstate.edu\\\">jnandi@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.6030\\\">978.542.6030<\\/a><br \\/><a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"post_title\":\"March Retirement Webinars\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"march-retirement-webinars\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:29:21\",\"post_modified_gmt\":\"2025-04-15 06:29:21\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/march-retirement-webinars\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":754,\"post_author\":\"1\",\"post_date\":\"2025-03-22 03:44:08\",\"post_date_gmt\":\"2025-03-22 03:44:08\",\"post_content\":\"<p><strong>Featured Guest Speaker Lauren Jones MA Secretary of Labor and Workforce Development<\\/strong><\\/p>\\r\\n<p>When: Tuesday, March 25, 11:00 am - 11:45 pm | Marsh Hall, Petrowski Room<\\/p>\\r\\n<p>Lauren Jones, Massachusetts Secretary of Labor and Workforce Development will be coming to campus to speak to students. Secretary Jones will be interviewed by Bertolon School of Business Dean, Raminder Luther and will be sharing information about growth industries, employment and career opportunities for graduates.<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/www.eventbrite.com\\/e\\/bertolon-school-of-business-speaker-series-tickets-1253101844349\\\">Reserve a spot.<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Don White<br \\/><a href=\\\"mailto:dwhite@salemstate.edu\\\">dwhite@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.6634\\\">978.542.6634<\\/a><br \\/><a href=\\\"https:\\/\\/www.eventbrite.com\\/e\\/bertolon-school-of-business-speaker-series-tickets-1253101844349\\\">More information<\\/a><br \\/><a href=\\\"https:\\/\\/www.eventbrite.com\\/e\\/bertolon-school-of-business-speaker-series-tickets-1253101844349\\\">Get tickets<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Bertolon School of Business Spring Speaker Series\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"bertolon-school-of-business-spring-speaker-series\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:54:00\",\"post_modified_gmt\":\"2025-04-07 02:54:00\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/bertolon-school-of-business-spring-speaker-series\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":816,\"post_author\":\"1\",\"post_date\":\"2025-03-27 00:05:16\",\"post_date_gmt\":\"2025-03-27 00:05:16\",\"post_content\":\"<p>Eight teams from business, social work, fire science, healthcare studies, psychology, English, and communication majors presenting on the stage for $5,000 grand prize.<\\/p>\\r\\n<p>See Salem State students shining with their innovative business ideas, and get free food!<\\/p>\\r\\n<p>This free event takes place in the recital hall of academic building on Central Campus at 5-7 pm on Thursday, April 3.<\\/p>\\r\\n<p>The seats in the recital hall are limited, so <a href=\\\"https:\\/\\/www.eventbrite.com\\/e\\/5th-annual-viking-business-pitch-competition-tickets-1274231463609?aff=oddtdtcreator\\\"><strong>please register here to reserve a seat<\\/strong><\\/a>.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/><a href=\\\"https:\\/\\/www.salemstate.edu\\/businesspitch\\\">More about the Viking Business Pitch<\\/a><br \\/><a href=\\\"https:\\/\\/www.eventbrite.com\\/e\\/5th-annual-viking-business-pitch-competition-tickets-1274231463609?aff=oddtdtcreator\\\">Register to attend the final presentations<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Viking Business Pitch Final Presentations\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"viking-business-pitch-final-presentations\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-07 02:49:21\",\"post_modified_gmt\":\"2025-04-07 02:49:21\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/viking-business-pitch-final-presentations\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":841,\"post_author\":\"1\",\"post_date\":\"2025-03-27 02:11:26\",\"post_date_gmt\":\"2025-03-27 02:11:26\",\"post_content\":\"<p>Join us as we Meet the Moment\\u00ae by celebrating all those who completed the 2025 educator license program.<\\/p>\\r\\n<p>The Educators Pinning Ceremony will include appetizers and refreshments, networking, and words of inspiration for our graduating students!<\\/p>\\r\\n<p>This event is proudly hosted by the Salem State University Friends of the McKeown School of Education and the Salem State University Alumni Association and Foundation, Inc.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Alumni Engagement<br \\/><a href=\\\"mailto:alumni@salemstate.edu\\\">alumni@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.7530\\\">978.542.7530<\\/a><br \\/><a href=\\\"https:\\/\\/participate.salemstate.edu\\/pinningceremony\\\">Get tickets<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"The 11th Annual Sheila P. Kearney \\u201954, \\u201867G Educators Pinning Ceremony\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"the-11th-annual-sheila-p-kearney-54-67g-educators-pinning-ceremony\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-11 05:22:12\",\"post_modified_gmt\":\"2025-04-11 05:22:12\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/the-11th-annual-sheila-p-kearney-54-67g-educators-pinning-ceremony\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":847,\"post_author\":\"1\",\"post_date\":\"2025-03-27 02:26:28\",\"post_date_gmt\":\"2025-03-27 02:26:28\",\"post_content\":\"<p>Salem State Athletics and the Alumni Association and Foundation invite members of the campus community to the 2025 Athletic Hall of Fame induction celebration.<\\/p>\\r\\n<p>This year\\u2019s celebration highlights the best and most significant contributions to Salem State athletics by four individuals and one team.<\\/p>\\r\\n<p>&nbsp;<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/ssuathletichof.eventbrite.com\\/\\\"><strong>Register today!<\\/strong><\\/a><\\/p>\\r\\n<p><br \\/><strong>Contact<\\/strong><br \\/>Alumni Relations<br \\/><a href=\\\"mailto:alumni@salemstate.edu\\\">alumni@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.7530\\\">978.542.7530<\\/a><br \\/><a href=\\\"https:\\/\\/ssuathletichof.eventbrite.com\\/\\\">Get tickets<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Salem State University Athletic Hall of Fame Class of 2025 Induction Celebration\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"salem-state-university-athletic-hall-of-fame-class-of-2025-induction-celebration\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:50:51\",\"post_modified_gmt\":\"2025-04-17 04:50:51\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/salem-state-university-athletic-hall-of-fame-class-of-2025-induction-celebration\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":859,\"post_author\":\"1\",\"post_date\":\"2025-03-27 03:23:04\",\"post_date_gmt\":\"2025-03-27 03:23:04\",\"post_content\":\"<p>Inclusive Excellence invites you to mark your calendars and join us on Monday, April 14, 2025, from 11:15 am to 1 pm in ECC Veterans Hall for the Inaugural Inclusive Excellence Showcase and Recognition Luncheon.<\\/p>\\r\\n<p><strong>Doors will open for lunch at 11:15 am and the event will start promptly at 11:30 am.<\\/strong><\\/p>\\r\\n<p>This event is free and open to the Salem State University community and invited guests. Come celebrate our 24-25 academic year successes and connect with our community members over a delicious lunch!<\\/p>\\r\\n<p><a href=\\\"https:\\/\\/forms.office.com\\/r\\/2uPp8b1YbP\\\"><strong>Inclusive Excellence Awards Nominations<\\/strong><\\/a><br \\/>As the hub for institutional transformation for equity here at Salem State University, Inclusive Excellence is excited to introduce this opportunity to elevate and celebrate members of our community for exemplary contributions toward inclusive excellence in best practices, research, leadership, or service.<\\/p>\\r\\n<p>Our goal is to encourage departments, faculty, staff, and students to implement comprehensive policies, practices, and initiatives designed to increase innovative, inclusive practices within our respective areas. We look forward to receiving many nominations of individuals and departments doing incredible work!<\\/p>\\r\\n<p>Award recipients will be recognized at the Inaugural Inclusive Excellence Showcase.<\\/p>\\r\\n<p><strong>Award categories for 2025 are as follows:<\\/strong><\\/p>\\r\\n<ul>\\r\\n<li>The Catalyst Award<\\/li>\\r\\n<li>Outstanding Service Award<\\/li>\\r\\n<li>Departmental Excellence Award<\\/li>\\r\\n<li>Outstanding Contribution to Education Award<\\/li>\\r\\n<\\/ul>\\r\\n<p><br \\/>The deadline to <a href=\\\"http:\\/\\/forms.office.com\\/r\\/2uPp8b1YbP\\\">submit a nomination<\\/a> is Sunday, March 30, 2025, at 11:59 pm.<\\/p>\\r\\n<p>Submission requirements for the Catalyst, Outstanding Service, and Departmental Excellence awards include a statement (250 words maximum) detailing why the nominee deserves recognition for the designated award, including the specific criteria associated with the award, as outlined in the award description.<\\/p>\\r\\n<p>Submissions for the Outstanding Contribute to Education Award will entail a statement (250 words maximum) on how the proposed contribution fits the award criteria and a completed copy of the deliverable attached. Supporting materials can be attached but are not required.<\\/p>\\r\\n<p><strong>Overview of Awards<\\/strong><br \\/><strong>The Catalyst Award<\\/strong> will be presented to a Salem State University undergraduate or graduate student for their exemplified commitment to inclusive excellence through exercising innovative and courageous leadership practices within their student organization, in a classroom, university program, and\\/or the development and implementation of campus programs and initiatives.<\\/p>\\r\\n<p><strong>The Outstanding Service Award<\\/strong> will be awarded to a Salem State University faculty, staff, or administrator, who, through a record of consistent service, has contributed substantially to advancing inclusive excellence at Salem State University.<\\/p>\\r\\n<p><strong>The Departmental Excellence Award<\\/strong> recognizes and honors a department, academic or administrative, that has demonstrated an outstanding commitment to championing diversity, equity, and inclusion. This award celebrates the collective commitment of the department to foster a more inclusive and equitable departmental community through transformative policies, best practices, and a profound contribution to the betterment of the departmental environment and the larger campus community.<\\/p>\\r\\n<p><strong>The Outstanding Contribution to Education Award<\\/strong> will recognize a faculty, staff member, or graduate student who has contributed substantially to furthering diversity and inclusion in higher education. Outstanding contributions to education may include research and creative inquiry, workshop development, campus diversity initiatives, curricular transformation, culturally affirming practices, capacity building, the influence of technology on diversity\\/equity, funding, and policies and inclusive practices.<\\/p>\\r\\n<p>The Inclusive Excellence team will review all nominations and select recipients after the submission deadline. Any Salem State community members can submit a nomination on their behalf or nominate a peer or colleague. Nominees will be notified by Friday, April 4.<\\/p>\\r\\n<p>Please address all questions or concerns to <a href=\\\"cpierre@salemstate.edu\\\">Carlie Pierre<\\/a>, Director of Education and Training.<\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Carlie Pierre<br \\/><a href=\\\"mailto:cpierre@salemstate.edu\\\">cpierre@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.4852\\\">978.542.4852<\\/a><br \\/><a href=\\\"https:\\/\\/www.salemstate.edu\\/news\\/call-nominations-inaugural-inclusive-excellence-awards-mar-06-2025\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\",\"post_title\":\"Inaugural Inclusive Excellence Showcase\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"inaugural-inclusive-excellence-showcase\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-17 04:51:09\",\"post_modified_gmt\":\"2025-04-17 04:51:09\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/event\\/inaugural-inclusive-excellence-showcase\\/\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1742,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:30:01\",\"post_date_gmt\":\"2025-04-15 06:30:01\",\"post_content\":\"<p><em>This is a multiday event from Feb 28, 2025 - Mar 27, 2025.<\\/em><\\/p>\\r\\n<p>Both TIAA and the State Board of Retirement are offering a variety of webinars for active employees this month. Take a peak and be sure to register now! <a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">Retirement Seminars - Polaris.<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Joanna Nandi<br \\/><a href=\\\"mailto:jnandi@salemstate.edu\\\">jnandi@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.6030\\\">978.542.6030<\\/a><br \\/><a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"post_title\":\"March Retirement Webinars\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"march-retirement-webinars-2\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:30:07\",\"post_modified_gmt\":\"2025-04-15 06:30:07\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1742\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1743,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:30:58\",\"post_date_gmt\":\"2025-04-15 06:30:58\",\"post_content\":\"<p><em>This is a multiday event from Feb 28, 2025 - Mar 27, 2025.<\\/em><\\/p>\\r\\n<p>Both TIAA and the State Board of Retirement are offering a variety of webinars for active employees this month. Take a peak and be sure to register now! <a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">Retirement Seminars - Polaris.<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Joanna Nandi<br \\/><a href=\\\"mailto:jnandi@salemstate.edu\\\">jnandi@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.6030\\\">978.542.6030<\\/a><br \\/><a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"post_title\":\"March Retirement Webinars\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"march-retirement-webinars-3\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:31:38\",\"post_modified_gmt\":\"2025-04-15 06:31:38\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1743\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1744,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:31:11\",\"post_date_gmt\":\"2025-04-15 06:31:11\",\"post_content\":\"<p><em>This is a multiday event from Feb 28, 2025 - Mar 27, 2025.<\\/em><\\/p>\\r\\n<p>Both TIAA and the State Board of Retirement are offering a variety of webinars for active employees this month. Take a peak and be sure to register now! <a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">Retirement Seminars - Polaris.<\\/a><\\/p>\\r\\n<p><strong>Contact<\\/strong><br \\/>Joanna Nandi<br \\/><a href=\\\"mailto:jnandi@salemstate.edu\\\">jnandi@salemstate.edu<\\/a><br \\/><a href=\\\"tel:978.542.6030\\\">978.542.6030<\\/a><br \\/><a href=\\\"https:\\/\\/polaris.salemstate.edu\\/post\\/1345\\/retirement-seminars\\\">More information<\\/a><br \\/>For access and accommodation information, visit our <a href=\\\"https:\\/\\/www.salemstate.edu\\/access\\\">page on access<\\/a> or email <a href=\\\"mailto:access@salemstate.edu\\\">access@salemstate.edu<\\/a>.<\\/p>\\r\\n<p>&nbsp;<\\/p>\",\"post_title\":\"March Retirement Webinars\",\"post_excerpt\":\"\",\"post_status\":\"publish\",\"comment_status\":\"closed\",\"ping_status\":\"closed\",\"post_password\":\"\",\"post_name\":\"march-retirement-webinars-4\",\"to_ping\":\"\",\"pinged\":\"\",\"post_modified\":\"2025-04-15 06:31:40\",\"post_modified_gmt\":\"2025-04-15 06:31:40\",\"post_content_filtered\":\"\",\"post_parent\":0,\"guid\":\"http:\\/\\/salem-events-hub-discover-local-happenings.local\\/?post_type=event_listing&#038;p=1744\",\"menu_order\":0,\"post_type\":\"event_listing\",\"post_mime_type\":\"\",\"comment_count\":\"0\",\"filter\":\"raw\"},{\"ID\":1745,\"post_author\":\"1\",\"post_date\":\"2025-04-15 06:31:59\",\"post_date_gmt\":\"2025-04-15 06:31:59\",\"post_content\":\"<p><em>This is a multiday event from Feb 28, 2025 - Mar 27, 2025.<\\/em><\\/p>\\r\\n<p>Both TIAA and the Sta