INSERT INTO `wp_options` VALUES (95763,'_transient_elementor_unread_notifications_1','a:18:{i:0;s:17:\"hello-biz-contact\";i:1;s:22:\"ai-site-planner-colors\";i:2;s:17:\"send-notification\";i:3;s:15:\"ai-site-planner\";i:4;s:14:\"grid-span-3.27\";i:5;s:16:\"local-fonts-3.27\";i:6;s:17:\"video-shorts-3.27\";i:7;s:23:\"dynamic-off-canvas-3.26\";i:8;s:16:\"css-loading-3.25\";i:9;s:19:\"variable-fonts-3.24\";i:10;s:18:\"floating-bars-3.24\";i:11;s:17:\"ai-featured-image\";i:12;s:18:\"search-widget-3.23\";i:13;s:21:\"floating-buttons-3.23\";i:14;s:16:\"link-in-bio-3.23\";i:15;s:20:\"nested-elements-3.23\";i:16;s:20:\"5-star-rating-prompt\";i:17;s:23:\"site-mailer-introducing\";}','off');
